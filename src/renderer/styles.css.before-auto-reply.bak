[hidden] { display: none !important; }
* { box-sizing: border-box; }
:root { --account-sidebar-width: 316px; --topbar-height: 92px; }
html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; font-family: "Microsoft YaHei","Segoe UI",sans-serif; color: #24303a; background: #edf2f4; }
button, input, textarea, select { font: inherit; }
button { cursor: pointer; border: 1px solid #d3dde2; background: #fff; border-radius: 8px; padding: 8px 12px; }
button:hover { background: #f5f8f9; }
button.primary { border: 0; background: #2fc66d; color: white; font-weight: 700; }
button.primary:hover { background: #29b661; }

/* V1.23.41 — keep the LINE add-account action visually aligned with the compact mode switch. */
#addAccountBtn {
  flex: 0 0 auto;
  height: 30px;
  min-height: 30px;
  padding: 0 10px;
  border-radius: 9px;
  font-size: 12px;
  line-height: 30px;
  white-space: nowrap;
}

.topbar { position: fixed; left: 0; right: 0; top: 0; height: var(--topbar-height); z-index: 20; background: #fff; border-bottom: 1px solid #dce5e9; display: grid; grid-template-rows: 46px 45px; padding: 0 14px; }
.topbar-row { min-width: 0; display: flex; align-items: center; gap: 9px; }
.topbar-primary-row { border-bottom: 1px solid #eef2f4; }
.topbar-action-row { overflow: hidden; justify-content:flex-end; flex-wrap:nowrap; }
.topbar-action-row button { flex: 0 0 auto; padding-top: 7px; padding-bottom: 7px; }
.topbar-spacer { flex: 1 1 auto; min-width: 10px; }
.brand { flex: 0 0 auto; font-weight: 800; font-size: 18px; margin-right: 10px; }
.brand span { font-size: 11px; color: #85939d; font-weight: 500; }
.status { flex: 0 1 420px; font-size: 12px; color: #73818b; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 420px; }
.topbar-customer-stats { flex:0 0 auto; display:flex; align-items:center; gap:7px; min-width:0; padding:4px 8px; border:1px solid #dce7e1; border-radius:9px; background:#f7fbf9; color:#62726a; font-size:11px; line-height:1; white-space:nowrap; }
.topbar-customer-stats > span { display:inline-flex; align-items:center; gap:3px; }
.topbar-customer-stats strong { color:#178b4a; font-size:12px; }
.topbar-customer-stats .customer-stats-scope { max-width:92px; overflow:hidden; text-overflow:ellipsis; color:#75837c; font-weight:700; }
.topbar-customer-stats .duplicate-stat { color:#b23a3a; }
.topbar-customer-stats .duplicate-stat strong { color:#d03939; }

.leftbar { position: fixed; top: var(--topbar-height); left: 0; bottom: 0; width: var(--account-sidebar-width); background: #fff; border-right: 1px solid #dce5e9; z-index: 10; }
.left-title { height: 50px; display: flex; align-items: center; justify-content: space-between; padding: 0 14px; font-weight: 700; border-bottom: 1px solid #edf1f3; }
.count { background: #e8f8ef; color: #1c9b51; min-width: 23px; height: 23px; border-radius: 12px; display: grid; place-items: center; font-size: 11px; }
.accounts { height: calc(100% - 50px); overflow-y: auto; }
.account { position: relative; min-height: 66px; padding: 12px 108px 12px 57px; border-bottom: 1px solid #edf1f3; cursor: pointer; background: #fff; }
.account:hover, .account.active { background: #effaf4; }
.account-name { font-weight: 700; min-height: 20px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.account-meta { color: #7a8993; font-size: 11px; margin-top: 4px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.account-actions { position: absolute; right: 7px; top: 10px; display: flex; }
.mini { border: 0; background: transparent; padding: 3px 5px; font-size: 16px; color: #71808a; }

.view-placeholder {
  position: fixed;
  left: var(--account-sidebar-width);
  right: 0;
  top: var(--topbar-height);
  bottom: 0;
  display: grid;
  place-items: center;
}
.placeholder { display: grid; place-items: center; gap: 8px; color: #84929c; }
.placeholder .bubble { font-size: 48px; }

.translator { position: fixed; right: 0; top: var(--topbar-height); bottom: 0; width: 370px; background: #fff; border-left: 1px solid #dce5e9; padding: 14px; z-index: 10; overflow-y: auto; }
.translator h2 { margin: 2px 0 12px; font-size: 18px; }
.row { display: flex; gap: 8px; align-items: center; }
.row > * { flex: 1; }
.translator select { padding: 8px; border: 1px solid #d6e0e4; border-radius: 7px; background: #fff; }
.translator textarea { width: 100%; height: 180px; resize: vertical; margin: 10px 0; border: 1px solid #d6e0e4; border-radius: 9px; padding: 10px; outline: none; }
.button-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; }
.section-label { font-size: 12px; color: #72808a; display: block; margin-top: 12px; }
.translator-status { min-height: 30px; padding-top: 10px; color: #74828c; font-size: 12px; line-height: 1.5; }

.modal { position: fixed; inset: 0; background: rgba(13,24,31,.42); display: grid; place-items: center; z-index: 100; }
.modal.hidden { display: none; }
.modal-card { width: min(620px, 92vw); max-height: 90vh; overflow-y: auto; background: #fff; border-radius: 15px; padding: 18px; box-shadow: 0 20px 70px rgba(0,0,0,.25); }
.settings-card { width: min(720px, 92vw); }
.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
.modal-head h3 { margin: 0; }
.close { border: 0; font-size: 20px; padding: 4px 9px; }
.modal-card label { display: block; font-size: 12px; color: #6e7e88; margin: 10px 0; }
.modal-card label input, .modal-card label select { width: 100%; padding: 9px; margin-top: 5px; border: 1px solid #d6e0e4; border-radius: 8px; }
.check-row { display: flex; align-items: center; gap: 7px; margin: 10px 0; }
.check-row label { margin: 0; }
.proxy-grid { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: 8px; }
.modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
.hint { background: #f5f8f9; border-radius: 9px; padding: 10px; font-size: 12px; color: #75838d; line-height: 1.6; }
hr { border: 0; border-top: 1px solid #e3eaed; margin: 16px 0; }
pre { white-space: pre-wrap; word-break: break-all; background: #f5f8f9; border-radius: 10px; padding: 12px; max-height: 60vh; overflow: auto; }


.compact-gap { margin-top: 7px; }

.wide-action {
  width: 100%;
  margin-top: 8px;
  border: 1px solid #b9e7cd;
  background: #effaf4;
  color: #168849;
  font-weight: 700;
}

.wide-action:hover { background: #e4f7ed; }

.network-ok { color: #15924d; }
.network-error { color: #cf4242; }


.account.closed {
  opacity: .72;
  background: #fafbfc;
}

.account.closed.active {
  background: #f5f7f8;
}

.account-state {
  font-weight: 600;
}

.account-state.open {
  color: #179651;
}

.account-state.closed {
  color: #87949c;
}

.window-btn {
  min-width: 27px;
}

.delete-btn {
  min-width: 27px;
  color: #c94a4a;
}

.delete-btn:hover {
  color: #a92828;
  background: #fff1f1;
}


.crm-card { width: min(700px, 94vw); }
.modal-card textarea {
  width: 100%;
  margin-top: 5px;
  padding: 10px;
  border: 1px solid #d6e0e4;
  border-radius: 8px;
  resize: vertical;
  outline: none;
  font: inherit;
}
.crm-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin: 6px 0 14px;
}
.crm-summary > div {
  border: 1px solid #e1e8eb;
  border-radius: 10px;
  padding: 10px 12px;
  background: #f8fafb;
}
.crm-summary span {
  display: block;
  font-size: 11px;
  color: #7d8b94;
  margin-bottom: 4px;
}
.crm-summary strong { font-size: 14px; }
.crm-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}
@media (max-width: 900px) {
  .crm-grid, .crm-summary { grid-template-columns: 1fr; }
}


.translation-toggle.translation-off { border-color:#d7dde0; background:#f4f6f7; color:#7c898f; font-weight:700; }
.translate-account-btn.off { color:#8b989e; background:#f2f4f5; }
.send-translate-card textarea[readonly] { background:#f7f9fa; color:#53616a; }


.ai-settings-box {
  margin: 12px 0;
  padding: 12px;
  border: 1px solid #dfe7e3;
  border-radius: 8px;
  background: #f8fbf9;
}

.ai-settings-box h4 {
  margin: 0 0 10px;
}

.provider-card {
  margin: 10px 0;
  padding: 10px 12px;
  border: 1px solid #e6e8eb;
  border-radius: 10px;
  background: #fafbfc;
}
.provider-card h5 {
  margin: 0 0 8px;
  font-size: 13px;
  color: #20252b;
}


.test-ai-btn {
  margin-top: 8px;
  padding: 7px 12px;
  border: 1px solid #c7d1da;
  border-radius: 8px;
  background: #fff;
  cursor: pointer;
}
.test-ai-btn:hover { background: #f5f8fa; }
.test-ai-btn:disabled { opacity: .6; cursor: wait; }
.ai-test-result {
  margin: 10px 0 14px;
  padding: 10px 12px;
  border-radius: 8px;
  background: #f6f8fa;
  color: #53606a;
  font-size: 12px;
  line-height: 1.5;
  white-space: pre-wrap;
  word-break: break-word;
}
.ai-test-result.ok { background: #eefaf2; color: #18733b; }
.ai-test-result.error { background: #fff2f0; color: #b42318; }

.ai-reply-top {
  border-color: #c8b8ff;
  background: #f4f0ff;
  color: #6b46c1;
  font-weight: 700;
}
.ai-reply-top:hover { background: #ece5ff; }
.ai-reply-card { width: min(760px, 94vw); }
.ai-reply-actions { justify-content: flex-start; }
.ai-reply-status {
  margin-top: 8px;
  padding: 9px 11px;
  border-radius: 9px;
  background: #f5f8f9;
  color: #71808a;
  font-size: 12px;
  line-height: 1.55;
}
.ai-reply-settings-card textarea { min-height: 100px; }
#aiReplyCustomerMessage { background: #f8fafb; }
#aiReplyResult { min-height: 150px; }

/* V1.10.8: AI Reply removed */
#aiReplyBtn, #aiReplyModal, .ai-reply-settings-card { display: none !important; }


/* V1.10.15 LINE account avatar + exact unread badge */
.account-avatar-wrap {
  position: absolute;
  left: 11px;
  top: 12px;
  width: 38px;
  height: 38px;
}
.account-avatar {
  position: relative;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  overflow: hidden;
  background: #e8f8ef;
  color: #178a4b;
  font-weight: 800;
  font-size: 15px;
  border: 1px solid #dce7e1;
}
.account-avatar-fallback {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 1;
}
.account-avatar-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  z-index: 2;
  background: #e8f8ef;
}
.account-avatar-img.is-loaded {
  visibility: visible;
}
.account-online-dot {
  position: absolute;
  right: -1px;
  bottom: -1px;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: #20c56b;
  border: 2px solid #fff;
  box-shadow: 0 1px 3px rgba(0,0,0,.18);
  z-index: 3;
}
.account-unread {
  position: absolute;
  right: -7px;
  top: -7px;
  min-width: 19px;
  height: 19px;
  padding: 0 5px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f04444;
  color: #fff;
  font-size: 10px;
  font-weight: 800;
  line-height: 1;
  border: 2px solid #fff;
  box-shadow: 0 1px 4px rgba(0,0,0,.16);
}
.account-primary-name {
  color: inherit;
  font-weight: 700;
}
.account-alias-name,
.line-display-name {
  margin-left: 6px;
  color: #93a0a8;
  font-size: 10px;
  font-weight: 500;
}


/* V1.10.16 collapsible LINE account sidebar.
   The LINE WebContentsView uses the same left offset via IPC, so LINE's dark
   navigation rail moves together with this sidebar and leaves no white gap. */
.left-title-actions { display: flex; align-items: center; gap: 7px; }
.sidebar-toggle {
  width: 28px;
  height: 28px;
  min-width: 28px;
  padding: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #5f6f79;
  background: #fff;
}
.sidebar-toggle:hover { background: #f1f6f4; color: #1d9b55; }
body.accounts-collapsed { --account-sidebar-width: 94px; }
body.accounts-collapsed .left-title { padding: 0; justify-content: center; }
body.accounts-collapsed .left-title-label,
body.accounts-collapsed .count { display: none; }
body.accounts-collapsed .left-title-actions { width: 100%; justify-content: center; }
body.accounts-collapsed .account {
  min-height: 66px;
  padding: 10px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}
body.accounts-collapsed .account-avatar-wrap {
  position: relative;
  left: auto;
  top: auto;
  margin: 0;
}
body.accounts-collapsed .account-name,
body.accounts-collapsed .account-meta,
body.accounts-collapsed .account-actions { display: none; }
body.accounts-collapsed .account-avatar { width: 42px; height: 42px; }
body.accounts-collapsed .account-unread { right: -8px; top: -7px; z-index: 4; }
body.accounts-collapsed .account-online-dot { right: -2px; bottom: -2px; }
body.accounts-collapsed .accounts { overflow-x: hidden; }
body.accounts-collapsed .account:hover,
body.accounts-collapsed .account.active { background: #effaf4; }


/* V1.10.21 QL-style LINE account cards: avatar + nickname + public user ID + local alias. */
.leftbar {
  background: #f8faf9;
  border-right-color: #e4ebe7;
}
.left-title {
  height: 58px;
  padding: 0 16px;
  background: #ffffff;
  border-bottom: 1px solid #e9efeb;
}
.left-title-label {
  color: #20b963;
  font-size: 17px;
  font-weight: 700;
}
.accounts {
  height: calc(100% - 58px);
  padding: 10px 10px 18px;
  background: #f8faf9;
}
.account {
  min-height: 104px;
  margin-bottom: 10px;
  padding: 11px 82px 10px 72px;
  border: 1px solid #e2e9e5;
  border-radius: 11px;
  background: #fff;
  box-shadow: 0 1px 2px rgba(31, 51, 42, .025);
  transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
}
.account:hover {
  background: #fff;
  border-color: #b9dec9;
  box-shadow: 0 3px 10px rgba(31, 51, 42, .055);
}
.account.active {
  background: #fff;
  border: 2px solid #22c56b;
  padding: 10px 81px 9px 71px;
  box-shadow: 0 4px 12px rgba(34,197,107,.08);
}
.account.closed { opacity: .72; }
.account-avatar-wrap {
  left: 13px;
  top: 15px;
  width: 50px;
  height: 50px;
}
.account-avatar {
  width: 50px;
  height: 50px;
  font-size: 18px;
  background: #eef8f2;
  border-color: #d9e8df;
}
.account-online-dot,
.account-offline-dot {
  position: absolute;
  right: -1px;
  bottom: -1px;
  width: 13px;
  height: 13px;
  border-radius: 50%;
  border: 2px solid #fff;
  box-shadow: 0 1px 3px rgba(0,0,0,.16);
  z-index: 3;
}
.account-online-dot { background: #21c86a; }
.account-offline-dot { background: #9aa5ab; }
.account-unread {
  top: -7px;
  right: -8px;
  min-width: 20px;
  height: 20px;
  font-size: 10px;
}
.account-info { min-width: 0; }
.account-name-row { display: flex; align-items: center; min-height: 21px; }
.account-primary-name {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #25313a;
  font-size: 14px;
  font-weight: 700;
}
.account-user-id {
  margin-top: 1px;
  color: #91a0aa;
  font-size: 12px;
  line-height: 18px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.account-alias-row {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 1px;
  color: #394750;
  font-size: 12px;
  font-weight: 600;
  line-height: 18px;
}
.account-pencil { color: #4f606a; font-size: 13px; transform: translateY(-1px); }
.account-alias-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.account-network-row {
  margin-top: 2px;
  color: #9aa6ad;
  font-size: 10px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.account-actions {
  right: 7px;
  top: 8px;
  display: flex;
  gap: 0;
  align-items: center;
}
.account-actions .mini {
  font-size: 13px;
  padding: 3px 4px;
  opacity: .72;
}
.account-actions .mini:hover { opacity: 1; }
.account-name, .account-meta { display: none; }

body.accounts-collapsed .left-title {
  height: 58px;
  padding: 0;
  justify-content: center;
}
body.accounts-collapsed .accounts {
  height: calc(100% - 58px);
  padding: 10px 8px 16px;
}
body.accounts-collapsed .account {
  min-height: 84px;
  margin-bottom: 9px;
  padding: 8px 2px 7px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border: 1px solid #e4e9e6;
  border-radius: 9px;
  background: #fff;
}
body.accounts-collapsed .account.active {
  border: 2px solid #22c56b;
  padding: 7px 1px 6px;
}
body.accounts-collapsed .account-avatar-wrap {
  width: 46px;
  height: 46px;
  margin: 0 auto;
}
body.accounts-collapsed .account-avatar { width: 46px; height: 46px; }
body.accounts-collapsed .account-info {
  display: block;
  width: 100%;
  margin-top: 5px;
  padding: 0 3px;
  text-align: center;
}
body.accounts-collapsed .account-name-row,
body.accounts-collapsed .account-user-id,
body.accounts-collapsed .account-network-row { display: none; }
body.accounts-collapsed .account-alias-row {
  display: block;
  margin: 0;
  color: #7a8992;
  font-size: 11px;
  font-weight: 500;
  line-height: 16px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
body.accounts-collapsed .account-pencil { display: none; }
body.accounts-collapsed .account-actions { display: none; }
body.accounts-collapsed .account-unread { right: -7px; top: -7px; }
body.accounts-collapsed .account-online-dot,
body.accounts-collapsed .account-offline-dot { right: -1px; bottom: -1px; }

/* V1.11.0 — QL-style account manager panel, widths synchronized with the
   Electron WebContentsView (252px expanded / 92px collapsed). */
:root { --account-sidebar-width: 252px; }
body.accounts-collapsed { --account-sidebar-width: 92px; }

.leftbar {
  background: #f7f9f8;
  border-right: 1px solid #e6ece9;
}
.left-title {
  height: 56px;
  padding: 0 12px 0 14px;
  background: #fff;
  border-bottom: 1px solid #e8efeb;
}
.left-title-label {
  color: #20b964;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: .1px;
}
.left-title-actions { gap: 6px; }
.sidebar-toggle {
  display: grid !important;
  visibility: visible !important;
  width: 28px;
  height: 28px;
  min-width: 28px;
  border: 1px solid #dfe8e3;
  background: #fff;
  color: #4d606a;
  box-shadow: 0 1px 2px rgba(20,40,30,.03);
}
.sidebar-toggle:hover { border-color: #b9dfca; color: #16a357; background: #f4fbf7; }

.accounts {
  height: calc(100% - 56px);
  padding: 10px 8px 18px;
  background: #f7f9f8;
}
.account {
  min-height: 98px;
  margin: 0 0 9px;
  padding: 10px 77px 9px 70px;
  border: 1px solid #e1e8e4;
  border-radius: 9px;
  background: #fff;
  box-shadow: 0 1px 2px rgba(35,55,45,.025);
  overflow: visible;
}
.account:hover { border-color: #c6dfd1; box-shadow: 0 3px 10px rgba(35,55,45,.045); }
.account.active {
  border: 2px solid #20c467;
  padding: 9px 76px 8px 69px;
  background: #fff;
  box-shadow: 0 3px 12px rgba(32,196,103,.07);
}
.account-avatar-wrap {
  left: 12px;
  top: 14px;
  width: 48px;
  height: 48px;
}
.account-avatar {
  position: relative;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  overflow: hidden;
  background: #edf8f2;
  border: 1px solid #d8e7df;
  color: #159151;
  font-size: 17px;
}
.account-avatar-fallback {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  z-index: 0;
}
.account-avatar-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  z-index: 1;
  background: #fff;
}
.account-online-dot,
.account-offline-dot {
  right: -1px;
  bottom: -1px;
  width: 13px;
  height: 13px;
  border: 2px solid #fff;
}
.account-online-dot { background: #20c56b; }
.account-offline-dot { background: #9ca8ae; }
.account-unread { right: -7px; top: -7px; }

.account-primary-name {
  font-size: 14px;
  line-height: 20px;
  color: #243039;
  font-weight: 700;
}
.account-user-id {
  margin-top: 0;
  font-size: 12px;
  line-height: 18px;
  color: #95a1aa;
}
.account-alias-row {
  margin-top: 0;
  color: #2d3941;
  font-size: 12px;
  line-height: 18px;
  font-weight: 600;
}
.account-network-row {
  margin-top: 0;
  max-width: 142px;
  color: #9ba7ae;
  font-size: 9.5px;
  line-height: 16px;
}
.account-actions {
  display: grid !important;
  visibility: visible !important;
  grid-template-columns: repeat(2, 27px);
  gap: 1px;
  right: 8px;
  top: 8px;
  width: 55px;
}
.account-actions .mini {
  display: grid !important;
  visibility: visible !important;
  place-items: center;
  width: 27px;
  height: 25px;
  min-width: 27px;
  padding: 0;
  border-radius: 6px;
  font-size: 12px;
  opacity: .78;
}
.account-actions .mini:hover { background: #f2f6f4; opacity: 1; }
.account-actions .delete-btn { color: #d05c65; }
.account-actions .delete-btn:hover { background: #fff1f2; color: #b83f4a; }

/* Compact account mode: avatar + local label only; LINE's own dark rail starts
   immediately at x=92 because main.js uses the exact same collapsed width. */
body.accounts-collapsed .left-title {
  height: 54px;
  padding: 0;
}
body.accounts-collapsed .left-title-label,
body.accounts-collapsed .count { display: none; }
body.accounts-collapsed .left-title-actions { width: 100%; justify-content: center; }
body.accounts-collapsed .accounts {
  height: calc(100% - 54px);
  padding: 8px 7px 16px;
}
body.accounts-collapsed .account {
  min-height: 78px;
  margin-bottom: 8px;
  padding: 7px 2px 6px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  border-radius: 8px;
}
body.accounts-collapsed .account.active { padding: 6px 1px 5px; }
body.accounts-collapsed .account-avatar-wrap {
  position: relative;
  left: auto;
  top: auto;
  width: 44px;
  height: 44px;
  margin: 0 auto;
}
body.accounts-collapsed .account-avatar { width: 44px; height: 44px; }
body.accounts-collapsed .account-info {
  display: block;
  width: 100%;
  margin-top: 4px;
  padding: 0 2px;
  text-align: center;
}
body.accounts-collapsed .account-name-row,
body.accounts-collapsed .account-user-id,
body.accounts-collapsed .account-network-row { display: none; }
body.accounts-collapsed .account-alias-row {
  display: block;
  margin: 0;
  font-size: 11px;
  line-height: 15px;
  font-weight: 500;
  color: #7d8991;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
body.accounts-collapsed .account-pencil { display: none; }
body.accounts-collapsed .account-actions { display: none !important; }
body.accounts-collapsed .account-unread { right: -7px; top: -6px; }
body.accounts-collapsed .account-online-dot,
body.accounts-collapsed .account-offline-dot { right: -1px; bottom: -1px; }


/* V1.11.1 — inline alias editing + left-button drag reordering. */
.account { cursor: grab; }
.account:active { cursor: grabbing; }
.account.dragging {
  opacity: .5;
  cursor: grabbing;
  border-color: #20c467 !important;
  box-shadow: 0 8px 22px rgba(32,196,103,.14) !important;
}
.account-pencil {
  display: inline-grid;
  place-items: center;
  min-width: 18px;
  height: 18px;
  margin-right: 1px;
  border-radius: 4px;
  cursor: text;
  user-select: none;
}
.account-pencil:hover {
  color: #13a95b;
  background: #edf9f2;
}
.account-alias-input {
  width: min(128px, calc(100% - 4px));
  height: 24px;
  margin: -3px 0 -3px 0;
  padding: 2px 6px;
  border: 1px solid #20c467;
  border-radius: 5px;
  outline: none;
  background: #fff;
  color: #26343c;
  font: inherit;
  line-height: 20px;
  box-shadow: 0 0 0 2px rgba(32,196,103,.09);
}
.account-actions .mini,
.account-alias-input,
.account-pencil { cursor: pointer; }
.account-alias-input { cursor: text; }
body.accounts-collapsed .account { cursor: grab; }
.account-avatar-img {
  -webkit-user-drag: none;
  user-select: none;
}
.account-info { user-select: none; }
.account-alias-input { user-select: text; }


/* V1.11.2 — one-click start / close / restart controls for all LINE accounts. */
.leftbar {
  display: flex;
  flex-direction: column;
}
.left-title {
  flex: 0 0 56px;
}
.bulk-line-controls {
  flex: 0 0 42px;
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  background: #fff;
  border-bottom: 1px solid #e8efeb;
}
.bulk-line-btn {
  flex: 1 1 0;
  min-width: 0;
  height: 30px;
  padding: 0 5px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 3px;
  border: 1px solid #dce7e1;
  border-radius: 7px;
  background: #fff;
  color: #52636d;
  font-size: 11px;
  white-space: nowrap;
}
.bulk-line-btn:hover { background: #f5faf7; border-color: #b9deca; }
.bulk-line-btn.start { color: #168f4d; }
.bulk-line-btn.stop { color: #b45555; }
.bulk-line-btn.restart { color: #50739a; }
.bulk-line-btn:disabled { opacity: .48; cursor: wait; }
.bulk-line-icon { font-size: 12px; line-height: 1; }
.accounts {
  flex: 1 1 auto;
  min-height: 0;
  height: auto !important;
}
body.accounts-collapsed .left-title { flex-basis: 56px; }
body.accounts-collapsed .bulk-line-controls {
  flex-basis: 38px;
  gap: 3px;
  padding: 5px 6px;
}
body.accounts-collapsed .bulk-line-btn {
  height: 27px;
  padding: 0;
  border-radius: 6px;
}
body.accounts-collapsed .bulk-line-text { display: none; }
body.accounts-collapsed .bulk-line-icon { font-size: 12px; }
body.accounts-collapsed .accounts {
  flex: 1 1 auto;
  height: auto !important;
}


.update-card { margin-top: 8px; }
.update-summary { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 8px; }
.update-summary > div { background: #f7f9fa; border: 1px solid #e5eaed; border-radius: 10px; padding: 10px 12px; display: flex; justify-content: space-between; gap: 12px; }
.update-summary span { color: #6f7f88; font-size: 12px; }
.update-summary strong { color: #12202a; }
.update-actions { flex-wrap: wrap; margin-top: 8px; }


/* V1.11.10 — narrower account sidebar + dedicated start/stop + vertical three-dot menu. */
:root { --account-sidebar-width: 252px; }

.account {
  min-height: 92px;
  padding: 9px 45px 8px 64px;
}
.account.active {
  padding: 8px 44px 7px 63px;
}
.account-avatar-wrap {
  left: 10px;
  top: 13px;
  width: 44px;
  height: 44px;
}
.account-avatar { width: 44px; height: 44px; }
.account-info {
  min-width: 0;
  padding-top: 0;
}
.account-name-row,
.account-primary-name,
.account-user-id,
.account-alias-row,
.account-network-row {
  min-width: 0;
  max-width: 100%;
}
.account-primary-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 13.5px;
  line-height: 18px;
}
.account-user-id {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 10.5px;
  line-height: 16px;
}
.account-alias-row {
  display: flex;
  align-items: center;
  gap: 4px;
  overflow: hidden;
  margin-top: 0;
  color: #46545d;
  font-size: 11px;
  line-height: 16px;
  font-weight: 500;
  cursor: text;
  border-radius: 4px;
}
.account-alias-row:hover { color: #159653; background: #f2faf6; }
.account-alias-prefix {
  flex: 0 0 auto;
  color: #9aa6ad;
  font-size: 9.5px;
  font-weight: 500;
}
.account-alias-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.account-network-row {
  display: flex;
  align-items: center;
  overflow: hidden;
  white-space: nowrap;
  color: #9ba7ae;
  font-size: 9.5px;
  line-height: 15px;
}
.account-actions {
  position: absolute;
  right: 7px;
  top: 8px;
  width: 28px;
  display: flex !important;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  z-index: 6;
}
.account-actions .mini {
  display: grid !important;
  place-items: center;
  width: 28px;
  height: 27px;
  min-width: 28px;
  padding: 0;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: #829099;
  font-size: 14px;
  line-height: 1;
  opacity: .84;
}
.account-actions .window-btn { font-size: 12px; }
.account-actions .account-menu-toggle {
  font-size: 21px;
  font-weight: 700;
  letter-spacing: 0;
  padding-bottom: 4px;
}
.account-actions .mini:hover,
.account-actions .account-menu-toggle[aria-expanded="true"] {
  background: #edf7f2;
  color: #159653;
  opacity: 1;
}
.account-menu-wrap { position: relative; width: 28px; height: 27px; }
.account-action-menu {
  display: none;
  position: absolute;
  top: 28px;
  right: 0;
  width: 122px;
  padding: 5px;
  border: 1px solid #dce6e1;
  border-radius: 9px;
  background: #fff;
  box-shadow: 0 8px 26px rgba(26,47,37,.16);
  z-index: 80;
}
.account-action-menu.open { display: grid; gap: 2px; }
.account-action-menu.open.open-up { top: auto; bottom: 28px; }
.account-menu-item {
  width: 100%;
  height: 31px;
  display: grid;
  grid-template-columns: 23px 1fr;
  align-items: center;
  gap: 3px;
  padding: 0 7px;
  border: 0;
  border-radius: 6px;
  background: #fff;
  color: #46555d;
  text-align: left;
  font-size: 11.5px;
  white-space: nowrap;
}
.account-menu-item:hover { background: #f1f8f4; color: #159653; }
.account-menu-item.delete-btn { color: #c45159; }
.account-menu-item.delete-btn:hover { background: #fff1f2; color: #b53f49; }
.account-alias-input {
  width: 100%;
  max-width: 118px;
  height: 22px;
  margin: -3px 0;
  padding: 1px 5px;
  font-size: 11px;
}
body.accounts-collapsed { --account-sidebar-width: 92px; }
body.accounts-collapsed .account-actions { display: none !important; }
body.accounts-collapsed .account-alias-prefix { display: none; }


/* V1.11.11 — compact black-text cards, direct rename, visible network/start/delete actions. */
:root { --account-sidebar-width: 232px; }

.account {
  min-height: 78px;
  margin-bottom: 7px;
  padding: 8px 52px 6px 58px;
  color: #111;
}
.account.active { padding: 7px 51px 5px 57px; }
.account.closed { opacity: 1; background: #fff; }
.account.closed.active { background: #fff; }
.account-avatar-wrap { left: 9px; top: 10px; width: 40px; height: 40px; }
.account-avatar { width: 40px; height: 40px; }
.account-info { padding-top: 0; color: #111; }
.account-name-row {
  display: flex;
  align-items: center;
  gap: 5px;
  min-width: 0;
  height: 18px;
}
.account-primary-name {
  flex: 1 1 auto;
  min-width: 0;
  color: #111 !important;
  font-size: 12.5px;
  line-height: 18px;
  font-weight: 700;
  cursor: text;
}
.account-primary-name:hover { color: #159653 !important; }
.account-inline-status {
  flex: 0 0 auto;
  color: #30383d;
  font-size: 8.8px;
  line-height: 14px;
  font-weight: 600;
  white-space: nowrap;
}
.account-inline-status.open { color: #168c4a; }
.account-inline-status.closed { color: #50595e; }
.account-user-id {
  margin-top: 0;
  color: #222 !important;
  font-size: 10px;
  line-height: 15px;
  font-weight: 500;
}
.account-alias-row {
  display: flex;
  align-items: center;
  gap: 3px;
  margin-top: 0;
  color: #111 !important;
  font-size: 10.5px;
  line-height: 15px;
  font-weight: 600;
  cursor: text;
}
.account-alias-row:hover { color: #159653 !important; background: transparent; }
.account-pencil {
  min-width: 12px;
  width: 12px;
  height: 14px;
  margin: 0;
  color: #111 !important;
  font-size: 10px;
  line-height: 14px;
}
.account-network-row, .account-alias-prefix { display: none !important; }
.account-actions {
  right: 5px;
  top: 7px;
  width: 45px;
  display: grid !important;
  grid-template-columns: 22px 22px;
  grid-template-rows: 23px 23px;
  gap: 1px;
  align-items: center;
}
.account-actions .mini {
  width: 22px;
  height: 23px;
  min-width: 22px;
  padding: 0;
  color: #111 !important;
  background: transparent;
  border: 0;
  border-radius: 5px;
  font-size: 11px;
  line-height: 1;
  opacity: .82;
}
.account-actions .network-btn { grid-column: 1; grid-row: 1; font-size: 12px; }
.account-actions .window-btn { grid-column: 2; grid-row: 1; font-size: 11px; }
.account-actions .delete-btn { grid-column: 2; grid-row: 2; color: #b84a52 !important; font-size: 16px; }
.account-actions .mini:hover { background: #edf7f2; color: #159653 !important; opacity: 1; }
.account-actions .delete-btn:hover { background: #fff1f2; color: #b53f49 !important; }
.account-name-input, .account-alias-input {
  width: 100%;
  max-width: 104px;
  height: 20px;
  padding: 1px 4px;
  margin: -1px 0;
  border: 1px solid #20c467;
  border-radius: 4px;
  background: #fff;
  color: #111;
  font-size: 10.5px;
  font-weight: 600;
  outline: none;
}
.account-name-input { max-width: 98px; font-size: 11.5px; }
.proxy-only-card { width: min(560px, 92vw); }
.proxy-account-summary {
  margin: 2px 0 10px;
  padding: 8px 10px;
  border-radius: 8px;
  background: #f3f8f5;
  color: #111;
  font-size: 12px;
  font-weight: 700;
}

body.accounts-collapsed { --account-sidebar-width: 92px; }
body.accounts-collapsed .account-actions { display: none !important; }
body.accounts-collapsed .account-inline-status { display: none; }


/* V1.11.12 — roomier cards, larger avatar/text, status separated from nickname,
   and latency/IP testing centralized inside the Proxy dialog. */
:root { --account-sidebar-width: 250px; }
.account {
  min-height: 84px;
  margin-bottom: 8px;
  padding: 8px 43px 7px 76px;
  color: #111;
}
.account.active { padding: 7px 42px 6px 75px; }
.account-avatar-wrap { left: 8px; top: 7px; width: 60px; height: 60px; }
.account-avatar { width: 60px; height: 60px; }
.account-online-dot, .account-offline-dot { right: -1px; bottom: -1px; }
.account-unread { top: -3px; right: -4px; }
.account-info { padding-top: 1px; color: #111; min-width: 0; }
.account-name-row { display: flex; align-items: center; min-width: 0; height: 21px; }
.account-primary-name { color: #111 !important; font-size: 14px; line-height: 21px; font-weight: 700; }
.account-user-id { margin-top: 1px; color: #222 !important; font-size: 11.5px; line-height: 18px; font-weight: 500; }
.account-alias-row { gap: 4px; margin-top: 1px; color: #111 !important; font-size: 12px; line-height: 19px; font-weight: 600; }
.account-pencil { min-width: 13px; width: 13px; height: 17px; color: #111 !important; font-size: 11px; line-height: 17px; }
.account-inline-status, .account-network-row { display: none !important; }
.account-actions {
  right: 5px; top: 6px; bottom: 6px; width: 34px;
  display: grid !important; grid-template-columns: 34px; grid-template-rows: 25px 1fr 25px;
  gap: 0; align-items: center; justify-items: center;
}
.account-actions .mini { width: 28px; height: 25px; min-width: 28px; color: #111 !important; font-size: 12px; opacity: .82; }
.account-actions .window-btn { grid-column: 1; grid-row: 1; font-size: 12px; }
.account-window-status {
  grid-column: 1; grid-row: 2; align-self: center; padding: 2px 3px; border-radius: 5px;
  color: #606a70; font-size: 10px; line-height: 13px; font-weight: 600; white-space: nowrap;
}
.account-window-status.open { color: #168c4a; background: #eefaf3; }
.account-window-status.closed { color: #59636a; background: #f2f4f5; }
.account-actions .delete-btn { grid-column: 1; grid-row: 3; color: #b84a52 !important; font-size: 17px; }
.account-name-input, .account-alias-input { max-width: 122px; height: 23px; color: #111; font-size: 12px; font-weight: 600; }
.account-name-input { max-width: 126px; font-size: 13px; }
.proxy-test-panel {
  display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 10px;
  margin: 12px 0 10px; padding: 10px; border: 1px solid #dbe7e1; border-radius: 9px; background: #f7faf8;
}
.proxy-test-panel button { min-width: 92px; height: 34px; font-weight: 700; }
.proxy-test-result {
  min-height: 34px; display: flex; align-items: center; padding: 6px 9px; border-radius: 7px;
  background: #fff; color: #30383d; font-size: 12px; line-height: 1.45; border: 1px solid #e1e8e4;
}
.proxy-test-result.testing { color: #66747c; }
.proxy-test-result.ok { color: #18733b; background: #eefaf2; border-color: #cfead8; }
.proxy-test-result.error { color: #b42318; background: #fff2f0; border-color: #f2d0cb; }
body.accounts-collapsed { --account-sidebar-width: 92px; }
body.accounts-collapsed .account-actions, body.accounts-collapsed .account-window-status { display: none !important; }
body.accounts-collapsed .account-avatar-wrap { left: 16px; top: 9px; width: 58px; height: 58px; }
body.accounts-collapsed .account-avatar { width: 58px; height: 58px; }


/* V1.11.13 — fixed LINE nickname + explicit ID label + cleaner non-overlapping card layout. */
:root { --account-sidebar-width: 250px; }
.account {
  min-height: 88px;
  margin-bottom: 8px;
  padding: 8px 46px 8px 82px;
  overflow: hidden;
  color: #111;
}
.account.active { padding: 7px 45px 7px 81px; }
.account-avatar-wrap {
  left: 8px;
  top: 7px;
  width: 64px;
  height: 64px;
}
.account-avatar { width: 64px; height: 64px; font-size: 20px; }
.account-info {
  display: grid;
  grid-template-rows: 22px 19px 20px;
  align-content: center;
  row-gap: 1px;
  min-width: 0;
  height: 70px;
  padding: 0;
  overflow: hidden;
}
.account-name-row {
  min-width: 0;
  height: 22px;
  line-height: 22px;
  overflow: hidden;
}
.account-primary-name {
  display: block;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111 !important;
  font-size: 14.5px;
  line-height: 22px;
  font-weight: 700;
  cursor: default;
  user-select: text;
}
.account-primary-name:hover { color: #111 !important; }
.account-user-id {
  display: flex;
  align-items: center;
  min-width: 0;
  margin: 0;
  color: #303b42 !important;
  font-size: 11.5px;
  line-height: 19px;
  font-weight: 500;
  overflow: hidden;
}
.account-id-prefix {
  flex: 0 0 auto;
  color: #4c5961;
  font-weight: 700;
}
.account-id-value {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #303b42;
}
.account-alias-row {
  min-width: 0;
  height: 20px;
  margin: 0;
  gap: 4px;
  overflow: hidden;
  color: #111 !important;
  font-size: 12px;
  line-height: 20px;
  font-weight: 600;
}
.account-pencil {
  flex: 0 0 auto;
  min-width: 14px;
  width: 14px;
  height: 18px;
  font-size: 11px;
  line-height: 18px;
}
.account-alias-label {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.account-actions {
  right: 5px;
  top: 6px;
  bottom: 6px;
  width: 36px;
  display: grid !important;
  grid-template-columns: 36px;
  grid-template-rows: 26px 1fr 26px;
  align-items: center;
  justify-items: center;
  gap: 0;
  z-index: 4;
}
.account-actions .mini {
  width: 30px;
  height: 26px;
  min-width: 30px;
  padding: 0;
  border-radius: 6px;
}
.account-actions .window-btn { grid-row: 1; }
.account-window-status {
  grid-row: 2;
  align-self: center;
  min-width: 34px;
  max-width: 36px;
  padding: 2px 2px;
  text-align: center;
  font-size: 9.5px;
  line-height: 14px;
  border-radius: 5px;
  white-space: nowrap;
}
.account-actions .delete-btn { grid-row: 3; }
.account-name-input { display: none !important; }
body.accounts-collapsed { --account-sidebar-width: 92px; }
body.accounts-collapsed .account-avatar-wrap { left: 14px; top: 7px; width: 62px; height: 62px; }
body.accounts-collapsed .account-avatar { width: 62px; height: 62px; }

/* V1.11.14 — compact-sidebar avatar centering and tighter vertical rhythm. */
body.accounts-collapsed .accounts {
  padding: 5px 7px 10px;
}
body.accounts-collapsed .account,
body.accounts-collapsed .account.active {
  height: 88px;
  min-height: 88px;
  margin-bottom: 5px;
  padding: 4px 2px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  overflow: hidden;
}
body.accounts-collapsed .account-avatar-wrap {
  position: relative;
  left: auto;
  top: auto;
  width: 62px;
  height: 62px;
  margin: 0 auto;
  flex: 0 0 62px;
}
body.accounts-collapsed .account-avatar {
  width: 62px;
  height: 62px;
}
body.accounts-collapsed .account-info {
  display: block;
  width: 100%;
  height: 16px;
  min-height: 16px;
  margin: 2px 0 0;
  padding: 0 2px;
  overflow: hidden;
  text-align: center;
  flex: 0 0 16px;
}
body.accounts-collapsed .account-name-row,
body.accounts-collapsed .account-user-id,
body.accounts-collapsed .account-network-row {
  display: none;
}
body.accounts-collapsed .account-alias-row {
  display: block;
  width: 100%;
  height: 16px;
  margin: 0;
  color: #111 !important;
  font-size: 11.5px;
  line-height: 16px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
}
body.accounts-collapsed .account-pencil,
body.accounts-collapsed .account-actions,
body.accounts-collapsed .account-window-status {
  display: none !important;
}
body.accounts-collapsed .account-unread {
  right: -5px;
  top: -5px;
}
body.accounts-collapsed .account-online-dot,
body.accounts-collapsed .account-offline-dot {
  right: 0;
  bottom: 0;
}


/* V1.11.16 — clear closed-account visual state without disabling selection. */
.account.closed {
  opacity: 1 !important;
  background: #f0f2f3 !important;
  border-color: #d4dade !important;
  box-shadow: none !important;
}
.account.closed.active {
  background: #e9edef !important;
  border-color: #9eaaaf !important;
  box-shadow: 0 0 0 1px #9eaaaf inset !important;
}
.account.closed .account-avatar {
  background: #e5e9eb !important;
  border-color: #cfd6da !important;
}
.account.closed .account-avatar-img {
  filter: grayscale(.55) saturate(.68);
  opacity: .82;
}
.account.closed .account-primary-name,
.account.closed .account-user-id,
.account.closed .account-id-prefix,
.account.closed .account-id-value,
.account.closed .account-alias-row,
.account.closed .account-alias-label {
  color: #4b555b !important;
}
.account.closed .account-window-status {
  color: #566168 !important;
  background: #e0e4e6 !important;
  border-color: #cbd2d6 !important;
}
.account.closed .window-btn {
  background: #f7f8f8;
}
body.accounts-collapsed .account.closed,
body.accounts-collapsed .account.closed.active {
  background: #f0f2f3 !important;
  border-color: #d4dade !important;
}
body.accounts-collapsed .account.closed .account-avatar-img {
  filter: grayscale(.55) saturate(.68);
  opacity: .82;
}


/* V1.11.17 — proxy test inside Add Personal LINE form. */
.account-form-proxy-test { margin-top: 10px; margin-bottom: 8px; }
.account-form-proxy-test button { min-width: 96px; }

/* V1.12.0 — Aggregate Inbox workspace. */
.workspace-mode-switch {
  display: inline-flex;
  align-items: center;
  border: 1px solid #d7e0e4;
  border-radius: 9px;
  overflow: hidden;
  background: #f7f9fa;
  flex: 0 0 auto;
}
.workspace-mode-btn {
  position: relative;
  border: 0;
  border-radius: 0;
  padding: 7px 10px;
  min-width: 68px;
  background: transparent;
  color: #5d6a72;
  font-size: 12px;
  font-weight: 700;
}
.workspace-mode-btn + .workspace-mode-btn { border-left: 1px solid #d7e0e4; }
.workspace-mode-btn:hover { background: #eef5f1; }
.workspace-mode-btn.active { background: #2fc66d; color: #fff; }
.workspace-unread {
  display: inline-grid;
  place-items: center;
  min-width: 18px;
  height: 18px;
  margin-left: 5px;
  padding: 0 5px;
  border-radius: 10px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  line-height: 1;
  font-weight: 800;
}
.workspace-unread.hidden { display: none; }

.aggregate-view {
  position: fixed;
  left: var(--account-sidebar-width);
  right: 0;
  top: var(--topbar-height);
  bottom: 0;
  z-index: 8;
  background: #f2f5f6;
  overflow: hidden;
}
.aggregate-view.hidden { display: none; }
.aggregate-shell {
  height: 100%;
  display: grid;
  grid-template-rows: auto auto auto minmax(0, 1fr);
  gap: 10px;
  padding: 16px 18px 14px;
}
.aggregate-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}
.aggregate-head h2 { margin: 0 0 4px; font-size: 20px; color: #11181c; }
.aggregate-head p { margin: 0; color: #6e7b83; font-size: 12px; line-height: 1.5; }
.aggregate-summary {
  flex: 0 0 auto;
  padding: 7px 11px;
  border-radius: 9px;
  background: #fff;
  border: 1px solid #dfe6e9;
  color: #354149;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}
.aggregate-toolbar {
  display: grid;
  grid-template-columns: minmax(220px, 1fr) 180px auto auto;
  gap: 8px;
  align-items: center;
}
.aggregate-toolbar input,
.aggregate-toolbar select {
  height: 38px;
  border: 1px solid #d5dfe3;
  border-radius: 9px;
  background: #fff;
  padding: 0 11px;
  color: #182126;
  outline: none;
}
.aggregate-toolbar input:focus,
.aggregate-toolbar select:focus { border-color: #58c987; box-shadow: 0 0 0 2px rgba(47,198,109,.12); }
.aggregate-filter-btn[aria-pressed="true"] { background: #e8f8ef; border-color: #99dfb9; color: #178449; font-weight: 800; }
.aggregate-account-strip {
  display: flex;
  gap: 7px;
  align-items: center;
  min-height: 34px;
  overflow-x: auto;
  padding-bottom: 2px;
}
.aggregate-account-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-width: 0;
  max-width: 210px;
  padding: 5px 8px;
  border: 1px solid #dde5e8;
  border-radius: 9px;
  background: #fff;
  color: #263238;
  font-size: 11px;
  white-space: nowrap;
}
.aggregate-account-chip.closed { background: #eceff1; color: #69747a; }
.aggregate-account-chip .dot { width: 7px; height: 7px; border-radius: 50%; background: #adb7bc; flex: 0 0 auto; }
.aggregate-account-chip.online .dot { background: #2fc66d; }
.aggregate-account-chip strong { overflow: hidden; text-overflow: ellipsis; }
.aggregate-account-chip .count { min-width: 18px; height: 18px; font-size: 10px; }

.aggregate-list {
  min-height: 0;
  overflow-y: auto;
  display: grid;
  align-content: start;
  gap: 8px;
  padding-right: 3px;
}
.aggregate-empty {
  display: grid;
  place-items: center;
  min-height: 180px;
  color: #7f8c94;
  border: 1px dashed #cfd9de;
  border-radius: 12px;
  background: rgba(255,255,255,.65);
}
.aggregate-item {
  position: relative;
  display: grid;
  grid-template-columns: 48px minmax(0, 1fr) auto;
  gap: 11px;
  align-items: center;
  min-height: 70px;
  padding: 9px 11px;
  border: 1px solid #dde5e8;
  border-radius: 12px;
  background: #fff;
  cursor: pointer;
  box-shadow: 0 1px 1px rgba(18,32,40,.025);
}
.aggregate-item:hover { border-color: #9adab8; background: #f9fdfb; }
.aggregate-item.closed-account { background: #f3f5f6; border-color: #d8dee1; }
.aggregate-contact-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: #e8f1ed;
  color: #38584a;
  font-weight: 800;
  font-size: 18px;
  border: 1px solid #d6e1dc;
}
.aggregate-contact-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.aggregate-item.closed-account .aggregate-contact-avatar { filter: grayscale(.45); opacity: .82; }
.aggregate-item-main { min-width: 0; }
.aggregate-item-title-row { display: flex; align-items: center; gap: 8px; min-width: 0; }
.aggregate-contact-name { color: #101619; font-size: 14px; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.aggregate-account-label {
  max-width: 180px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 2px 6px;
  border-radius: 6px;
  background: #edf7f1;
  color: #23804f;
  font-size: 10px;
  font-weight: 700;
}
.aggregate-item.closed-account .aggregate-account-label { background: #e4e8ea; color: #69747a; }
.aggregate-preview {
  margin-top: 5px;
  color: #5e6b73;
  font-size: 12.5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.aggregate-preview.me::before { content: '我：'; color: #8b969c; }
.aggregate-item-meta {
  display: grid;
  justify-items: end;
  gap: 7px;
  min-width: 76px;
}
.aggregate-time { color: #8a969d; font-size: 10.5px; white-space: nowrap; }
.aggregate-unread {
  min-width: 22px;
  height: 22px;
  padding: 0 6px;
  border-radius: 11px;
  background: #ef4444;
  color: #fff;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 800;
}
.aggregate-closed-label { color: #7c888f; font-size: 10px; font-weight: 700; }

body.accounts-collapsed .aggregate-view { left: var(--account-sidebar-width); }
@media (max-width: 1180px) {
  .aggregate-toolbar { grid-template-columns: minmax(180px, 1fr) 150px auto; }
  #aggregateRefreshBtn { grid-column: 1 / -1; justify-self: end; }
  .topbar { padding-left: 10px; padding-right: 10px; }
  .topbar-row { gap: 6px; }
  .workspace-mode-btn { min-width: 62px; padding-left: 8px; padding-right: 8px; }
}

/* V1.12.1 — true aggregate-workbench sidebar + tighter, even account avatar spacing. */

/* Normal LINE mode: keep collapsed account avatars evenly spaced and centered. */
body.accounts-collapsed:not(.aggregate-mode) .accounts {
  padding: 8px 7px 14px !important;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
body.accounts-collapsed:not(.aggregate-mode) .account,
body.accounts-collapsed:not(.aggregate-mode) .account.active {
  flex: 0 0 84px;
  height: 84px;
  min-height: 84px;
  margin: 0 !important;
  padding: 5px 2px 4px !important;
  border: 1px solid transparent;
  border-radius: 10px;
}
body.accounts-collapsed:not(.aggregate-mode) .account-avatar-wrap {
  width: 56px !important;
  height: 56px !important;
  flex-basis: 56px !important;
  margin: 0 auto !important;
}
body.accounts-collapsed:not(.aggregate-mode) .account-avatar {
  width: 56px !important;
  height: 56px !important;
}
body.accounts-collapsed:not(.aggregate-mode) .account-info {
  height: 17px !important;
  min-height: 17px !important;
  flex-basis: 17px !important;
  margin-top: 3px !important;
}
body.accounts-collapsed:not(.aggregate-mode) .account-alias-row {
  height: 17px !important;
  line-height: 17px !important;
}

/* Aggregate mode uses the whole left rail for unread customers instead of LINE accounts. */
.aggregate-customer-sidebar { display: none; }
body.aggregate-mode { --account-sidebar-width: 310px !important; }
body.aggregate-mode .leftbar { width: 310px !important; }
body.aggregate-mode .left-title,
body.aggregate-mode .bulk-line-controls,
body.aggregate-mode #accounts { display: none !important; }
body.aggregate-mode .aggregate-customer-sidebar {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f9fa;
}
body.aggregate-mode .aggregate-customer-head,
body.aggregate-mode .aggregate-customer-filter,
body.aggregate-mode .aggregate-customer-search,
body.aggregate-mode .aggregate-ops-summary {
  flex: 0 0 auto;
}
body.aggregate-mode .aggregate-customer-list {
  flex: 1 1 auto;
  min-height: 0;
  height: auto !important;
  align-content: flex-start;
}
body.aggregate-mode .aggregate-view { display: none !important; }
body.aggregate-mode .view-placeholder { left: 310px !important; }

.aggregate-customer-head {
  min-height: 56px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 9px 10px 7px 12px;
  background: #fff;
  border-bottom: 1px solid #e2e8eb;
}
.aggregate-customer-title {
  min-width: 0;
  display: grid;
  gap: 2px;
}
.aggregate-customer-title strong {
  color: #11181c;
  font-size: 15px;
  line-height: 20px;
}
.aggregate-customer-title span {
  color: #7c8991;
  font-size: 10.5px;
  line-height: 15px;
  white-space: nowrap;
}
.aggregate-customer-refresh {
  width: 32px;
  height: 32px;
  padding: 0;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: #526169;
  font-size: 16px;
  flex: 0 0 auto;
}

.aggregate-customer-head-actions {
  display: flex;
  align-items: center;
  gap: 5px;
  flex: 0 0 auto;
}
.aggregate-round-robin-btn,
.aggregate-round-robin-next {
  height: 30px;
  padding: 0 8px;
  border-radius: 8px;
  font-size: 10.5px;
  line-height: 1;
  white-space: nowrap;
}
.aggregate-round-robin-btn {
  background: #f6f8f9;
  color: #68757c;
}
.aggregate-round-robin-btn.active {
  border-color: #59c985;
  background: #eaf8f0;
  color: #178449;
  font-weight: 800;
}
.aggregate-round-robin-next {
  border-color: #d8e1e5;
  background: #fff;
  color: #4f5d65;
}
.aggregate-round-robin-next:disabled {
  cursor: default;
  opacity: .45;
}
.aggregate-customer-filter {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
  padding: 7px 9px 6px;
  background: #fff;
  border-bottom: 1px solid #e6ecef;
}
.aggregate-customer-filter-btn {
  min-width: 0;
  height: 30px;
  padding: 0 7px;
  border: 1px solid #dce4e8;
  border-radius: 8px;
  background: #f7f9fa;
  color: #66737a;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.aggregate-customer-filter-btn span {
  display: inline-grid;
  min-width: 17px;
  height: 17px;
  margin-left: 3px;
  padding: 0 4px;
  place-items: center;
  border-radius: 9px;
  background: #e8edef;
  color: #66737a;
  font-size: 9px;
  line-height: 1;
}
.aggregate-customer-filter-btn:hover {
  background: #f1f8f4;
  border-color: #afdcc2;
}
.aggregate-customer-filter-btn.active {
  background: #e9f8ef;
  border-color: #53c77f;
  color: #178449;
  box-shadow: 0 0 0 1px rgba(47,198,109,.08) inset;
}
.aggregate-customer-filter-btn.active span {
  background: #36c972;
  color: #fff;
}

/* V1.27.206 — Personal LINE lifecycle groups. Independent from Official API. */
.aggregate-line-lifecycle-groups {
  display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:5px; padding:7px 9px 6px; background:#fff; border-bottom:1px solid #e6ecef;
}
.aggregate-line-lifecycle-groups button {
  min-width:0; min-height:28px; padding:5px 4px; border:1px solid #dce4e8; border-radius:8px; background:#f7f9fa; color:#66737a; font-size:9.5px; font-weight:800; white-space:nowrap; display:flex; align-items:center; justify-content:center; gap:3px;
}
.aggregate-line-lifecycle-groups button span {
  min-width:16px; height:16px; padding:0 4px; border-radius:999px; display:inline-grid; place-items:center; background:#e8edef; color:#66737a; font-size:8px; line-height:1; font-variant-numeric:tabular-nums;
}
.aggregate-line-lifecycle-groups button:hover { background:#f1f8f4; border-color:#afdcc2; }
.aggregate-line-lifecycle-groups button[data-line-lifecycle-group="new"] { background:#eefaf3; border-color:#bfe6cf; color:#147948; }
.aggregate-line-lifecycle-groups button[data-line-lifecycle-group="new"] span { background:#d7f1e2; color:#147948; }
.aggregate-line-lifecycle-groups button.active { background:#e5f7ed; border-color:#65c98e; color:#126f42; box-shadow:0 0 0 1px rgba(47,198,109,.06) inset; }
.aggregate-line-lifecycle-groups button.active span { background:#24b667; color:#fff; }
.aggregate-line-lifecycle-groups button[data-line-lifecycle-group="all"].active { background:#edf2f4; border-color:#aebbc2; color:#42545e; }
.aggregate-line-lifecycle-groups button[data-line-lifecycle-group="all"].active span { background:#71838c; color:#fff; }
.aggregate-customer-lifecycle-badge {
  display:inline-flex; align-items:center; padding:1px 5px; border:1px solid #cfe1e8; border-radius:999px; background:#f2f7f9; color:#55707d; font-size:8px; font-weight:800; white-space:nowrap;
}
.aggregate-customer-lifecycle-badge.new { border-color:#bfe7cf; background:#ebfaf2; color:#137c49; }
.aggregate-customer-lifecycle-badge[data-line-day-calibration]{cursor:pointer;user-select:none;}
.aggregate-customer-lifecycle-badge[data-line-day-calibration]:hover{box-shadow:0 0 0 2px rgba(47,198,109,.10);}
.customer-day-calibration-picker{position:fixed;z-index:99999;width:142px;height:32px;border:1px solid #75c995;border-radius:8px;background:#fff;color:#2d424c;font-size:12px;font-weight:700;padding:0 8px;box-shadow:0 10px 28px rgba(31,51,43,.18);outline:none;}

.aggregate-customer-search {
  padding: 8px 9px;
  background: #fff;
  border-bottom: 1px solid #e6ecef;
}
.aggregate-customer-search input {
  width: 100%;
  height: 34px;
  padding: 0 10px;
  border: 1px solid #d7e0e4;
  border-radius: 9px;
  background: #f8fafb;
  outline: none;
  color: #182126;
  font-size: 12px;
}
.aggregate-customer-search input:focus {
  border-color: #58c987;
  box-shadow: 0 0 0 2px rgba(47,198,109,.10);
  background: #fff;
}
.aggregate-customer-list {
  min-height: 0;
  overflow-y: auto;
  padding: 7px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.aggregate-customer-empty {
  margin: 14px 4px;
  padding: 22px 12px;
  border: 1px dashed #cfd9de;
  border-radius: 11px;
  background: rgba(255,255,255,.72);
  color: #7d8a92;
  text-align: center;
  font-size: 12px;
  line-height: 1.6;
}
.aggregate-customer-item {
  width: 100%;
  min-height: 72px;
  padding: 8px;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr);
  gap: 9px;
  align-items: center;
  text-align: left;
  border: 1px solid #e0e7ea;
  border-radius: 11px;
  background: #fff;
  color: inherit;
  box-shadow: 0 1px 1px rgba(20,34,42,.02);
}
.aggregate-customer-item:hover {
  background: #f5fbf7;
  border-color: #a8ddbe;
}
.aggregate-customer-item.active {
  background: #edf9f2;
  border-color: #51c67f;
  box-shadow: 0 0 0 1px rgba(47,198,109,.12) inset;
}
.aggregate-customer-item.closed-account {
  background: #f1f3f4;
  border-color: #d6dcdf;
}
.aggregate-customer-avatar {
  position: relative;
  width: 52px;
  height: 52px;
  overflow: hidden;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e7f1ec;
  border: 1px solid #d5e1db;
  color: #355748;
  font-size: 17px;
  font-weight: 800;
}
.aggregate-customer-avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}
.aggregate-customer-body {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.aggregate-customer-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6px;
}
.aggregate-customer-row.secondary { min-height: 18px; }
.aggregate-customer-row.primary {
  gap: 6px;
}
.aggregate-customer-name-line {
  min-width: 0;
  flex: 1 1 auto;
  display: flex;
  align-items: center;
  gap: 4px;
  overflow: hidden;
  white-space: nowrap;
}
.aggregate-customer-name {
  min-width: 0;
  flex: 0 1 auto;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #151b1f;
  font-size: 12.5px;
  line-height: 18px;
  font-weight: 800;
}
.aggregate-customer-time {
  flex: 0 0 auto;
  color: #909aa0;
  font-size: 9.5px;
  white-space: nowrap;
}
.aggregate-customer-account {
  min-width: 0;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 1px 5px;
  border-radius: 5px;
  background: #edf7f1;
  color: #21814f;
  font-size: 9.5px;
  line-height: 15px;
  font-weight: 700;
}
.aggregate-customer-round-robin {
  flex: 0 0 auto;
  padding: 1px 5px;
  border-radius: 8px;
  background: #fff4d9;
  color: #a06400;
  border: 1px solid #f0d590;
  font-size: 8.5px;
  line-height: 14px;
  font-weight: 800;
}
.aggregate-customer-unread {
  margin-left: auto;
  min-width: 19px;
  height: 19px;
  padding: 0 5px;
  border-radius: 10px;
  display: grid;
  place-items: center;
  background: #ef4444;
  color: #fff;
  font-size: 9.5px;
  line-height: 1;
  font-weight: 800;
}
.aggregate-customer-read {
  margin-left: auto;
  color: #9aa4aa;
  font-size: 9px;
}
.aggregate-customer-preview {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #6a767d;
  font-size: 10.5px;
  line-height: 16px;
}
.aggregate-customer-preview.me::before { content: '我：'; color: #8b969c; }

/* V1.12.3 — aggregate sidebar lists all LINE conversations and supports All / Unread / Read filters. */


/* V1.12.6 — aggregate customer actions, context removal, and avatar emphasis. */
.aggregate-customer-head-actions {
  display: flex;
  align-items: center;
  gap: 6px;
}
.aggregate-customer-restore {
  height: 28px;
  padding: 0 8px;
  border: 1px solid #d8e0e4;
  border-radius: 8px;
  background: #fff;
  color: #6f7b82;
  font-size: 11px;
  cursor: pointer;
}
.aggregate-customer-restore:hover {
  border-color: #9fcfb3;
  background: #f2faf5;
  color: #25794b;
}
.aggregate-customer-context-menu {
  position: fixed;
  z-index: 100000;
  width: 235px;
  padding: 6px;
  border: 1px solid #d8dfe3;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 12px 34px rgba(20, 32, 40, .18);
  user-select: none;
}
.aggregate-customer-context-menu button {
  width: 100%;
  height: 34px;
  padding: 0 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  text-align: left;
  font-size: 12px;
  cursor: pointer;
}
.aggregate-customer-context-menu button.danger {
  color: #c83f3f;
  font-weight: 700;
}
.aggregate-customer-context-menu button.danger:hover {
  background: #fff0f0;
}
.aggregate-customer-context-hint {
  padding: 5px 10px 3px;
  color: #8a969d;
  font-size: 10.5px;
  line-height: 1.45;
}
.aggregate-customer-avatar {
  box-shadow: 0 0 0 2px rgba(255,255,255,.9), 0 1px 3px rgba(30,45,38,.12);
}

/* V1.13.0 — aggregate direct reply + translation dock. The native LINE view
   is shortened by the main process in aggregate mode so this dock occupies a
   real, non-overlapping strip below the conversation. */
.aggregate-reply-dock {
  display: none;
  position: fixed;
  left: 310px;
  right: 0;
  bottom: 0;
  height: 196px;
  z-index: 14;
  background: #ffffff;
  border-top: 1px solid #dbe4e8;
  box-shadow: 0 -5px 18px rgba(35, 52, 60, .06);
  padding: 9px 12px 8px;
  overflow: hidden;
}
/* V1.13.1: no separate aggregate composer. Reply in LINE's native input box;
   automatic bilingual translation is injected directly into chat bubbles. */
body.aggregate-mode .aggregate-reply-dock { display: none !important; }
body.aggregate-mode .view-placeholder { bottom: 0 !important; }

.aggregate-reply-head {
  height: 38px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.aggregate-reply-contact {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 9px;
}
.aggregate-reply-avatar {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  overflow: hidden;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  background: #e8f4ee;
  color: #267a50;
  font-size: 12px;
  font-weight: 800;
}
.aggregate-reply-avatar img { width: 100%; height: 100%; display: block; object-fit: cover; }
.aggregate-reply-contact-text { min-width: 0; display: grid; gap: 1px; }
.aggregate-reply-contact-text strong {
  max-width: 420px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #172126;
  font-size: 13px;
}
.aggregate-reply-contact-text span {
  max-width: 520px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: #7d8a92;
  font-size: 10.5px;
}
.aggregate-reply-language { display: flex; align-items: center; gap: 6px; flex: 0 0 auto; }
.aggregate-reply-language select,
.aggregate-reply-language button {
  height: 30px;
  padding: 4px 8px;
  border-radius: 7px;
  border: 1px solid #d7e1e5;
  background: #fff;
  color: #47545c;
  font-size: 11px;
}
.aggregate-reply-language button:hover { background: #f2faf5; border-color: #a9ddbf; }

.aggregate-latest-translation {
  position: absolute;
  left: 12px;
  right: 12px;
  top: 45px;
  z-index: 2;
  display: flex;
  gap: 10px;
  align-items: center;
  min-height: 28px;
  padding: 5px 9px;
  border: 1px solid #d9e7de;
  border-radius: 8px;
  background: #f5fbf7;
  font-size: 10.5px;
}
.aggregate-latest-translation.hidden { display: none; }
.aggregate-latest-translation span,
.aggregate-latest-translation strong {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.aggregate-latest-translation span { flex: 1; color: #66747c; font-weight: 500; }
.aggregate-latest-translation strong { flex: 1; color: #1f6f48; }

.aggregate-reply-body {
  height: 92px;
  display: grid;
  grid-template-columns: minmax(220px, 1fr) 78px minmax(220px, 1fr);
  align-items: stretch;
  gap: 8px;
  padding-top: 4px;
}
.aggregate-reply-field { margin: 0; min-width: 0; display: grid; grid-template-rows: 17px 1fr; }
.aggregate-reply-field > span { color: #7b8991; font-size: 10px; line-height: 17px; }
.aggregate-reply-field textarea {
  width: 100%;
  height: 70px;
  resize: none;
  border: 1px solid #d7e1e5;
  border-radius: 8px;
  padding: 7px 9px;
  outline: none;
  line-height: 1.4;
  font-size: 12px;
  background: #fbfcfd;
}
.aggregate-reply-field textarea:focus { border-color: #55c681; box-shadow: 0 0 0 2px rgba(47,198,109,.10); background: #fff; }
.aggregate-reply-field.translated textarea { background: #f7fbf8; }
.aggregate-reply-translate {
  align-self: end;
  height: 70px;
  margin-bottom: 0;
  padding: 0 8px;
  border-color: #b9e3c9;
  background: #eefaf3;
  color: #17854a;
  font-size: 11px;
  font-weight: 800;
}
.aggregate-reply-translate:hover { background: #e3f7eb; }

.aggregate-reply-foot {
  height: 46px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}
.aggregate-reply-foot > span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #78868e;
  font-size: 10.5px;
}
.aggregate-reply-actions { display: flex; align-items: center; gap: 7px; flex: 0 0 auto; }
.aggregate-reply-actions button { height: 31px; padding: 5px 11px; font-size: 11px; }
.aggregate-reply-actions button:disabled,
.aggregate-reply-language button:disabled,
.aggregate-reply-language select:disabled,
.aggregate-reply-translate:disabled { opacity: .48; cursor: default; }

@media (max-width: 1050px) {
  .aggregate-reply-contact-text span { display: none; }
  .aggregate-reply-language button { max-width: 96px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .aggregate-reply-body { grid-template-columns: minmax(160px, 1fr) 66px minmax(160px, 1fr); }
}
.aggregate-reply-foot > span[data-kind="ok"] { color: #16884a; }
.aggregate-reply-foot > span[data-kind="error"] { color: #c84646; }

/* V1.14.0 — aggregate CRM integration */
.crm-grid-three {
  grid-template-columns: 1fr .65fr 1.25fr;
}
.aggregate-customer-crm-row {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 4px;
  overflow: hidden;
  white-space: nowrap;
}
.aggregate-customer-stage,
.aggregate-customer-tag {
  flex: 0 0 auto;
  max-width: 92px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 1px 5px;
  border-radius: 999px;
  font-size: 9px;
  line-height: 15px;
  font-weight: 700;
}
.aggregate-customer-stage {
  background: #eef3ff;
  color: #5369a8;
}
.aggregate-customer-tag {
  background: #f4f6f7;
  color: #64717a;
}
.aggregate-customer-context-menu button.profile {
  color: #1e754b;
}
.aggregate-customer-context-menu button.profile:hover {
  background: #eff9f3;
}
@media (max-width: 760px) {
  .crm-grid-three { grid-template-columns: 1fr; }
}

/* V1.14.4 — persistent right-side customer CRM panel in both LINE and aggregate modes. */
.aggregate-crm-panel {
  display: flex;
  flex-direction: column;
  position: fixed;
  top: var(--topbar-height);
  right: 0;
  bottom: 0;
  width: 352px;
  background: #fff;
  border-left: 1px solid #dce5e9;
  z-index: 12;
  overflow: hidden;
}
body .view-placeholder {
  right: 352px !important;
}
.aggregate-crm-panel-head {
  min-height: 72px;
  padding: 10px 12px;
  border-bottom: 1px solid #e4eaed;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #fbfcfc;
}
.aggregate-crm-panel-identity {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10px;
}
.aggregate-crm-panel-identity > div {
  min-width: 0;
  display: grid;
  gap: 3px;
}
.aggregate-crm-panel-identity strong {
  display: block;
  max-width: 190px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 14px;
}
.aggregate-crm-panel-identity span:not(.aggregate-crm-panel-avatar) {
  display: block;
  max-width: 190px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #7a8891;
  font-size: 10.5px;
}
.aggregate-crm-panel-avatar {
  position: relative;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  border-radius: 50%;
  overflow: hidden;
  display: grid;
  place-items: center;
  background: #e8f4ee;
  color: #2c7d55;
  font-weight: 800;
  border: 1px solid #d7e7df;
}
.aggregate-crm-panel-avatar img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.aggregate-crm-save-state {
  flex: 0 0 auto;
  padding: 3px 7px;
  border-radius: 999px;
  background: #f0f3f5;
  color: #7a8790;
  font-size: 9.5px;
  white-space: nowrap;
}
.aggregate-crm-save-state[data-kind="ok"] {
  background: #eaf8f0;
  color: #17864a;
}
.aggregate-crm-save-state[data-kind="error"] {
  background: #fff0f0;
  color: #bd3e3e;
}
.aggregate-crm-panel-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  padding: 12px;
  display: grid;
  align-content: start;
  gap: 10px;
}
.aggregate-crm-field {
  display: grid;
  gap: 5px;
  color: #5f6d76;
  font-size: 11px;
  font-weight: 700;
}
.aggregate-crm-field input,
.aggregate-crm-field select,
.aggregate-crm-field textarea {
  width: 100%;
  min-width: 0;
  border: 1px solid #d6e0e4;
  border-radius: 7px;
  background: #fff;
  color: #26343d;
  padding: 8px 9px;
  outline: none;
  font-size: 12px;
  font-weight: 400;
}
.aggregate-crm-field input:focus,
.aggregate-crm-field select:focus,
.aggregate-crm-field textarea:focus {
  border-color: #5bc888;
  box-shadow: 0 0 0 2px rgba(47, 198, 109, .10);
}
.aggregate-crm-field textarea {
  resize: vertical;
  min-height: 128px;
  line-height: 1.5;
}
.aggregate-crm-two {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 92px;
  gap: 8px;
}
.aggregate-crm-note { min-height: 0; }
.aggregate-crm-panel-foot {
  flex: 0 0 auto;
  min-height: 50px;
  padding: 8px 12px;
  border-top: 1px solid #e4eaed;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #fbfcfc;
}
.aggregate-crm-panel-foot span {
  color: #89959d;
  font-size: 10px;
}
.aggregate-crm-panel-foot button {
  padding: 7px 11px;
  font-size: 11px;
}
.aggregate-crm-panel input:disabled,
.aggregate-crm-panel select:disabled,
.aggregate-crm-panel textarea:disabled,
.aggregate-crm-panel button:disabled {
  opacity: .55;
  cursor: default;
}

/* V1.14.8 — show CRM stage and up to two tags inline beside the customer name. */
.aggregate-customer-name-line .aggregate-customer-stage,
.aggregate-customer-name-line .aggregate-customer-tag {
  max-width: 64px;
  padding: 0 4px;
  line-height: 15px;
  font-size: 8.5px;
}
.aggregate-customer-name-line .aggregate-customer-stage {
  background: #eef3ff;
  color: #5369a8;
}
.aggregate-customer-name-line .aggregate-customer-tag {
  background: #f4f6f7;
  color: #64717a;
}

/* V1.15.2 — responsive workspace + low-spec rendering path. */
:root {
  --aggregate-sidebar-width: 310px;
  --crm-panel-width: 352px;
}

body.aggregate-mode { --account-sidebar-width: var(--aggregate-sidebar-width) !important; }
body.aggregate-mode .leftbar { width: var(--aggregate-sidebar-width) !important; }
body.aggregate-mode .view-placeholder { left: var(--aggregate-sidebar-width) !important; }

.aggregate-crm-panel { width: var(--crm-panel-width) !important; }
body .view-placeholder { right: var(--crm-panel-width) !important; }

.aggregate-crm-panel-head-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6px;
}
.aggregate-crm-collapse-btn {
  width: 28px;
  height: 28px;
  padding: 0;
  display: grid;
  place-items: center;
  border-radius: 7px;
  color: #66757e;
  font-size: 20px;
  line-height: 1;
}
.aggregate-crm-collapse-btn:hover { background: #f1f7f4; color: #238454; }
/* V1.23.26: one persistent edge handle stays clickable even after the CRM panel
   is collapsed. The old in-panel arrow is hidden to avoid two arrows. */
#crmSideCollapseBtn { display:none !important; }
.aggregate-crm-edge-toggle {
  position:fixed;
  top:calc(var(--topbar-height) + 10px);
  right:8px;
  z-index:34;
  width:30px;
  height:30px;
  padding:0;
  display:grid;
  place-items:center;
  border:1px solid #d7e2e6;
  border-radius:8px;
  background:#fff;
  color:#62717a;
  box-shadow:0 1px 4px rgba(26,44,54,.10);
  font-size:21px;
  line-height:1;
}
.aggregate-crm-edge-toggle:hover { background:#f1f7f4; color:#238454; border-color:#bfe0cd; }
body:not(.shell-line) .aggregate-crm-edge-toggle { display:none !important; }
body.crm-panel-collapsed .aggregate-crm-edge-toggle { right:8px; }
body.crm-panel-collapsed .aggregate-crm-panel { display: none !important; }
body.crm-panel-collapsed .view-placeholder { right: 42px !important; }

/* V1.15.32: normal customer queues use ordinary layout so list
   shrink/filter operations cannot retain stale virtual geometry. Heavy paint
   containment is enabled only when the live list is genuinely large. */
.aggregate-customer-item {
  flex: 0 0 auto;
  content-visibility: visible;
  contain: none;
}
.aggregate-customer-list.large-list .aggregate-customer-item {
  content-visibility: auto;
  contain-intrinsic-size: 72px;
  contain: layout style paint;
}

/* Slightly denser layout on common 1366×768 / 1280×720 machines so neither
   the customer rail nor the CRM panel steals too much of the actual chat. */
body.layout-compact .aggregate-customer-list { padding: 5px; gap: 4px; }
body.layout-compact .aggregate-customer-item {
  min-height: 64px;
  grid-template-columns: 44px minmax(0, 1fr);
  gap: 7px;
  padding: 6px 7px;
}
body.layout-compact .aggregate-customer-avatar {
  width: 44px;
  height: 44px;
  font-size: 15px;
}
body.layout-compact .aggregate-customer-name { font-size: 12px; }
body.layout-compact .aggregate-customer-name-line .aggregate-customer-stage,
body.layout-compact .aggregate-customer-name-line .aggregate-customer-tag {
  max-width: 52px;
  font-size: 8px;
  padding: 0 3px;
}
body.layout-compact .aggregate-customer-preview { font-size: 10px; }
body.layout-compact .aggregate-crm-panel-body { padding: 9px; gap: 8px; }
body.layout-compact .aggregate-crm-panel-head { min-height: 64px; padding: 8px 9px; }
body.layout-compact .aggregate-crm-panel-avatar { width: 36px; height: 36px; flex-basis: 36px; }
body.layout-compact .aggregate-crm-field input,
body.layout-compact .aggregate-crm-field select,
body.layout-compact .aggregate-crm-field textarea { padding: 7px 8px; font-size: 11.5px; }
body.layout-compact .aggregate-crm-two { grid-template-columns: minmax(0, 1fr) 76px; gap: 6px; }
body.layout-compact .aggregate-crm-field textarea { min-height: 92px; }
body.layout-compact .aggregate-crm-panel-foot { min-height: 44px; padding: 6px 9px; }

@media (max-width: 1180px) {
  .status { max-width: 220px; }
  .aggregate-customer-name-line .aggregate-customer-tag:nth-of-type(n+3) { display: none; }
}


/* V1.15.4 — stable round-robin reply queue for aggregate mode. */
@media (max-width: 1366px) {
  .aggregate-round-robin-next { padding: 0 6px; font-size: 9.5px; }
  .aggregate-round-robin-btn { padding: 0 6px; font-size: 9.5px; }
}


/* V1.15.5 — compact aggregate sidebar controls must never be clipped.
   On narrower app windows the title stays on row one and all customer actions
   move to a fixed four-column row inside the sidebar. */
@media (max-width: 1500px) {
  body.aggregate-mode .aggregate-customer-head {
    min-height: 82px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    align-items: stretch;
    gap: 6px;
    padding: 7px 8px;
    overflow: visible;
  }
  body.aggregate-mode .aggregate-customer-title {
    width: 100%;
    min-width: 0;
  }
  body.aggregate-mode .aggregate-customer-title span {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  body.aggregate-mode .aggregate-customer-head-actions {
    width: 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, .95fr) minmax(0, 1.1fr) 32px;
    gap: 4px;
  }
  body.aggregate-mode .aggregate-round-robin-btn,
  body.aggregate-mode .aggregate-round-robin-next,
  body.aggregate-mode .aggregate-customer-restore,
  body.aggregate-mode .aggregate-customer-refresh {
    width: auto;
    min-width: 0;
    max-width: 100%;
    height: 30px;
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 9.5px;
  }
}

@media (max-width: 1120px) {
  body.aggregate-mode .aggregate-customer-head-actions {
    grid-template-columns: minmax(0, 1fr) minmax(0, .86fr) minmax(0, 1fr) 30px;
    gap: 3px;
  }
  body.aggregate-mode .aggregate-round-robin-btn,
  body.aggregate-mode .aggregate-round-robin-next,
  body.aggregate-mode .aggregate-customer-restore {
    font-size: 9px;
    padding-left: 2px;
    padding-right: 2px;
  }
}

/* V1.15.21 — aggregate operations, service status and health badges */
.aggregate-ops-summary {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 5px;
  padding: 7px 8px 8px;
  border-bottom: 1px solid #e6ecef;
  background: #fbfcfd;
}
.aggregate-ops-summary > span {
  min-width: 0;
  padding: 5px 3px;
  border: 1px solid #e4eaed;
  border-radius: 8px;
  background: #fff;
  text-align: center;
}
.aggregate-ops-summary strong {
  display: block;
  overflow: hidden;
  color: #26343d;
  font-size: 12px;
  line-height: 15px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.aggregate-ops-summary small {
  display: block;
  margin-top: 1px;
  color: #7b8790;
  font-size: 8.5px;
  line-height: 12px;
}
.aggregate-customer-service-status {
  flex: 0 0 auto;
  padding: 1px 5px;
  border-radius: 999px;
  font-size: 9px;
  line-height: 15px;
  font-weight: 700;
  white-space: nowrap;
}
.aggregate-customer-service-status.waiting { background: #fff2dc; color: #a45b00; }
.aggregate-customer-service-status.active { background: #e9f3ff; color: #2f6fa8; }
.aggregate-customer-service-status.done { background: #eaf8f0; color: #17864a; }
.aggregate-customer-service-status.paused { background: #f2f4f5; color: #68737a; }
.aggregate-customer-service-status.blacklist { background: #fff0f0; color: #bd3e3e; }
.aggregate-crm-quick-summary {
  display: grid;
  gap: 3px;
  padding: 8px 9px;
  border: 1px solid #dfe8e3;
  border-radius: 8px;
  background: #f7fbf8;
}
.aggregate-crm-quick-summary strong { color: #2d5b43; font-size: 11px; }
.aggregate-crm-quick-summary span { color: #68767e; font-size: 10.5px; line-height: 1.45; white-space: normal; }
.account-window-status.health-online { color: #168c4a; background: #eefaf3; }
.account-window-status.health-loading { color: #8a6800; background: #fff8df; }
.account-window-status.health-login { color:#a85d00; background:#fff1d6; }
.account-window-status.health-error { color: #bd3e3e; background: #fff0f0; }
.account-window-status.health-closed { color: #59636a; background: #f2f4f5; }
.account.health-error { box-shadow: inset 3px 0 0 rgba(207,72,72,.65); }
@media (max-width: 1400px) {
  .aggregate-ops-summary { gap: 3px; padding-left: 6px; padding-right: 6px; }
  .aggregate-ops-summary > span { padding-left: 2px; padding-right: 2px; }
  .aggregate-ops-summary strong { font-size: 11px; }
  .aggregate-ops-summary small { font-size: 8px; }
}


/* V1.15.22 — lightweight runtime performance indicator */
.performance-status {
  flex: 0 0 auto;
  min-width: 112px;
  max-width: 190px;
  padding: 5px 8px;
  border: 1px solid #d8e1e5;
  border-radius: 7px;
  background: #f7fafb;
  color: #52616a;
  font-size: 11px;
  line-height: 1.25;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.performance-status.warn { color: #8a6800; background: #fff8df; border-color: #ecd98e; }
.performance-status.hot { color: #b53a3a; background: #fff0f0; border-color: #efc1c1; }
.performance-status { cursor:pointer; font-family:inherit; text-align:left; }
.performance-status:hover { background:#eef5f7; border-color:#bfd0d7; }
.performance-status:focus-visible { outline:2px solid #8ab8c8; outline-offset:2px; }

/* V1.27.218 performance diagnostics */
.performance-diagnostics-card { width:min(1120px,96vw); max-height:92vh; overflow:auto; }
.performance-diagnostics-toolbar { display:flex; align-items:center; gap:8px; padding:8px 0 10px; border-bottom:1px solid #e7edef; }
.performance-diag-badge { display:inline-flex; align-items:center; min-height:28px; padding:0 10px; border-radius:999px; border:1px solid #d9e2e6; background:#f6f9fa; color:#65747c; font-size:12px; font-weight:700; }
.performance-diag-badge.ok { background:#edf9f1; border-color:#b9dfc7; color:#267347; }
.performance-diag-badge.warn { background:#fff8df; border-color:#ecd98e; color:#8a6800; }
.performance-diag-badge.hot { background:#fff0f0; border-color:#efc1c1; color:#b53a3a; }
.performance-diag-summary { display:grid; grid-template-columns:repeat(6,minmax(0,1fr)); gap:8px; margin:12px 0; }
.performance-diag-summary > div { min-width:0; border:1px solid #dfe8ec; border-radius:10px; background:#f8fbfc; padding:10px; display:flex; flex-direction:column; gap:3px; }
.performance-diag-summary span { color:#70808a; font-size:11px; }
.performance-diag-summary strong { color:#24323a; font-size:18px; line-height:1.2; }
.performance-diag-summary small { color:#8a969d; font-size:10px; line-height:1.35; white-space:normal; }
.performance-diag-section-head { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin:12px 0 7px; }
.performance-diag-section-head strong { font-size:13px; color:#26343b; }
.performance-diag-section-head small { font-size:10px; color:#849198; text-align:right; }
.performance-process-table-wrap { border:1px solid #dfe8ec; border-radius:10px; overflow:auto; max-height:330px; }
.performance-process-table { width:100%; border-collapse:collapse; font-size:11px; }
.performance-process-table th { position:sticky; top:0; z-index:1; background:#f4f8f9; color:#61717a; font-weight:700; text-align:left; padding:8px 9px; border-bottom:1px solid #dfe8ec; }
.performance-process-table td { padding:8px 9px; border-bottom:1px solid #edf1f3; color:#34434b; vertical-align:middle; }
.performance-process-table tr:last-child td { border-bottom:0; }
.performance-process-table tr.active td:first-child { box-shadow:inset 3px 0 0 #4e9b6d; }
.performance-process-table tr.warn { background:#fffaf0; }
.performance-process-table tr.hot { background:#fff3f3; }
.performance-process-name { display:flex; flex-direction:column; gap:2px; }
.performance-process-name strong { font-size:11px; color:#26343b; }
.performance-process-name small { font-size:9px; color:#8b969c; }
.performance-diag-lower-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px; }
.performance-diag-keylist { display:grid; gap:6px; }
.performance-diag-keylist > div { display:flex; align-items:center; justify-content:space-between; gap:10px; min-height:34px; padding:7px 9px; border:1px solid #e2e9ec; border-radius:8px; background:#fafcfd; }
.performance-diag-keylist span { font-size:11px; color:#65747c; }
.performance-diag-keylist strong { font-size:11px; color:#2f3d44; text-align:right; }
.performance-diag-advice { display:grid; gap:6px; }
.performance-diag-advice > div { padding:8px 10px; border-radius:8px; border:1px solid #dfe7ea; background:#f8fafb; color:#4d5b62; font-size:11px; line-height:1.5; }
.performance-diag-advice > div.ok { background:#f0f8f3; border-color:#cce5d5; color:#377151; }
.performance-diag-advice > div.warn { background:#fff9e7; border-color:#efdfaa; color:#7d671e; }
.performance-diag-advice > div.hot { background:#fff1f1; border-color:#efc8c8; color:#a34242; }
.performance-diag-raw { margin-top:12px; border:1px solid #e0e7ea; border-radius:9px; background:#fafcfd; }
.performance-diag-raw summary { cursor:pointer; padding:8px 10px; font-size:11px; color:#5f6e76; }
.performance-diag-raw pre { margin:0; padding:10px; max-height:260px; overflow:auto; border-top:1px solid #e7edef; font:10px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace; white-space:pre-wrap; word-break:break-word; }
@media (max-width:1180px){ .performance-diag-summary{grid-template-columns:repeat(3,minmax(0,1fr));} }
@media (max-width:760px){ .performance-diag-summary{grid-template-columns:repeat(2,minmax(0,1fr));} .performance-diag-lower-grid{grid-template-columns:1fr;} }
@media (max-width: 1450px) {
  .performance-status { min-width: 88px; max-width: 120px; }
}

/* Large-list-only virtualization. Small/filtered queues stay fully laid out. */
.aggregate-customer-list.large-list .aggregate-customer-item {
  content-visibility: auto;
  contain-intrinsic-size: 76px;
}
body.layout-compact .aggregate-customer-list.large-list .aggregate-customer-item {
  contain-intrinsic-size: 64px;
}

/* V1.15.23 operations center */
.ops-card { width: min(860px, 94vw); }
.ops-subtitle { margin: 3px 0 0; font-size: 12px; color: #7a8992; }
.ops-summary-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; margin: 8px 0 12px; }
.ops-summary-grid > div { border: 1px solid #dfe8ec; border-radius: 12px; padding: 11px 12px; background: #f8fbfc; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
.ops-summary-grid span { font-size: 12px; color: #71818a; }
.ops-summary-grid strong { font-size: 20px; color: #20343f; }
.ops-toolbar { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 6px; }
.ops-health-head { display: flex; align-items: center; justify-content: space-between; margin: 16px 0 8px; }
.ops-health-head span { color: #80909a; font-size: 12px; }
.ops-health-list { display: grid; gap: 8px; max-height: 48vh; overflow: auto; padding-right: 2px; }
.ops-health-empty { padding: 18px; text-align: center; color: #82919a; background: #f8fbfc; border: 1px dashed #d7e2e7; border-radius: 10px; }
.ops-health-row { display: grid; grid-template-columns: minmax(150px, 1.25fr) minmax(110px, .9fr) minmax(110px, .8fr) minmax(120px, 1fr) auto; align-items: center; gap: 10px; border: 1px solid #dfe7eb; border-radius: 11px; padding: 10px 11px; background: #fff; }
.ops-health-row.problem { border-color: #f1c9c3; background: #fff9f8; }
.ops-health-row.pending { border-color: #e8d7a8; background: #fffdf5; }
.ops-health-name { min-width: 0; }
.ops-health-name strong { display: block; color: #21343e; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ops-health-name small, .ops-health-meta small { display: block; color: #83929a; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ops-health-status { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; }
.ops-health-status::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #9eabb1; }
.ops-health-status.online::before { background: #27a96b; }
.ops-health-status.loading::before, .ops-health-status.starting::before { background: #d7a52f; }
.ops-health-status.error::before, .ops-health-status.unresponsive::before, .ops-health-status.offline::before { background: #db5a4d; }
.ops-health-status.closed::before { background: #a7b1b6; }
.ops-health-memory { font-size: 12px; color: #4f626c; }
.ops-health-action { white-space: nowrap; }
.ops-health-action button { padding: 7px 10px; }
@media (max-width: 1250px) {
  .ops-health-row { grid-template-columns: minmax(150px, 1.3fr) minmax(100px, .8fr) minmax(95px, .7fr) auto; }
  .ops-health-row .ops-health-network { display: none; }
}

.ops-monitor-only { color: #8a969d; font-size: 12px; white-space: nowrap; }


/* V1.15.25 — fixed two-row header: important workspace controls stay on row 1,
   management actions stay on row 2 instead of overflowing one very wide line. */
@media (max-width: 1280px) {
  .topbar-action-row button { padding-left: 9px; padding-right: 9px; font-size: 12px; }
  .topbar-primary-row .status { max-width: 300px; }
}
@media (max-width: 980px) {
  .topbar-primary-row .performance-status { display: none; }
  .topbar-primary-row .status { max-width: 230px; }
  .topbar-action-row { gap: 5px; }
  .topbar-action-row button { padding-left: 7px; padding-right: 7px; font-size: 11px; }
}

/* V1.16.0 aggregate productivity additions. These are shell-only and do not
   alter LINE's authenticated renderer or Letter Sealing initialization. */
body.aggregate-mode .aggregate-smart-controls,
body.aggregate-mode .aggregate-account-stats {
  flex: 0 0 auto;
}
.aggregate-smart-controls {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
  gap: 5px;
  padding: 6px 8px;
  background: #fff;
  border-bottom: 1px solid #e6ecef;
}
.aggregate-smart-controls select,
.aggregate-smart-controls button {
  min-width: 0;
  height: 30px;
  border: 1px solid #d6e0e4;
  border-radius: 8px;
  background: #f8fafb;
  color: #34444d;
  font-size: 10.5px;
  padding: 0 7px;
}
.aggregate-smart-controls button { white-space: nowrap; }
.aggregate-smart-controls select:focus,
.aggregate-smart-controls button:focus { outline: 2px solid rgba(47,198,109,.16); border-color: #59c988; }
.aggregate-notification-badge {
  display: inline-grid;
  place-items: center;
  min-width: 16px;
  height: 16px;
  padding: 0 4px;
  margin-left: 2px;
  border-radius: 999px;
  background: #ff5b62;
  color: #fff;
  font-size: 9px;
  font-weight: 800;
}
.aggregate-notification-badge.hidden { display: none; }
.aggregate-account-stats {
  display: flex;
  gap: 5px;
  padding: 5px 8px 6px;
  overflow-x: auto;
  overflow-y: hidden;
  background: #f7f9fa;
  border-bottom: 1px solid #e5ebee;
  scrollbar-width: thin;
}
.aggregate-account-stat {
  flex: 0 0 auto;
  max-width: 210px;
  display: grid;
  grid-template-columns: auto minmax(0,1fr);
  grid-template-areas: "dot title" "dot meta";
  column-gap: 5px;
  align-items: center;
  padding: 5px 7px;
  border: 1px solid #dce5e8;
  border-radius: 9px;
  background: #fff;
  text-align: left;
}
.aggregate-account-stat:hover { border-color: #8ed8aa; background: #f4fbf7; }
.aggregate-account-stat.active { border-color: #39bf70; background: #eaf8f0; }
.aggregate-account-dot { grid-area: dot; width: 7px; height: 7px; border-radius: 50%; background: #aab5ba; }
.aggregate-account-dot.online { background: #30c56d; box-shadow: 0 0 0 2px rgba(48,197,109,.12); }
.aggregate-account-stat strong { grid-area: title; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 10px; color: #2e3e46; }
.aggregate-account-stat small { grid-area: meta; white-space: nowrap; font-size: 8.5px; color: #7a888f; }
.aggregate-account-stats-empty { color: #8a969c; font-size: 10px; padding: 4px; }
.aggregate-customer-item.pinned { border-color: #dfc464; background: #fffdf4; }
.aggregate-customer-item.pinned.active { border-color: #42c77a; background: #edf9f2; }
.aggregate-customer-pin { color: #d3a514; font-size: 11px; line-height: 1; }
.aggregate-customer-date-group {
  padding: 1px 4px;
  border-radius: 5px;
  background: #eef3f5;
  color: #738188;
  font-size: 8.5px;
}
.aggregate-customer-context-menu button.pin { color: #886b10; }
.aggregate-customer-context-menu button.pin:hover { background: #fff8db; }
.aggregate-crm-timeline {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin: 8px 0 10px;
}
.aggregate-crm-timeline > div {
  min-width: 0;
  padding: 7px 8px;
  border: 1px solid #e1e8e4;
  border-radius: 8px;
  background: #fafcfb;
}
.aggregate-crm-timeline span,
.aggregate-crm-timeline strong { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.aggregate-crm-timeline span { color: #829089; font-size: 9px; margin-bottom: 2px; }
.aggregate-crm-timeline strong { color: #3d5a4b; font-size: 10px; font-weight: 700; }
.aggregate-notification-card { width: min(620px, 92vw); }
.aggregate-notification-toolbar { display: flex; gap: 8px; margin: 10px 0; }
.aggregate-notification-list { display: flex; flex-direction: column; gap: 7px; max-height: 60vh; overflow-y: auto; }
.aggregate-notification-item {
  width: 100%;
  display: grid;
  gap: 5px;
  padding: 10px 11px;
  border: 1px solid #dfe6e9;
  border-radius: 10px;
  background: #fff;
  color: #34434b;
  text-align: left;
}
.aggregate-notification-item.unread { border-color: #75d29a; background: #f0faf4; box-shadow: inset 3px 0 0 #35c673; }
.aggregate-notification-item:hover { background: #f7fbf9; }
.aggregate-notification-head { display: flex; justify-content: space-between; gap: 10px; align-items: center; }
.aggregate-notification-head strong { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.aggregate-notification-head small { flex: 0 0 auto; color: #87939a; }
.aggregate-notification-item > span:last-child { color: #66757d; font-size: 11px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.aggregate-notification-empty { padding: 28px 12px; text-align: center; color: #8b979d; }

@media (max-width: 1100px) {
  .aggregate-smart-controls { grid-template-columns: 1fr 1fr; }
  .aggregate-smart-controls #aggregateNotificationBtn { grid-column: 1 / -1; }
}
.aggregate-customer-item.active {
  box-shadow: inset 4px 0 0 #31bf6d, 0 0 0 1px rgba(47,198,109,.10);
}


/* V1.20.0 App Center ------------------------------------------------------ */
.app-center-top-btn {
  border-color: #d5dde4;
  background: #ffffff;
  font-weight: 700;
}
.app-center-top-btn.active { background:#152433; color:#fff; border-color:#152433; }
.app-center-page {
  position: fixed;
  z-index: 30;
  left: 0;
  right: 0;
  top: 92px;
  bottom: 0;
  display: grid;
  grid-template-columns: 72px minmax(0,1fr);
  background: #eef2f5;
}
.app-center-page.hidden { display:none; }
.app-center-rail {
  background: #182536;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:8px;
  padding:14px 8px 10px;
  overflow-y:auto;
}
.app-rail-item, .app-rail-platform {
  width:52px;
  min-height:52px;
  border:0;
  border-radius:12px;
  background:transparent;
  color:#dce7ef;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:2px;
  padding:5px;
}
.app-rail-item:hover, .app-rail-platform:hover, .app-rail-item.active { background:rgba(255,255,255,.12); color:#fff; }
.app-rail-item span { font-size:22px; line-height:1; }
.app-rail-item small { font-size:10px; }
.app-rail-platform span {
  width:36px; height:36px; display:grid; place-items:center; border-radius:50%;
  background:#fff; color:#1f2933; font-size:11px; font-weight:800;
}
.app-rail-platform[data-app-rail-platform="facebook"] span { background:#1877f2; color:#fff; font-size:22px; }
.app-rail-platform[data-app-rail-platform="instagram"] span { background:#d62976; color:#fff; }
.app-rail-platform[data-app-rail-platform="whatsapp"] span { background:#25d366; color:#fff; }
.app-rail-platform[data-app-rail-platform="telegram"] span { background:#2aabee; color:#fff; }
.app-rail-platform[data-app-rail-platform="tiktok"] span { background:#111; color:#fff; }
.app-rail-platform[data-app-rail-platform="metabusiness"] span { background:#0668e1; color:#fff; }
.app-rail-separator { width:38px; height:1px; background:rgba(255,255,255,.14); margin:2px 0 4px; }
.app-rail-spacer { flex:1; }
.app-center-content { min-width:0; overflow:auto; padding:28px 32px 40px; }
.app-center-pane { max-width:1280px; margin:0 auto; }
.app-center-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:24px; }
.app-center-heading h1 { margin:0 0 6px; font-size:26px; color:#172331; }
.app-center-heading p { margin:0; color:#708090; max-width:760px; line-height:1.6; }
.app-center-heading button { white-space:nowrap; }
.app-dashboard-cards { display:grid; grid-template-columns:repeat(4,minmax(140px,1fr)); gap:14px; margin-bottom:22px; }
.app-dashboard-cards article { background:#fff; border:1px solid #dfe6eb; border-radius:14px; padding:20px; box-shadow:0 2px 8px rgba(31,45,61,.04); }
.app-dashboard-cards strong { display:block; font-size:28px; color:#102538; margin-bottom:4px; }
.app-dashboard-cards span { color:#758493; font-size:13px; }
.app-dashboard-panel { background:#fff; border:1px solid #dfe6eb; border-radius:14px; padding:18px; }
.app-dashboard-panel h2 { margin:0 0 12px; font-size:17px; }
.app-dashboard-platform-list { display:grid; gap:8px; }
.app-dashboard-platform-row { display:grid; grid-template-columns:44px minmax(0,1fr) auto 18px; align-items:center; gap:12px; padding:11px 12px; background:#f8fafb; border:1px solid #e5eaee; border-radius:10px; text-align:left; }
.app-dashboard-platform-row:hover { background:#f1f7fb; border-color:#cbdbe5; }
.app-dashboard-platform-icon, .app-account-avatar { width:36px; height:36px; border-radius:50%; display:grid; place-items:center; font-weight:800; font-size:11px; background:#e9eef2; color:#263746; }
.app-dashboard-platform-name strong, .app-account-name strong { display:block; color:#1c2d3b; }
.app-dashboard-platform-name small, .app-account-name small { display:block; color:#81909d; margin-top:2px; }
.app-dashboard-platform-status { color:#607380; font-size:12px; }
.app-center-grid { display:grid; grid-template-columns:repeat(3,minmax(280px,1fr)); gap:16px; }
.app-card { background:#fff; border:1px solid #dfe5ea; border-radius:14px; padding:20px; display:grid; grid-template-columns:58px minmax(0,1fr); grid-template-rows:auto auto; column-gap:15px; row-gap:15px; box-shadow:0 3px 10px rgba(30,45,60,.04); }
.app-card:hover { border-color:#bdcbd5; box-shadow:0 8px 20px rgba(30,45,60,.07); }
.app-card-icon { grid-row:1; }
.app-card-icon span { width:52px; height:52px; border-radius:50%; display:grid; place-items:center; font-weight:900; font-size:12px; background:#edf2f5; color:#273746; }
.platform-line .app-card-icon span, .platform-line.app-dashboard-platform-icon { background:#06c755; color:#fff; font-size:10px; }
.platform-metabusiness .app-card-icon span, .platform-metabusiness.app-dashboard-platform-icon, .platform-metabusiness.app-account-avatar { background:#0668e1; color:#fff; }
.platform-facebook .app-card-icon span, .platform-facebook.app-dashboard-platform-icon, .platform-facebook.app-account-avatar { background:#1877f2; color:#fff; font-size:22px; }
.platform-instagram .app-card-icon span, .platform-instagram.app-dashboard-platform-icon, .platform-instagram.app-account-avatar { background:#d62976; color:#fff; }
.platform-whatsapp .app-card-icon span, .platform-whatsapp.app-dashboard-platform-icon, .platform-whatsapp.app-account-avatar { background:#25d366; color:#fff; }
.platform-telegram .app-card-icon span, .platform-telegram.app-dashboard-platform-icon, .platform-telegram.app-account-avatar { background:#2aabee; color:#fff; }
.platform-tiktok .app-card-icon span, .platform-tiktok.app-dashboard-platform-icon, .platform-tiktok.app-account-avatar { background:#111; color:#fff; }
.app-card-copy { min-width:0; }
.app-card-title { display:flex; align-items:center; justify-content:space-between; gap:8px; }
.app-card-title strong { font-size:17px; color:#172b3a; }
.app-card-title span { font-size:11px; background:#edf7ef; color:#248a42; border-radius:999px; padding:3px 8px; }
.app-card-copy p { color:#687986; font-size:13px; line-height:1.5; min-height:40px; margin:8px 0; }
.app-card-copy small { color:#8796a2; }
.app-card-actions { grid-column:1 / -1; display:flex; justify-content:flex-end; gap:8px; border-top:1px solid #edf0f2; padding-top:13px; }
.app-card-actions button:first-child { background:#182b3d; color:#fff; border-color:#182b3d; }
.app-account-card { width:min(780px,calc(100vw - 40px)); }
.app-account-modal-meta { margin:3px 0 0; color:#84919b; font-size:12px; }
.app-account-create-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; padding:12px 0 16px; }
.app-account-list { display:grid; gap:9px; max-height:450px; overflow:auto; }
.app-account-row { display:grid; grid-template-columns:24px 42px minmax(0,1fr) auto; gap:9px; align-items:center; border:1px solid #e1e7eb; background:#f9fbfc; border-radius:10px; padding:10px 12px; }
.app-account-row-actions { display:flex; gap:6px; }
.app-account-row-actions .danger { color:#b43d3d; }
.app-account-empty { padding:32px 16px; text-align:center; color:#7a8893; border:1px dashed #ccd6dc; border-radius:10px; }
@media (max-width: 1180px) {
  .app-center-grid { grid-template-columns:repeat(2,minmax(260px,1fr)); }
  .app-dashboard-cards { grid-template-columns:repeat(2,minmax(140px,1fr)); }
}
@media (max-width: 820px) {
  .app-center-page { grid-template-columns:62px minmax(0,1fr); }
  .app-center-content { padding:20px 16px 32px; }
  .app-center-grid { grid-template-columns:1fr; }
}

/* V1.20.1 persistent multi-app shell ------------------------------------- */
:root {
  --global-app-rail-width: 62px;
  --external-account-sidebar-width: 228px;
  --external-toolbar-height: 92px;
}

.global-app-rail {
  position: fixed;
  z-index: 70;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--global-app-rail-width);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  padding: 10px 6px 8px;
  background: #f8fafb;
  border-right: 1px solid #dbe3e8;
  box-shadow: 1px 0 0 rgba(19,35,48,.02);
}
.global-app-rail-btn,
.global-app-platform-btn {
  position: relative;
  width: 48px;
  min-height: 48px;
  padding: 4px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #60707b;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
}
.global-app-rail-btn:hover,
.global-app-platform-btn:hover { background: #edf3f6; }
.global-app-rail-btn.active,
.global-app-platform-btn.active { background: #e7f6ee; color: #159252; }
.global-app-rail-btn > span { font-size: 21px; line-height: 1; }
.global-app-rail-btn small { font-size: 9px; line-height: 1.1; }
.global-app-platform-btn > span {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 10px;
  font-weight: 900;
  background: #dfe6ea;
  color: #273846;
}
.global-app-platform-btn.platform-line > span { background:#06c755; color:#fff; font-size:8px; }
.global-app-platform-btn.platform-metabusiness > span { background:#0668e1; color:#fff; }
.global-app-platform-btn.platform-facebook > span { background:#1877f2; color:#fff; font-size:18px; }
.global-app-platform-btn.platform-instagram > span { background:#d62976; color:#fff; }
.global-app-platform-btn.platform-whatsapp > span { background:#25d366; color:#fff; }
.global-app-platform-btn.platform-telegram > span { background:#2aabee; color:#fff; }
.global-app-platform-btn.platform-tiktok > span { background:#111; color:#fff; }
.global-app-rail-separator { width: 34px; height: 1px; background: #dfe5e9; margin: 2px 0; }
.global-app-rail-spacer { flex: 1; }
.installed-app-rail { display:flex; flex-direction:column; align-items:center; gap:7px; min-height:0; overflow-y:auto; overflow-x:hidden; }
.rail-running-dot { display:none; position:absolute; right:5px; top:5px; width:7px; height:7px; border-radius:50%; background:#27c36a; box-shadow:0 0 0 2px #f8fafb; }
.global-app-platform-btn.running .rail-running-dot { display:block; }

/* LINE lives in its own surface. The global rail is not part of LINE's tools. */
.topbar { left: var(--global-app-rail-width); }
.leftbar { left: var(--global-app-rail-width); }
.view-placeholder,
.aggregate-view { left: calc(var(--global-app-rail-width) + var(--account-sidebar-width)); }
body.accounts-collapsed .aggregate-view { left: calc(var(--global-app-rail-width) + var(--account-sidebar-width)); }
body.aggregate-mode .aggregate-reply-dock { left: calc(var(--global-app-rail-width) + var(--aggregate-sidebar-width, 310px)); }

/* The old App Center top-bar button is intentionally removed from the LINE tool row. */
.app-center-top-btn { display:none !important; }

.app-center-page {
  position: fixed;
  z-index: 30;
  left: var(--global-app-rail-width);
  right: 0;
  top: 0;
  bottom: 0;
  display: block;
  background: #eef2f5;
}
.app-center-page.hidden { display:none; }
.app-center-content { height:100%; min-width:0; overflow:auto; padding:26px 28px 40px; }
.app-center-pane { max-width: 1320px; margin:0 auto; }
/* V1.23.7: Home dashboard and App Center are separate left-rail destinations. */
.app-center-pane.hidden { display:none !important; }

/* External platform surface: the website itself is a WebContentsView. This DOM
   only owns the platform toolbar + account list around that native view. */
.external-workspace-page {
  position: fixed;
  z-index: 28;
  left: var(--global-app-rail-width);
  right: 0;
  top: 0;
  bottom: 0;
  background: #eef2f5;
}
.external-workspace-page.hidden { display:none; }
.external-workspace-topbar {
  position:absolute;
  left:0;
  right:0;
  top:0;
  height:var(--external-toolbar-height);
  background:#fff;
  border-bottom:1px solid #dce4e8;
  display:grid;
  grid-template-rows:46px 45px;
  padding:0 14px;
}
.external-workspace-row { min-width:0; display:flex; align-items:center; gap:9px; }
.external-workspace-primary-row { border-bottom:1px solid #eef2f4; }
.external-workspace-action-row { overflow:hidden; justify-content:flex-end; flex-wrap:nowrap; }
.external-workspace-action-row button { flex:0 0 auto; padding-top:7px; padding-bottom:7px; }
.external-workspace-identity { display:flex; align-items:center; gap:10px; min-width:220px; }
.external-workspace-icon { width:38px; height:38px; border-radius:50%; display:grid; place-items:center; background:#dfe7eb; color:#253746; font-weight:900; font-size:11px; }
.external-workspace-identity strong { display:block; color:#182a38; font-size:16px; }
.external-workspace-title-row { display:flex; align-items:center; gap:7px; }
.external-workspace-version-badge { display:inline-flex; align-items:center; height:18px; padding:0 6px; border-radius:9px; background:#eef7f1; color:#27945b; font-size:10px; font-weight:800; white-space:nowrap; }
.external-workspace-identity small { display:block; color:#82909a; margin-top:2px; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-workspace-status { flex:0 1 360px; max-width:360px; color:#73828c; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-customer-stats { margin-left:2px; }
.external-account-sidebar {
  position:absolute;
  left:0;
  top:var(--external-toolbar-height);
  bottom:0;
  width:var(--external-account-sidebar-width);
  background:#fff;
  border-right:1px solid #dce4e8;
  overflow:hidden;
}
.external-account-sidebar-head { height:48px; padding:0 12px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid #edf1f3; }
.external-account-sidebar-head span { min-width:22px; height:22px; padding:0 6px; display:grid; place-items:center; border-radius:11px; background:#e8f8ef; color:#1d9952; font-size:11px; }
.external-account-sidebar-list { height:calc(100% - 48px); overflow:auto; padding:8px; }
.external-account-item { width:100%; display:grid; grid-template-columns:34px minmax(0,1fr) auto; align-items:center; gap:8px; padding:9px; border:1px solid transparent; border-radius:10px; background:#fff; text-align:left; margin-bottom:5px; }
.external-account-item:hover { background:#f5f9f7; }
.external-account-item.active { background:#eaf8f0; border-color:#8ed8ae; }
.external-account-avatar { width:34px; height:34px; border-radius:50%; display:grid; place-items:center; font-size:10px; font-weight:900; background:#e3e9ed; }
.external-account-copy { min-width:0; }
.external-account-copy strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#263744; font-size:12px; }
.external-account-copy small { display:block; color:#84929c; font-size:10px; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-account-dot { width:8px; height:8px; border-radius:50%; background:#c8d0d5; }
.external-account-item.open .external-account-dot { background:#28c66f; }
.external-account-empty { padding:28px 10px; text-align:center; color:#89969e; font-size:12px; line-height:1.6; }
.external-view-placeholder { position:absolute; left:var(--external-account-sidebar-width); right:0; top:var(--external-toolbar-height); bottom:0; display:grid; place-items:center; color:#9aa5ab; pointer-events:none; }
.external-view-placeholder > div { display:grid; gap:5px; text-align:center; }
.external-view-placeholder strong { color:#6e7c84; }

/* Only the current surface is visible. Modals stay available on every surface. */
body.shell-app-center .topbar,
body.shell-app-center .leftbar,
body.shell-app-center .aggregate-crm-panel,
body.shell-app-center .aggregate-view,
body.shell-app-center .view-placeholder,
body.shell-external .topbar,
body.shell-external .leftbar,
body.shell-external .aggregate-crm-panel,
body.shell-external .aggregate-view,
body.shell-external .view-placeholder { display:none !important; }
body.shell-line #appCenterPage,
body.shell-line #externalWorkspacePage { display:none !important; }
body.shell-app-center #externalWorkspacePage { display:none !important; }
body.shell-external #appCenterPage { display:none !important; }

.app-account-row-actions { flex-wrap:wrap; justify-content:flex-end; }
.app-account-row-actions button[data-app-account-action="proxy"] { color:#256d9b; }

.app-card-actions button[data-app-install-platform] { background:#182b3d; color:#fff; border-color:#182b3d; }
.app-card-actions button[data-app-enter-platform] { background:#182b3d; color:#fff; border-color:#182b3d; }

@media (max-width: 900px) {
  :root { --external-account-sidebar-width: 190px; }
  .external-workspace-status { display:none; }
  .external-workspace-identity { min-width:170px; }
}
.external-workspace-icon.platform-metabusiness, .external-account-avatar.platform-metabusiness { background:#0668e1; color:#fff; }
.external-workspace-icon.platform-facebook, .external-account-avatar.platform-facebook { background:#1877f2; color:#fff; }
.external-workspace-icon.platform-instagram, .external-account-avatar.platform-instagram { background:#d62976; color:#fff; }
.external-workspace-icon.platform-whatsapp, .external-account-avatar.platform-whatsapp { background:#25d366; color:#fff; }
.external-workspace-icon.platform-telegram, .external-account-avatar.platform-telegram { background:#2aabee; color:#fff; }
.external-workspace-icon.platform-tiktok, .external-account-avatar.platform-tiktok { background:#111; color:#fff; }


/* V1.21.0 TikTok independent aggregate workspace. This is deliberately scoped
   to the external TikTok surface and never reuses LINE aggregate DOM/state. */
.external-workspace-modes { display:flex; align-items:center; gap:4px; padding:3px; border:1px solid #dce4e8; border-radius:9px; background:#f4f7f8; }
.external-workspace-modes.hidden { display:none; }
.external-workspace-modes button { padding:5px 9px; border-color:transparent; background:transparent; color:#61717c; }
.external-workspace-modes button.active { background:#20b966; border-color:#20b966; color:#fff; box-shadow:0 1px 3px #0002; }
.external-workspace-page.aggregate-active { --external-account-sidebar-width:310px; }
.external-workspace-page.aggregate-active .external-account-sidebar { width:310px; }
.external-aggregate-tools { padding:8px; border-bottom:1px solid #edf1f3; display:grid; grid-template-columns:minmax(0,1fr) 100px; gap:6px; background:#fbfcfd; }
.external-aggregate-tools.hidden { display:none; }
.external-aggregate-tools input, .external-aggregate-tools select { min-width:0; width:100%; font-size:11px; padding:7px 8px; border:1px solid #d9e1e5; border-radius:8px; background:#fff; }
.external-workspace-page.aggregate-active .external-account-sidebar-list { height:calc(100% - 48px - 49px); padding:7px; }
.external-aggregate-customer { width:100%; display:grid; grid-template-columns:42px minmax(0,1fr) auto; gap:8px; align-items:center; border:1px solid transparent; border-radius:10px; background:#fff; padding:8px; margin-bottom:5px; text-align:left; position:relative; }
.external-aggregate-customer:hover { background:#f6faf8; }
.external-aggregate-customer.active { background:#eaf8f0; border-color:#82d5a6; }
.external-aggregate-customer.active::before { content:""; position:absolute; left:-1px; top:8px; bottom:8px; width:3px; border-radius:0 3px 3px 0; background:#1db866; }
.external-aggregate-customer.duplicate { border-color:#ef9a9a; background:#fff7f7; }
.external-aggregate-customer.duplicate:hover { background:#fff1f1; }
.external-aggregate-customer.duplicate.active { border-color:#e65f5f; background:#fff0f0; }
.external-aggregate-customer.duplicate.active::before { background:#df3f3f; }
.external-aggregate-duplicate-badge { display:inline-flex; align-items:center; width:max-content; margin-top:2px; padding:1px 5px; border-radius:999px; background:#ffe1e1; color:#c62828; font-size:9px; font-style:normal; font-weight:700; line-height:1.5; }
.external-aggregate-avatar { width:42px; height:42px; border-radius:50%; overflow:hidden; background:#e9eef1; display:grid; place-items:center; color:#596a75; font-size:12px; font-weight:800; }
.external-aggregate-avatar img { width:100%; height:100%; object-fit:cover; display:block; }
.external-aggregate-copy { min-width:0; }
.external-aggregate-copy strong { display:block; color:#243642; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-aggregate-copy small { display:block; margin-top:3px; color:#82919a; font-size:10px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-aggregate-copy em { display:block; margin-top:3px; color:#5f707b; font-size:10px; font-style:normal; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-aggregate-side { align-self:stretch; display:flex; flex-direction:column; align-items:flex-end; justify-content:space-between; gap:4px; }
.external-aggregate-time { color:#95a1a8; font-size:9px; white-space:nowrap; }
.external-aggregate-unread { min-width:18px; height:18px; padding:0 5px; border-radius:9px; display:grid; place-items:center; background:#20b966; color:#fff; font-size:9px; font-weight:800; }
.external-aggregate-source { max-width:62px; padding:2px 5px; border-radius:5px; background:#eef2f4; color:#65747e; font-size:9px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-aggregate-empty { padding:34px 14px; text-align:center; color:#87959d; font-size:12px; line-height:1.7; }
.external-crm-panel { position:absolute; right:0; top:var(--external-toolbar-height); bottom:0; width:320px; z-index:3; background:#fff; border-left:1px solid #dce4e8; padding:14px; overflow:auto; }
.external-crm-panel.hidden { display:none; }
.external-crm-head { display:flex; gap:10px; align-items:center; padding-bottom:12px; border-bottom:1px solid #edf1f3; margin-bottom:12px; }
.external-crm-avatar { width:48px; height:48px; border-radius:50%; overflow:hidden; display:grid; place-items:center; flex:0 0 auto; background:#edf1f3; color:#64747e; font-weight:800; }
.external-crm-avatar img { width:100%; height:100%; object-fit:cover; }
.external-crm-head strong { display:block; color:#1d2d38; font-size:14px; max-width:210px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-crm-head small { display:block; margin-top:3px; color:#86949c; font-size:10px; }
.external-crm-head-copy { min-width:0; flex:1; }
.external-crm-head-actions { margin-left:auto; display:flex; align-items:center; gap:6px; flex:0 0 auto; }
.external-crm-head-state { flex:0 0 auto; padding:3px 7px; border-radius:999px; background:#f1f5f3; color:#73817a; font-size:9px; white-space:nowrap; }
.external-crm-collapse-btn { width:28px; height:28px; padding:0; border:1px solid #d7e1dc; border-radius:8px; background:#fff; color:#5d7067; font-size:20px; line-height:1; cursor:pointer; }
.external-crm-collapse-btn:hover { background:#f1f7f4; color:#238454; border-color:#c8ddd1; }
.external-workspace-page.crm-collapsed .external-view-placeholder { right:0; }
.external-crm-summary { margin-bottom:10px; padding:10px; border:1px solid #dcebe2; border-radius:9px; background:#f6fbf8; }
.external-crm-summary strong { display:block; margin-bottom:4px; color:#276840; font-size:10px; }
.external-crm-summary span { display:block; color:#65746b; font-size:10px; line-height:1.5; }
.external-crm-summary.duplicate { border-color:#ef8c8c; background:#fff1f1; box-shadow:inset 3px 0 0 #df3f3f; }
.external-crm-summary.duplicate strong { color:#b42323; }
.external-crm-summary.duplicate span { color:#a12626; font-weight:600; }
.external-crm-summary.line-added:not(.duplicate) { border-color:#a7ddbd; background:#f2fbf6; }
.external-crm-target-line.hidden { display:none !important; }
.external-crm-target-line select { font-weight:600; }
.external-crm-timeline { display:grid; grid-template-columns:1fr 1fr; gap:7px; margin-bottom:10px; }
.external-crm-timeline > div { min-width:0; padding:8px; border:1px solid #e0e7e4; border-radius:8px; background:#fbfcfc; }
.external-crm-timeline span { display:block; color:#829089; font-size:9px; }
.external-crm-timeline strong { display:block; margin-top:3px; color:#34433c; font-size:10px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-crm-source { display:flex; justify-content:space-between; align-items:center; padding:8px 9px; background:#f6f8f9; border-radius:8px; margin-bottom:10px; font-size:11px; color:#7b8991; }
.external-crm-source strong { color:#344650; }
.external-crm-panel > label, .external-crm-grid label { display:grid; gap:4px; margin-bottom:9px; color:#71818a; font-size:10px; }
.external-crm-panel input, .external-crm-panel select, .external-crm-panel textarea { width:100%; border:1px solid #d8e0e4; border-radius:8px; padding:8px; background:#fff; color:#263740; font-size:11px; resize:vertical; }
.external-crm-grid { display:grid; grid-template-columns:1fr 1fr; gap:7px; }
.external-crm-actions-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-top:2px; }
.external-crm-actions-row button { width:100%; min-width:0; }
.external-crm-actions-row #externalCrmExtractBtn { border-color:#cfdad5; background:#f6faf8; color:#2b6e4a; font-weight:700; }
.external-crm-actions-row #externalCrmExtractBtn:hover { background:#edf7f2; border-color:#bcd4c7; }
.external-crm-extract-wrap { margin-top:9px; padding:9px; border:1px solid #dce5e1; border-radius:9px; background:#f8fbf9; }
.external-crm-extract-wrap.hidden { display:none !important; }
.external-crm-extract-wrap textarea { min-height:150px; background:#fff; font-family:Consolas, "Microsoft YaHei", sans-serif; line-height:1.55; }
.external-crm-extract-wrap small { display:block; margin-top:5px; color:#72827a; font-size:9px; }

.external-crm-save-status { display:block; text-align:center; color:#8b989f; margin-top:7px; }
@media (max-width: 1180px) {
  .external-workspace-row { gap:5px; }
  .external-workspace-action-row button { padding:6px 8px; font-size:11px; }
  .external-customer-stats { padding-left:6px; padding-right:6px; gap:5px; }
}

.external-workspace-action-row #externalCrmToolbarToggleBtn.hidden { display:none !important; }


/* V1.21.9 · configurable LINE ID routing for non-LINE CRM */
.line-id-settings-card { width:min(640px, calc(100vw - 36px)); }
.line-id-create-row { display:grid; grid-template-columns:1fr 1fr auto; gap:10px; align-items:end; margin-top:12px; }
.line-id-create-row label { display:grid; gap:5px; color:#63737c; font-size:11px; }
.line-id-create-row input { width:100%; min-width:0; border:1px solid #d5dee3; border-radius:8px; padding:9px 10px; font-size:12px; background:#fff; color:#24343d; }
.line-id-create-row button { height:36px; white-space:nowrap; }
.line-id-hint { margin:10px 0; padding:9px 10px; border-radius:8px; background:#f5f8fa; color:#75858e; font-size:10px; line-height:1.5; }
.line-id-settings-list { display:grid; gap:7px; max-height:340px; overflow:auto; }
.line-id-settings-row { display:flex; align-items:center; gap:10px; padding:10px 11px; border:1px solid #e0e7ea; border-radius:9px; background:#fff; }
.line-id-settings-main { min-width:0; flex:1; }
.line-id-settings-main strong { display:block; color:#24343d; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.line-id-settings-main small { display:block; margin-top:3px; color:#8a979e; font-size:10px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.line-id-settings-empty { padding:22px; border:1px dashed #d8e1e5; border-radius:9px; color:#8b989f; text-align:center; font-size:11px; }
@media (max-width:760px) { .line-id-create-row { grid-template-columns:1fr; } }


/* V1.21.10 · CRM layout cleanup + one-click text extraction */


/* V1.21.12 · LINE flow settings + keyboard-focus fix */
.line-flow-settings-card { width:min(680px, calc(100vw - 36px)); }
.line-flow-create-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:10px; align-items:end; margin-top:12px; }
.line-flow-create-row label { display:grid; gap:5px; color:#63737c; font-size:11px; }
.line-flow-create-row input { width:100%; min-width:0; border:1px solid #d5dee3; border-radius:8px; padding:9px 10px; font-size:12px; background:#fff; color:#24343d; }
.line-flow-create-row button { height:36px; white-space:nowrap; }
.line-flow-hint { margin:10px 0; padding:9px 10px; border-radius:8px; background:#f5f8fa; color:#75858e; font-size:10px; line-height:1.5; }
.line-flow-settings-list { display:grid; gap:7px; max-height:390px; overflow:auto; }
.line-flow-settings-row { display:flex; align-items:center; gap:10px; padding:10px 11px; border:1px solid #e0e7ea; border-radius:9px; background:#fff; }
.line-flow-settings-main { min-width:0; flex:1; }
.line-flow-settings-main strong { display:block; color:#24343d; font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.line-flow-settings-main small { display:block; margin-top:3px; color:#8a979e; font-size:10px; }
.line-flow-settings-actions { display:flex; align-items:center; gap:5px; flex:0 0 auto; }
.line-flow-settings-actions button { min-width:34px; padding:6px 8px; }
.line-flow-modal-actions { justify-content:space-between; }
@media (max-width:760px) {
  .line-flow-create-row { grid-template-columns:1fr; }
  .line-flow-settings-row { align-items:flex-start; }
  .line-flow-settings-actions { flex-wrap:wrap; justify-content:flex-end; }
}

/* V1.21.14: in-app LINE flow confirmation keeps keyboard/IME focus in Chromium. */
.line-flow-confirm-card { width:min(450px, calc(100vw - 36px)); }
.line-flow-confirm-message { color:#22323b; font-size:14px; line-height:1.65; font-weight:600; padding:4px 0 8px; }
.line-flow-confirm-detail { color:#687983; font-size:12px; line-height:1.65; padding:10px 12px; border-radius:9px; background:#f5f8f9; }

/* V1.22.4 dedicated global translation panel */
.translation-settings-card { width: min(760px, calc(100vw - 48px)); max-height: calc(100vh - 46px); overflow: auto; }

/* V1.22.9: LINE duplicate-customer visibility uses the same red warning language
   as external platform aggregate lists without changing selection behavior. */
.aggregate-customer-item.duplicate { border-color:#ef9a9a; background:#fff8f8; }
.aggregate-customer-item.duplicate:hover { border-color:#e77878; background:#fff3f3; }
.aggregate-customer-item.duplicate.active { border-color:#df5353; background:#fff0f0; box-shadow:0 0 0 1px rgba(223,83,83,.10) inset; }
.aggregate-customer-duplicate-badge { display:inline-flex; align-items:center; flex:0 0 auto; padding:1px 5px; border-radius:999px; background:#ffe1e1; color:#c62828; font-size:8.5px; font-weight:800; line-height:1.45; }
\n\n/* V1.23.0 — unified platform/native account cards and aggregate customer cards. */\n.account-actions { width: 44px; grid-template-columns: 44px; }\n.account-actions .mini { width: 40px; min-width:40px; }\n.account-actions .window-btn { font-size:9.5px; font-weight:800; letter-spacing:-.3px; }\n.account-window-status { min-width:40px; max-width:44px; }\n.account { padding-right:54px; }\n.account.active { padding-right:53px; }\n\n.external-account-sidebar-list:not(:has(.external-aggregate-customer)) { padding:7px; }\n.external-account-item {\n  width:100%; min-height:86px; display:grid; grid-template-columns:50px minmax(0,1fr) 52px;\n  align-items:center; gap:8px; padding:8px 6px 8px 8px; border:1px solid #e2e8eb; border-radius:11px;\n  background:#fff; text-align:left; margin-bottom:7px; cursor:pointer; position:relative; color:inherit;\n}\n.external-account-item:hover { background:#f5fbf7; border-color:#b8ddc7; }\n.external-account-item.active { background:#edf9f2; border-color:#51c67f; box-shadow:0 0 0 1px rgba(47,198,109,.10) inset; }\n.external-account-avatar { width:46px; height:46px; font-size:11px; }\n.external-account-copy { min-width:0; align-self:center; }\n.external-account-copy strong { font-size:13px; line-height:19px; color:#182a38; }\n.external-account-copy small { display:block; margin-top:1px; font-size:10px; line-height:16px; }\n.external-account-proxy { color:#84929c; }\n.external-account-remark { color:#26343d !important; cursor:text; }\n.external-account-remark:hover { color:#159653 !important; }\n.external-account-remark-input { width:100%; height:24px; padding:3px 6px; border:1px solid #5ac985; border-radius:6px; font-size:10px; outline:none; background:#fff; }\n.external-account-actions { align-self:stretch; display:grid; grid-template-rows:24px 1fr 24px; align-items:center; justify-items:center; gap:2px; }\n.external-account-actions button { width:46px; height:24px; padding:0 4px; border:1px solid #d8e1dd; border-radius:6px; background:#fff; color:#34443c; font-size:9px; font-weight:700; cursor:pointer; }\n.external-account-actions button:hover { background:#edf7f2; color:#159653; border-color:#b9dec8; }\n.external-account-actions button.danger { color:#bf4d56; }\n.external-account-actions button.danger:hover { background:#fff1f2; color:#ad3944; border-color:#efc5c9; }\n.external-account-online-state { min-width:42px; padding:2px 3px; border-radius:5px; text-align:center; font-size:9px; line-height:14px; font-weight:700; }\n.external-account-online-state.online { color:#168c4a; background:#eefaf3; }\n.external-account-online-state.offline { color:#647078; background:#f1f4f5; }\n.external-account-dot { display:none !important; }\n\n.external-workspace-page.aggregate-active .external-account-sidebar { width:var(--aggregate-sidebar-width); }\n.external-workspace-page.aggregate-active { --external-account-sidebar-width:var(--aggregate-sidebar-width); }\n.external-aggregate-customer.aggregate-customer-item {\n  display:grid; grid-template-columns:52px minmax(0,1fr); gap:9px; min-height:72px; padding:8px; margin-bottom:6px;\n  border:1px solid #e0e7ea; border-radius:11px; background:#fff;\n}\n.external-aggregate-customer.aggregate-customer-item:hover { background:#f5fbf7; border-color:#a8ddbe; }\n.external-aggregate-customer.aggregate-customer-item.active { background:#edf9f2; border-color:#51c67f; box-shadow:0 0 0 1px rgba(47,198,109,.12) inset; }\n.external-aggregate-customer.aggregate-customer-item.duplicate { border-color:#ef9a9a; background:#fff8f8; }\n.external-aggregate-customer.aggregate-customer-item.duplicate.active { border-color:#df5353; background:#fff0f0; }\n.external-aggregate-avatar.aggregate-customer-avatar { width:52px; height:52px; }\n.external-aggregate-body { min-width:0; }\n.external-aggregate-handle { color:#75848d; font-size:9.5px; max-width:90px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n/* Follow-up stage is CRM-only. Never show it on any aggregate customer card. */\n.aggregate-customer-stage { display:none !important; }\n
.account-actions .delete-btn { font-size:9.5px !important; font-weight:800; }


/* V1.23.1 — LINE-style native account sidebar for every platform. */
.external-account-sidebar-head-actions { display:flex; align-items:center; gap:6px; }
.external-sidebar-toggle {
  width:28px; height:28px; min-width:28px; display:grid; place-items:center;
  border:1px solid #dfe8e3; border-radius:7px; background:#fff; color:#4d606a;
  font-size:11px; cursor:pointer;
}
.external-sidebar-toggle:hover { border-color:#b9dfca; color:#16a357; background:#f4fbf7; }
.external-bulk-account-controls { height:42px; box-sizing:border-box; }
.external-bulk-account-controls.hidden { display:none !important; }
.external-account-sidebar-list { height:calc(100% - 90px); }
.external-workspace-page.aggregate-active .external-account-sidebar-list { height:calc(100% - 48px - 49px); }

.external-account-sidebar-list:not(:has(.external-aggregate-customer)) { padding:8px; }
.external-account-item {
  min-height:78px !important;
  grid-template-columns:44px minmax(0,1fr) 34px !important;
  gap:8px !important;
  padding:8px 5px 8px 8px !important;
  margin-bottom:7px !important;
  border:1px solid #e1e8e4 !important;
  border-radius:9px !important;
  background:#fff !important;
  box-shadow:0 1px 2px rgba(35,55,45,.025);
}
.external-account-item:hover { border-color:#c6dfd1 !important; background:#fff !important; box-shadow:0 3px 10px rgba(35,55,45,.045); }
.external-account-item.active { border:2px solid #20c467 !important; padding:7px 4px 7px 7px !important; background:#fff !important; box-shadow:0 3px 12px rgba(32,196,103,.07); }
.external-account-avatar { width:40px !important; height:40px !important; font-size:10px !important; }
.external-account-copy { align-self:center; min-width:0; padding-right:1px; }
.external-account-copy strong { display:block; font-size:12.5px !important; line-height:18px !important; font-weight:700; color:#111 !important; }
.external-account-copy small { display:block; margin-top:0 !important; font-size:10px !important; line-height:15px !important; }
.external-account-proxy { color:#687780 !important; }
.external-account-remark { color:#111 !important; font-weight:600; }
.external-account-remark:hover { color:#159653 !important; }
.external-account-actions {
  width:30px; align-self:stretch; display:grid !important;
  grid-template-rows:24px 1fr 24px !important; align-items:center; justify-items:center; gap:0 !important;
}
.external-account-actions .external-account-icon-btn {
  width:28px !important; height:24px !important; min-width:28px; padding:0 !important;
  border:0 !important; border-radius:6px !important; background:transparent !important;
  color:#687780 !important; font-size:15px !important; font-weight:500 !important; line-height:1 !important;
}
.external-account-actions .external-account-icon-btn.restart { font-size:14px !important; }
.external-account-actions .external-account-icon-btn:hover { background:#edf7f2 !important; color:#159653 !important; }
.external-account-actions .external-account-icon-btn.danger { color:#d05c65 !important; font-size:19px !important; }
.external-account-actions .external-account-icon-btn.danger:hover { background:#fff1f2 !important; color:#b83f4a !important; }
.external-account-online-state {
  min-width:30px !important; max-width:30px; padding:2px 1px !important; border-radius:5px;
  font-size:9px !important; line-height:14px !important; font-weight:700;
}

/* Match the compact LINE sidebar behavior in native platform mode. */
.external-workspace-page.external-sidebar-collapsed { --external-account-sidebar-width:86px; }
.external-workspace-page.external-sidebar-collapsed .external-account-sidebar { width:86px; }
.external-workspace-page.external-sidebar-collapsed .external-account-sidebar-head {
  height:48px; padding:0; justify-content:center;
}
.external-workspace-page.external-sidebar-collapsed .external-account-sidebar-head > strong,
.external-workspace-page.external-sidebar-collapsed #externalAccountSidebarCount { display:none; }
.external-workspace-page.external-sidebar-collapsed .external-account-sidebar-head-actions { width:100%; justify-content:center; }
.external-workspace-page.external-sidebar-collapsed .external-bulk-account-controls { gap:3px; padding:5px 6px; height:38px; }
.external-workspace-page.external-sidebar-collapsed .external-bulk-account-controls .bulk-line-btn { height:27px; padding:0; border-radius:6px; }
.external-workspace-page.external-sidebar-collapsed .external-bulk-account-controls .bulk-line-text { display:none; }
.external-workspace-page.external-sidebar-collapsed .external-account-sidebar-list { height:calc(100% - 86px); padding:8px 7px 16px; }
.external-workspace-page.external-sidebar-collapsed .external-account-item {
  min-height:66px !important; padding:7px 2px 6px !important; display:flex !important;
  flex-direction:column; align-items:center; justify-content:center; gap:0 !important; border-radius:8px !important;
}
.external-workspace-page.external-sidebar-collapsed .external-account-item.active { padding:6px 1px 5px !important; }
.external-workspace-page.external-sidebar-collapsed .external-account-avatar { width:42px !important; height:42px !important; }
.external-workspace-page.external-sidebar-collapsed .external-account-copy { width:100%; margin-top:3px; padding:0 2px; text-align:center; }
.external-workspace-page.external-sidebar-collapsed .external-account-copy strong { font-size:10px !important; line-height:14px !important; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-workspace-page.external-sidebar-collapsed .external-account-proxy,
.external-workspace-page.external-sidebar-collapsed .external-account-remark,
.external-workspace-page.external-sidebar-collapsed .external-account-actions { display:none !important; }

/* LINE card actions use the same fixed right rail: restart icon / status / X. */
.account-actions { width:34px !important; grid-template-columns:34px !important; grid-template-rows:25px 1fr 25px !important; }
.account-actions .mini { width:28px !important; min-width:28px !important; height:25px !important; padding:0 !important; border:0 !important; background:transparent !important; }
.account-actions .window-btn { font-size:14px !important; font-weight:500 !important; letter-spacing:0 !important; }
.account-actions .delete-btn { font-size:19px !important; }
.account-window-status { min-width:30px !important; max-width:34px !important; font-size:9px !important; }
.account { padding-right:46px !important; }
.account.active { padding-right:45px !important; }


/* V1.23.2 — quick application add/remove controls above Settings. */
.global-app-rail-action {
  min-height: 42px;
  height: 42px;
  border-radius: 9px;
}
.global-app-rail-action > span {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  font-size: 20px;
  font-weight: 800;
}
.global-app-rail-action.add-app { color:#168f50; }
.global-app-rail-action.add-app > span { background:#e7f8ef; color:#17a35b; }
.global-app-rail-action.remove-app { color:#a85a5a; }
.global-app-rail-action.remove-app > span { background:#fff0f0; color:#dc5151; }
.global-app-rail-action.remove-app.active {
  background:#fff0f0;
  color:#c73f3f;
  box-shadow: inset 0 0 0 1px #efabab;
}


/* V1.23.3 — direct app picker beside the left rail. No App Center detour. */
.shell-quick-add-menu {
  position: fixed;
  left: calc(var(--global-app-rail-width) + 8px);
  bottom: 138px;
  z-index: 2600;
  width: 218px;
  max-height: min(430px, calc(100vh - 170px));
  overflow-y: auto;
  padding: 8px;
  border: 1px solid #d9e2e7;
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 12px 34px rgba(21, 41, 53, .18);
}
.shell-quick-add-menu.hidden { display:none !important; }
.shell-quick-add-menu::before {
  content:'';
  position:absolute;
  left:-7px;
  bottom:18px;
  width:12px;
  height:12px;
  border-left:1px solid #d9e2e7;
  border-bottom:1px solid #d9e2e7;
  background:#fff;
  transform:rotate(45deg);
}
.shell-quick-add-item {
  position:relative;
  width:100%;
  min-height:48px;
  display:grid;
  grid-template-columns:36px minmax(0, 1fr) 22px;
  align-items:center;
  gap:9px;
  padding:6px 8px;
  border:0;
  border-radius:9px;
  background:#fff;
  color:#182a34;
  text-align:left;
  cursor:pointer;
}
.shell-quick-add-item:hover { background:#f1faf5; }
.shell-quick-add-icon {
  width:34px;
  height:34px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:#596b76;
  color:#fff;
  font-size:11px;
  font-weight:800;
}
.shell-quick-add-icon.platform-facebook { background:#1877f2; font-size:13px; }
.shell-quick-add-icon.platform-instagram { background:#d62976; }
.shell-quick-add-icon.platform-whatsapp { background:#25d366; }
.shell-quick-add-icon.platform-telegram { background:#2aabee; }
.shell-quick-add-icon.platform-tiktok { background:#111; }
.shell-quick-add-icon.platform-metabusiness { background:#0668e1; }
.shell-quick-add-icon.platform-line { background:#06c755; font-size:10px; }
.shell-quick-add-copy { min-width:0; display:flex; flex-direction:column; gap:2px; }
.shell-quick-add-copy strong { font-size:13px; line-height:17px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.shell-quick-add-copy small { color:#83919a; font-size:10px; line-height:13px; }
.shell-quick-add-plus { color:#22b96c; font-size:20px; font-weight:800; text-align:center; }
.shell-quick-add-empty { padding:14px 10px; color:#87949c; font-size:12px; text-align:center; }
.global-app-rail-action.add-app.active { background:#eaf9f1; box-shadow:inset 0 0 0 1px #a9e3c4; }

.shell-quick-add-menu.compact {
  left: 5px;
  width: 52px;
  padding: 5px;
  border-radius: 12px;
}
.shell-quick-add-menu.compact::before { display:none; }
.shell-quick-add-menu.compact .shell-quick-add-item {
  min-height: 44px;
  grid-template-columns: 1fr;
  padding: 5px 4px;
  justify-items:center;
}
.shell-quick-add-menu.compact .shell-quick-add-copy,
.shell-quick-add-menu.compact .shell-quick-add-plus { display:none; }
.shell-quick-add-menu.compact .shell-quick-add-icon { width:36px; height:36px; }


/* V1.23.4 — remove applications with the same one-click picker UX as add. */
.shell-quick-remove-menu { bottom: 91px; }
.shell-quick-remove-menu .shell-quick-add-item:hover { background:#fff5f5; }
.shell-quick-remove-minus { color:#df5656; font-size:20px; font-weight:800; text-align:center; }
.global-app-rail-action.remove-app.active { background:#fff0f0; box-shadow:inset 0 0 0 1px #efabab; }
.shell-quick-remove-menu.compact .shell-quick-add-copy,
.shell-quick-remove-menu.compact .shell-quick-remove-minus { display:none; }

/* V1.23.6 operations dashboard ------------------------------------------ */
.dashboard-heading { align-items:center; }
.dashboard-refresh-wrap { display:flex; align-items:center; gap:10px; color:#8a98a5; font-size:12px; }
.dashboard-kpi-grid { grid-template-columns:repeat(6,minmax(138px,1fr)); }
.dashboard-kpi { min-height:118px; display:flex; flex-direction:column; justify-content:center; position:relative; overflow:hidden; }
.dashboard-kpi::after { content:""; position:absolute; right:-24px; bottom:-34px; width:92px; height:92px; border-radius:50%; background:rgba(40,190,108,.06); }
.dashboard-kpi span { order:0; font-weight:700; color:#5e6f7d; }
.dashboard-kpi strong { order:1; margin:7px 0 2px; font-size:30px; }
.dashboard-kpi small { order:2; color:#9aa6af; font-size:11px; }
.dashboard-main-grid { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(390px,.85fr); gap:16px; margin-bottom:16px; }
.dashboard-panel-title { display:flex; align-items:flex-start; justify-content:space-between; gap:14px; margin-bottom:14px; }
.dashboard-panel-title h2 { margin:0 0 4px; }
.dashboard-panel-title p { margin:0; color:#8997a2; font-size:12px; }
.dashboard-platform-grid { display:grid; grid-template-columns:repeat(2,minmax(230px,1fr)); gap:10px; }
.dashboard-platform-card { min-width:0; padding:14px; border:1px solid #e3e9ed; background:#f9fbfc; border-radius:12px; text-align:left; transition:.16s ease; }
.dashboard-platform-card:hover { background:#fff; border-color:#bcd7c8; box-shadow:0 6px 16px rgba(24,54,72,.07); transform:translateY(-1px); }
.dashboard-platform-card-head { display:grid; grid-template-columns:38px minmax(0,1fr) 18px; align-items:center; gap:10px; }
.dashboard-platform-card-title strong { display:block; color:#183044; font-size:14px; }
.dashboard-platform-card-title small { display:block; color:#8b99a4; margin-top:2px; }
.dashboard-platform-arrow { color:#9aa7b0; font-size:22px; text-align:right; }
.dashboard-platform-metrics { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:12px; }
.dashboard-platform-metrics > span { min-width:0; padding:8px 5px; border-radius:8px; background:#fff; border:1px solid #edf1f3; text-align:center; }
.dashboard-platform-metrics b { display:block; color:#173043; font-size:16px; }
.dashboard-platform-metrics small { display:block; margin-top:2px; color:#8c99a3; font-size:10px; white-space:nowrap; }
.dashboard-platform-metrics .dup b { color:#d34d59; }
.dashboard-platform-foot { display:flex; justify-content:space-between; gap:10px; margin-top:10px; color:#70818e; font-size:11px; }
.dashboard-account-progress { display:block; height:4px; margin-top:8px; border-radius:99px; background:#e8edef; overflow:hidden; }
.dashboard-account-progress i { display:block; height:100%; border-radius:inherit; background:#2bc16f; }
.dashboard-trend-panel { min-height:330px; }
.dashboard-legend { display:flex; gap:10px; align-items:center; color:#73828d; font-size:11px; white-space:nowrap; }
.dashboard-legend span { display:flex; align-items:center; gap:5px; }
.dashboard-legend i { width:8px; height:8px; border-radius:2px; display:block; }
.dashboard-legend i.new { background:#2bc16f; }
.dashboard-legend i.duplicate { background:#e36a74; }
.dashboard-trend-chart { height:248px; min-height:248px; }
.dashboard-chart-grid { height:100%; display:grid; grid-template-columns:repeat(7,minmax(34px,1fr)); gap:10px; align-items:end; padding:8px 2px 0; border-bottom:1px solid #e5ebee; background:repeating-linear-gradient(to top, transparent 0, transparent 49px, rgba(223,231,236,.65) 50px); }
.dashboard-chart-day { min-width:0; height:100%; display:grid; grid-template-rows:24px minmax(0,1fr) 24px; align-items:end; text-align:center; }
.dashboard-chart-values { display:flex; justify-content:center; gap:7px; font-size:9px; color:#7d8b95; min-height:14px; }
.dashboard-chart-bars { height:100%; min-height:120px; display:flex; align-items:flex-end; justify-content:center; gap:4px; }
.dashboard-chart-bars i { width:min(15px,36%); min-height:0; border-radius:5px 5px 2px 2px; transition:height .2s ease; }
.dashboard-chart-bars i.new { background:#2bc16f; }
.dashboard-chart-bars i.duplicate { background:#e36a74; }
.dashboard-chart-day > small { color:#84929d; font-size:10px; padding-top:5px; }
.dashboard-account-panel { margin-bottom:20px; }
.dashboard-account-summary { padding:5px 9px; border-radius:999px; background:#f0f5f2; color:#4b7960; font-size:11px; }
.dashboard-account-status-list { display:grid; grid-template-columns:repeat(3,minmax(220px,1fr)); gap:8px; }
.dashboard-account-status-row { display:grid; grid-template-columns:38px minmax(0,1fr) auto; align-items:center; gap:9px; padding:10px 11px; border:1px solid #e4eaee; background:#fafcfd; border-radius:10px; text-align:left; }
.dashboard-account-status-row:hover { background:#fff; border-color:#cbd8df; }
.dashboard-account-status-copy strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#213645; }
.dashboard-account-status-copy small { display:block; margin-top:2px; color:#8b99a4; }
.dashboard-account-state { display:flex; align-items:center; gap:5px; color:#7b8994; font-size:11px; white-space:nowrap; }
.dashboard-account-state i { width:7px; height:7px; border-radius:50%; background:#aeb9c0; }
.dashboard-account-status-row.online .dashboard-account-state { color:#238754; }
.dashboard-account-status-row.online .dashboard-account-state i,
.dashboard-account-status-row.running .dashboard-account-state i { background:#27be6d; }
.dashboard-account-status-row.closed .dashboard-account-state i { background:#b7c0c7; }
.dashboard-empty { height:100%; display:grid; place-items:center; color:#93a0aa; font-size:12px; }
.dashboard-empty-wide { min-height:110px; border:1px dashed #d8e0e5; border-radius:10px; }

@media (max-width: 1280px) {
  .dashboard-kpi-grid { grid-template-columns:repeat(3,minmax(145px,1fr)); }
  .dashboard-main-grid { grid-template-columns:1fr; }
  .dashboard-platform-grid { grid-template-columns:repeat(3,minmax(210px,1fr)); }
}
@media (max-width: 980px) {
  .dashboard-platform-grid { grid-template-columns:repeat(2,minmax(210px,1fr)); }
  .dashboard-account-status-list { grid-template-columns:repeat(2,minmax(210px,1fr)); }
}
@media (max-width: 720px) {
  .dashboard-kpi-grid { grid-template-columns:repeat(2,minmax(130px,1fr)); }
  .dashboard-platform-grid, .dashboard-account-status-list { grid-template-columns:1fr; }
  .dashboard-refresh-wrap span { display:none; }
}
.dashboard-account-status-list { max-height:260px; overflow:auto; padding-right:2px; }

/* V1.23.9 — all non-LINE platforms share one independent aggregate desk. */
.global-app-rail-btn.unified-aggregate .rail-unified-icon {
  width:30px; height:30px; border-radius:9px; display:grid; place-items:center;
  background:#eef3f6; color:#49606e; font-size:18px; font-weight:900;
}
.global-app-rail-btn.unified-aggregate.active .rail-unified-icon {
  background:#dff6e9; color:#159252;
}
.external-global-tool.hidden,
.external-global-stat.hidden,
#externalAggregatePlatformFilter.hidden { display:none !important; }
.external-workspace-page.global-aggregate-active { --external-account-sidebar-width:310px; }
.external-workspace-page.global-aggregate-active .external-account-sidebar { width:310px; }
.external-workspace-page.global-aggregate-active .external-workspace-icon {
  border-radius:11px; background:#183a50; color:#fff; font-size:17px;
}
.external-workspace-page.global-aggregate-active .external-aggregate-tools {
  grid-template-columns:minmax(0,1fr) 82px 112px;
}
.external-workspace-page.global-aggregate-active .external-account-sidebar-list {
  height:calc(100% - 48px - 49px); padding:7px;
}
.external-global-platform-badge {
  display:inline-flex; align-items:center; justify-content:center; min-width:26px; height:16px;
  padding:0 5px; border-radius:5px; background:#e9eef1; color:#445662; font-size:8px;
  font-weight:900; line-height:1; white-space:nowrap;
}
.external-global-platform-badge.platform-tiktok { background:#111; color:#fff; }
.external-global-platform-badge.platform-facebook { background:#1877f2; color:#fff; }
.external-global-platform-badge.platform-instagram { background:#d62976; color:#fff; }
.external-global-platform-badge.platform-whatsapp { background:#25d366; color:#fff; }
.external-global-platform-badge.platform-telegram { background:#2aabee; color:#fff; }
.external-global-platform-badge.platform-metabusiness { background:#0668e1; color:#fff; }
.external-aggregate-compact-meta { display:none; min-width:0; }
.external-aggregate-compact-source { display:flex; align-items:center; justify-content:center; gap:4px; min-width:0; }
.external-aggregate-compact-source small { max-width:68px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#73818a; font-size:8.5px; }
.external-workspace-page.global-aggregate-active .external-customer-stats { gap:8px; }
.external-workspace-page.global-aggregate-active .external-customer-stats .customer-stats-scope {
  max-width:72px; color:#183a50;
}
.external-workspace-page.global-aggregate-active .external-global-stat strong { color:#168f50; }
.external-workspace-page.global-aggregate-active .external-workspace-action-row { overflow-x:auto; scrollbar-width:none; justify-content:flex-end; flex-wrap:nowrap; }
.external-workspace-page.global-aggregate-active .external-workspace-action-row::-webkit-scrollbar { display:none; }
.external-ops-card { width:min(880px, calc(100vw - 36px)); }
.external-ops-account-row {
  display:grid; grid-template-columns:42px minmax(0,1fr) auto auto; gap:10px; align-items:center;
  padding:10px 11px; border:1px solid #e0e7ea; border-radius:9px; background:#fff; margin-bottom:7px;
}
.external-ops-account-platform {
  width:36px; height:36px; border-radius:10px; display:grid; place-items:center; background:#e9eef1;
  color:#354955; font-size:9px; font-weight:900;
}
.external-ops-account-platform.platform-tiktok { background:#111; color:#fff; }
.external-ops-account-platform.platform-facebook { background:#1877f2; color:#fff; }
.external-ops-account-platform.platform-instagram { background:#d62976; color:#fff; }
.external-ops-account-platform.platform-whatsapp { background:#25d366; color:#fff; }
.external-ops-account-platform.platform-telegram { background:#2aabee; color:#fff; }
.external-ops-account-platform.platform-metabusiness { background:#0668e1; color:#fff; }
.external-ops-account-copy { min-width:0; }
.external-ops-account-copy strong { display:block; font-size:12px; color:#233642; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-ops-account-copy small { display:block; margin-top:3px; font-size:10px; color:#84929b; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.external-ops-account-state { padding:4px 8px; border-radius:999px; font-size:10px; font-weight:800; white-space:nowrap; }
.external-ops-account-state.running { background:#e8f8ef; color:#168f50; }
.external-ops-account-state.closed { background:#f1f3f4; color:#75818a; }
.external-ops-account-proxy { color:#657681; font-size:10px; white-space:nowrap; }
@media (max-width: 1180px) {
  .external-workspace-page.global-aggregate-active .external-workspace-identity { min-width:170px; }
  .external-workspace-page.global-aggregate-active .external-customer-stats { font-size:10px; padding-left:6px; padding-right:6px; }
}
.external-workspace-action-row button.hidden,
#externalAddAccountBtn.hidden,
#externalNetworkBtn.hidden,
#externalManageBtn.hidden,
#externalLineIdSettingsBtn.hidden,
#externalCrmToolbarToggleBtn.hidden { display:none !important; }


/* V1.23.11 — external/global aggregate sidebar collapse really changes layout. */
.external-workspace-page.global-aggregate-active.external-sidebar-collapsed,
.external-workspace-page.aggregate-active.external-sidebar-collapsed {
  --external-account-sidebar-width:132px !important;
}
.external-workspace-page.global-aggregate-active.external-sidebar-collapsed .external-account-sidebar,
.external-workspace-page.aggregate-active.external-sidebar-collapsed .external-account-sidebar {
  width:132px !important;
}
.external-workspace-page.aggregate-active.external-sidebar-collapsed .external-aggregate-tools,
.external-workspace-page.global-aggregate-active.external-sidebar-collapsed .external-aggregate-tools {
  display:none !important;
}
.external-workspace-page.aggregate-active.external-sidebar-collapsed .external-account-sidebar-list,
.external-workspace-page.global-aggregate-active.external-sidebar-collapsed .external-account-sidebar-list {
  height:calc(100% - 48px) !important;
  padding:8px 7px 16px !important;
}
.external-workspace-page.external-sidebar-collapsed .external-aggregate-customer.aggregate-customer-item {
  min-height:64px !important;
  padding:6px 5px !important;
  display:grid !important;
  grid-template-columns:42px minmax(0,1fr) !important;
  gap:6px !important;
  align-items:center !important;
  justify-content:stretch !important;
  border-radius:8px !important;
}
.external-workspace-page.external-sidebar-collapsed .external-aggregate-customer .external-aggregate-body {
  display:none !important;
}
.external-workspace-page.external-sidebar-collapsed .external-aggregate-customer .external-aggregate-compact-meta {
  display:flex !important;
  flex-direction:column;
  justify-content:center;
  gap:4px;
  min-width:0;
  overflow:hidden;
}
.external-workspace-page.external-sidebar-collapsed .external-aggregate-customer .external-aggregate-compact-meta > strong {
  display:block;
  max-width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:10px;
  line-height:13px;
  color:#1e2d36;
  text-align:left;
}
.external-workspace-page.external-sidebar-collapsed .external-aggregate-customer .external-aggregate-compact-source { justify-content:flex-start; }
.external-workspace-page.external-sidebar-collapsed .external-aggregate-customer .external-global-platform-badge { min-width:22px; height:14px; padding:0 4px; font-size:7.5px; }
.external-workspace-page.external-sidebar-collapsed .external-aggregate-avatar.aggregate-customer-avatar {
  width:42px !important;
  height:42px !important;
  flex:0 0 42px !important;
}
.external-aggregate-customer.aggregate-customer-item.pinned {
  border-color:#dfc464 !important;
  background:#fffdf4 !important;
}
.external-aggregate-customer.aggregate-customer-item.pinned.active {
  border-color:#42c77a !important;
  background:#edf9f2 !important;
}

/* V1.23.19 - Ollama/Qwen one-click environment + model manager */
.ollama-manager { margin: 10px 0 8px; padding: 10px; border: 1px solid #d7e5dc; border-radius: 10px; background: #fff; }
.ollama-manager-head { display:flex; align-items:flex-start; justify-content:space-between; gap:10px; }
.ollama-manager-head strong { font-size:13px; color:#1c2b23; }
.ollama-runtime-state { margin-top:4px; font-size:11px; color:#6b7780; }
.ollama-runtime-state.ok { color:#168a47; font-weight:700; }
.ollama-runtime-state.warn { color:#b36b00; font-weight:700; }
.ollama-manager-head-actions { display:flex; gap:6px; flex-wrap:wrap; justify-content:flex-end; }
.ollama-manager-head-actions .test-ai-btn { margin-top:0; }
.ollama-model-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px; margin-top:10px; }
.ollama-model-card { border:1px solid #e4e9e6; border-radius:9px; padding:8px 9px; background:#fafcfb; min-width:0; }
.ollama-model-card.installed { border-color:#b9e3c7; background:#f3fbf6; }
.ollama-model-title { display:flex; align-items:center; justify-content:space-between; gap:8px; font-weight:700; font-size:12px; }
.ollama-model-badge { flex:none; font-size:10px; padding:2px 6px; border-radius:999px; background:#edf1f3; color:#66727a; }
.ollama-model-card.installed .ollama-model-badge { background:#dff5e6; color:#148242; }
.ollama-model-meta { margin-top:3px; font-size:10px; color:#7a858c; }
.ollama-model-actions { display:flex; gap:5px; margin-top:7px; flex-wrap:wrap; }
.ollama-model-actions button { padding:5px 8px; border:1px solid #cfd8d3; border-radius:7px; background:#fff; cursor:pointer; font-size:11px; }
.ollama-model-actions button.primary { border-color:#23b967; background:#24bf6c; color:#fff; }
.ollama-model-actions button.danger { border-color:#efc6c1; color:#b62f25; }
.ollama-model-actions button:disabled { opacity:.55; cursor:wait; }
.ollama-download-box { margin-top:9px; padding:8px 9px; border-radius:8px; background:#f4f8f6; border:1px solid #dae7df; }
.ollama-progress-row { display:flex; justify-content:space-between; gap:10px; font-size:11px; color:#34443b; }
.ollama-progress-track { height:8px; overflow:hidden; border-radius:999px; background:#e2e9e5; margin-top:7px; }
.ollama-progress-bar { height:100%; width:0%; border-radius:999px; background:#26ba6b; transition:width .18s ease; }
.ollama-download-detail { margin-top:5px; font-size:10px; color:#748079; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
@media (max-width: 760px) { .ollama-model-list { grid-template-columns:1fr; } .ollama-manager-head { flex-direction:column; } }

/* V1.23.22 speed-accuracy balanced intelligent Qwen router */
.ollama-auto-mode-hint{margin:7px 0 8px;padding:8px 10px;border:1px solid #cfe7d7;border-radius:8px;background:#f5fbf7;color:#2e6e48;font-size:11px;line-height:1.55;}

/* V1.23.23: make auto/fixed model ownership unambiguous. */
#ollamaFixedModelField.ollama-auto-disabled{opacity:.58;}
#ollamaFixedModelField.ollama-auto-disabled select{background:#f2f4f3;color:#7a8580;cursor:not-allowed;}
.ollama-runtime-version{font-weight:700;}

.ollama-progress-bar.indeterminate{animation:ollamaIndeterminate 1.1s ease-in-out infinite;transition:none;}
@keyframes ollamaIndeterminate{0%{transform:translateX(-120%)}50%{transform:translateX(105%)}100%{transform:translateX(310%)}}

/* V1.23.27 — per-account window action is a true close/open toggle, not restart. */
.account-actions .window-btn.stop,
.external-account-actions .external-account-icon-btn.stop { color:#66737b !important; }
.account-actions .window-btn.start,
.external-account-actions .external-account-icon-btn.start { color:#168c4a !important; }
.account-actions .window-btn.stop:hover,
.external-account-actions .external-account-icon-btn.stop:hover { color:#b14b54 !important; background:#fff1f2 !important; }
.account-actions .window-btn.start:hover,
.external-account-actions .external-account-icon-btn.start:hover { color:#118345 !important; background:#edf9f2 !important; }


/* V1.23.29 — action toolbars are permanently right-anchored.
   Keep DOM button order readable left→right; adding a button at the end keeps
   the right edge fixed and makes the whole group grow toward the left. */
.topbar-action-row,
.external-workspace-action-row {
  justify-content:flex-end !important;
  flex-wrap:nowrap !important;
}


/* V1.23.33 — editable ChatGPT reply tone / bilingual output settings. */
.gpt-style-top-btn {
  flex: 0 0 auto;
  padding: 5px 9px;
  border-color: #cfd9ff;
  background: #f5f7ff;
  color: #4258b8;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}
.gpt-style-top-btn:hover { background:#edf1ff; }
.gpt-reply-style-card { width:min(680px,94vw); }
.gpt-style-subtitle { margin:4px 0 0; color:#7b8790; font-size:11px; line-height:1.5; }
.gpt-tone-presets { display:flex; flex-wrap:wrap; gap:7px; margin:7px 0 12px; }
.gpt-tone-presets button { padding:6px 10px; font-size:12px; }
.gpt-tone-presets button.active { border-color:#6f83db; background:#eef1ff; color:#4056b4; font-weight:700; }
.gpt-reply-style-card select { width:100%; margin-top:5px; padding:9px; border:1px solid #d6e0e4; border-radius:8px; background:#fff; }
.gpt-style-save-status { min-height:18px; margin-top:8px; color:#7b8992; font-size:11px; }
.gpt-style-save-status.ok { color:#16844f; }
.gpt-style-save-status.error { color:#c84141; }

/* V1.23.43 automation foundation */
.automation-top-btn { white-space:nowrap; }
.automation-foundation-card { width:min(700px,94vw); }
.automation-foundation-summary {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin:4px 0 14px;
}
.automation-foundation-summary > div {
  border:1px solid #e2e8ec;
  border-radius:10px;
  padding:10px 12px;
  background:#f8fafb;
  display:flex;
  flex-direction:column;
  gap:4px;
}
.automation-foundation-summary span { color:#7a8790; font-size:11px; }
.automation-foundation-summary strong { color:#25343c; font-size:13px; }

.automation-day-correction { display:grid; grid-template-columns:minmax(150px,1fr) minmax(210px,1.2fr) auto; gap:8px; align-items:end; margin:8px 0 4px; }
.automation-day-correction-current { min-height:42px; border:1px solid #dde5e8; border-radius:9px; background:#f8fafb; padding:7px 9px; display:flex; flex-direction:column; justify-content:center; }
.automation-day-correction-current span { font-size:10px; color:#7a8790; }
.automation-day-correction-current strong { font-size:12px; color:#26343b; margin-top:2px; }
.automation-day-correction label { margin:0; }
.automation-day-correction select { width:100%; }
.automation-day-correction button { min-height:36px; padding:0 12px; white-space:nowrap; border-color:#9fc9b0; background:#eef9f2; color:#167445; font-weight:700; }
.automation-day-correction button:hover:not(:disabled) { background:#e0f5e8; border-color:#75b990; }
@media (max-width:720px){ .automation-day-correction{grid-template-columns:1fr;} .automation-day-correction button{width:100%;} }
.automation-check-row {
  display:flex !important;
  align-items:flex-start;
  gap:10px;
  padding:9px 10px;
  margin:8px 0;
  border:1px solid #e4e9ed;
  border-radius:9px;
  background:#fff;
}
.automation-check-row input { margin-top:2px; }
.automation-check-row span { display:flex; flex-direction:column; gap:3px; }
.automation-check-row strong { font-size:12px; color:#26343b; }
.automation-check-row small { font-size:11px; color:#77858d; line-height:1.5; }
.automation-section-divider {
  margin:8px 0 2px; padding:9px 10px; border-radius:9px; background:#f6f8fa; border:1px solid #e4e9ed; display:flex; flex-direction:column; gap:3px;
}
.automation-section-divider strong { font-size:12px; color:#26343b; }
.automation-section-divider small { font-size:11px; color:#77858d; line-height:1.45; }

/* V1.23.47 automation master switch */
.automation-top-btn.automation-off { border-color:#d8dde1; background:#f7f8f9; color:#8a959c; }
.automation-master-row {
  display:flex !important; align-items:flex-start; gap:10px; padding:12px 12px; margin:2px 0 12px;
  border:1px solid #bfd8ca; border-radius:11px; background:#f3fbf6;
}
.automation-master-row input { margin-top:2px; transform:scale(1.15); }
.automation-master-row span { display:flex; flex-direction:column; gap:4px; }
.automation-master-row strong { font-size:13px; color:#1e6f48; }
.automation-master-row small { font-size:11px; color:#64786d; line-height:1.5; }


/* V1.23.51 — two business engines: LINE relationship chat vs external lead conversion. */
.business-role-badge {
  display:inline-flex; align-items:center; justify-content:center; height:24px; padding:0 9px; border-radius:999px;
  font-size:11px; font-weight:700; white-space:nowrap; border:1px solid transparent; line-height:1;
}
.business-role-badge.relationship { color:#27734b; background:#f0faf4; border-color:#bde4cd; }
.business-role-badge.lead { color:#8a5a12; background:#fff8e8; border-color:#efd79c; }
.business-engine-hint { margin:0 0 10px; padding:9px 10px; border-radius:9px; border:1px solid #dfe8e3; background:#fafcfb; }
.business-engine-hint strong { display:block; margin-bottom:3px; font-size:10.5px; }
.business-engine-hint span { display:block; font-size:10px; line-height:1.5; color:#62706a; white-space:normal; }
.business-engine-hint.relationship { border-color:#cfe8d9; background:#f6fbf8; }
.business-engine-hint.relationship strong { color:#27734b; }
.business-engine-hint.lead { border-color:#f0dfb4; background:#fffaf0; }
.business-engine-hint.lead strong { color:#8a5a12; }
/* V1.27.43: once the lead has actually reached LINE, make the whole conversion
   card a terminal green state instead of leaving the old amber acquisition cue. */
.business-engine-hint.lead.line-added { border-color:#9bd8b6; background:#edf9f2; box-shadow:0 0 0 1px rgba(41,163,91,.04) inset; }
.business-engine-hint.lead.line-added strong { color:#16834b; }
.business-engine-hint.lead.line-added span { color:#39735a; }

/* V1.23.55 — non-LINE lead funnel data center */
.lead-funnel-center { margin-bottom:16px; scroll-margin-top:18px; }
.lead-funnel-title { align-items:center; }
.lead-funnel-head-kpis { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
.lead-funnel-head-kpis span { display:flex; align-items:baseline; gap:6px; padding:7px 10px; border:1px solid #e1e8ec; border-radius:999px; background:#f8fbf9; color:#687985; font-size:11px; }
.lead-funnel-head-kpis strong { color:#173043; font-size:15px; }
.lead-funnel-stage-grid { display:grid; grid-template-columns:repeat(7,minmax(116px,1fr)); gap:8px; margin-bottom:12px; }
.lead-funnel-stage { min-width:0; position:relative; padding:13px 11px; border:1px solid #e1e8ec; border-radius:11px; background:#f9fbfc; }
.lead-funnel-stage:not(:last-child)::after { content:'›'; position:absolute; right:-8px; top:50%; transform:translateY(-50%); z-index:2; width:15px; height:22px; display:grid; place-items:center; color:#a5b0b8; font-size:20px; background:#fff; }
.lead-funnel-stage strong { display:block; margin-bottom:3px; color:#153044; font-size:21px; }
.lead-funnel-stage span { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#667784; font-size:11px; }
.lead-funnel-stage small { display:block; margin-top:5px; color:#9aa5ae; font-size:9px; }
.lead-funnel-stage.line-added { border-color:#b9dfc9; background:#f3fbf6; }
.lead-funnel-stage.line-added strong { color:#21824e; }
.lead-funnel-stage.paused { background:#fafafa; opacity:.76; }
.lead-funnel-quick-grid { display:grid; grid-template-columns:repeat(6,minmax(110px,1fr)); gap:8px; margin-bottom:14px; }
.lead-funnel-quick-grid article { padding:10px 11px; border:1px solid #e7ecef; border-radius:9px; background:#fff; }
.lead-funnel-quick-grid span { display:block; color:#7d8c97; font-size:10px; }
.lead-funnel-quick-grid strong { display:block; margin-top:3px; color:#1b3446; font-size:18px; }
.lead-funnel-detail-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px; }
.lead-funnel-detail-grid > section { min-width:0; border:1px solid #e8edf0; border-radius:10px; overflow:hidden; background:#fbfcfd; }
.lead-funnel-subtitle { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:10px 11px; border-bottom:1px solid #e7ecef; background:#f6f9fa; }
.lead-funnel-subtitle strong { color:#263c4b; font-size:12px; }
.lead-funnel-subtitle small { color:#8b99a4; font-size:9px; }
.lead-funnel-table { max-height:258px; overflow:auto; }
.lead-funnel-row { display:grid; grid-template-columns:minmax(0,1fr) 66px 78px 72px; gap:8px; align-items:center; padding:9px 11px; border-bottom:1px solid #edf1f3; background:#fff; text-align:left; }
button.lead-funnel-row { width:100%; border-width:0 0 1px; border-radius:0; }
button.lead-funnel-row:hover { background:#f7fbf8; }
.lead-funnel-row:last-child { border-bottom:0; }
.lead-funnel-row-name { min-width:0; display:flex; align-items:center; gap:8px; }
.lead-funnel-row-name .app-dashboard-platform-icon { flex:0 0 auto; width:30px; height:30px; }
.lead-funnel-row-copy { min-width:0; }
.lead-funnel-row-copy strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#213747; font-size:11px; }
.lead-funnel-row-copy small { display:block; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#8d9aa4; font-size:9px; }
.lead-funnel-row-metric { text-align:right; }
.lead-funnel-row-metric strong { display:block; color:#213747; font-size:12px; }
.lead-funnel-row-metric small { display:block; color:#9aa5ad; font-size:8px; }
.lead-funnel-rate { color:#21824e !important; }
@media (max-width:1500px) {
  .lead-funnel-stage-grid { grid-template-columns:repeat(4,minmax(120px,1fr)); }
  .lead-funnel-stage:nth-child(4)::after { display:none; }
  .lead-funnel-quick-grid { grid-template-columns:repeat(3,minmax(110px,1fr)); }
}
@media (max-width:1050px) {
  .lead-funnel-detail-grid { grid-template-columns:1fr; }
  .lead-funnel-stage-grid { grid-template-columns:repeat(2,minmax(120px,1fr)); }
  .lead-funnel-stage::after { display:none !important; }
}

/* V1.23.63 — reliable floating CRM auto-extraction feedback + adaptive-height external CRM. */
.crm-auto-extract-toast {
  position: fixed;
  left: var(--crm-toast-left, auto);
  top: var(--crm-toast-top, 118px);
  width: var(--crm-toast-width, 292px);
  z-index: 10020;
  margin: 0;
  padding: 9px 10px;
  overflow: hidden;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-7px) scale(.985);
  pointer-events: none;
  border: 1px solid #abdcbc;
  border-radius: 10px;
  background: rgba(239, 250, 244, .98);
  box-shadow: 0 8px 24px rgba(28, 91, 58, .22);
  transition: opacity .16s ease, transform .16s ease, visibility .16s ease;
}
.crm-auto-extract-toast.show {
  opacity: 1;
  visibility: visible;
  transform: translateY(0) scale(1);
}
.crm-auto-extract-toast strong {
  display: block;
  margin-bottom: 3px;
  color: #167a45;
  font-size: 11px;
  line-height: 1.35;
}
.crm-auto-extract-toast span {
  display: block;
  color: #3f6553;
  font-size: 10px;
  line-height: 1.45;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@media (max-height: 960px) {
  .external-crm-panel {
    padding: 8px 10px 6px;
    scrollbar-gutter: stable;
  }
  .external-crm-head {
    gap: 7px;
    padding-bottom: 6px;
    margin-bottom: 6px;
  }
  .external-crm-avatar { width: 38px; height: 38px; }
  .external-crm-head strong { font-size: 12.5px; }
  .external-crm-head small { margin-top: 1px; font-size: 9px; }
  .external-crm-head-state { padding: 2px 6px; font-size: 8.5px; }
  .external-crm-collapse-btn { width: 25px; height: 25px; font-size: 18px; }
  .external-crm-source {
    padding: 5px 7px;
    margin-bottom: 5px;
    border-radius: 7px;
    font-size: 10px;
  }
  .external-crm-summary {
    margin-bottom: 5px;
    padding: 6px 7px;
    border-radius: 7px;
  }
  .external-crm-summary strong { margin-bottom: 2px; font-size: 9.5px; }
  .external-crm-summary span {
    font-size: 9px;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
  .external-crm-panel .business-engine-hint {
    margin-bottom: 5px;
    padding: 6px 7px;
    border-radius: 7px;
  }
  .external-crm-panel .business-engine-hint strong { margin-bottom: 1px; font-size: 9.5px; }
  .external-crm-panel .business-engine-hint span { font-size: 9px; line-height: 1.28; }
  .external-crm-timeline {
    gap: 4px;
    margin-bottom: 5px;
  }
  .external-crm-timeline > div {
    padding: 5px 6px;
    border-radius: 7px;
  }
  .external-crm-timeline span { font-size: 8.5px; }
  .external-crm-timeline strong { margin-top: 1px; font-size: 9px; }
  .external-crm-panel > label,
  .external-crm-grid label {
    gap: 2px;
    margin-bottom: 4px;
    font-size: 9.5px;
  }
  .external-crm-panel input,
  .external-crm-panel select,
  .external-crm-panel textarea {
    padding: 5px 7px;
    border-radius: 7px;
    font-size: 10.5px;
  }
  .external-crm-grid { gap: 5px; }
  #externalCrmNote {
    height: 68px;
    min-height: 68px;
    resize: none;
    line-height: 1.35;
  }
  .external-crm-actions-row {
    gap: 6px;
    margin-top: 0;
  }
  .external-crm-actions-row button { padding: 6px 7px; font-size: 10.5px; }
  .external-crm-save-status { margin-top: 3px; font-size: 9px; line-height: 1.2; }
  .external-crm-extract-wrap { margin-top: 5px; padding: 6px; }
  .external-crm-extract-wrap textarea { min-height: 105px; }
  .external-crm-panel .crm-auto-extract-toast.show {
    padding: 8px 9px;
  }
}

@media (max-height: 820px) {
  .external-crm-panel { padding: 6px 8px 4px; }
  .external-crm-head { padding-bottom: 4px; margin-bottom: 4px; }
  .external-crm-avatar { width: 34px; height: 34px; }
  .external-crm-source { padding: 4px 6px; margin-bottom: 4px; }
  .external-crm-summary { padding: 5px 6px; margin-bottom: 4px; }
  .external-crm-summary span { -webkit-line-clamp: 2; }
  .external-crm-panel .business-engine-hint { padding: 5px 6px; margin-bottom: 4px; }
  .external-crm-panel .business-engine-hint span {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .external-crm-timeline { gap: 3px; margin-bottom: 4px; }
  .external-crm-timeline > div { padding: 4px 5px; }
  .external-crm-panel > label,
  .external-crm-grid label { margin-bottom: 3px; }
  .external-crm-panel input,
  .external-crm-panel select,
  .external-crm-panel textarea { padding: 4px 6px; }
  #externalCrmNote { height: 52px; min-height: 52px; }
  .external-crm-actions-row button { padding: 5px 6px; }
}


/* V1.23.67 — smart external waiting-reply center. */
.external-waiting-center-btn { display:inline-flex; align-items:center; gap:5px; }
.external-waiting-center-btn > span { min-width:18px; height:18px; padding:0 5px; border-radius:10px; display:inline-flex; align-items:center; justify-content:center; background:#eef2f4; color:#56636b; font-size:10px; font-weight:800; }
.external-waiting-center-btn.active { border-color:#f1b85d !important; background:#fff8e9 !important; color:#9a5a00 !important; }
.external-waiting-center-btn.active > span { background:#f3a93a; color:#fff; }
.external-waiting-meta { display:flex; align-items:center; gap:5px; min-width:0; margin-top:2px; font-size:9.5px; line-height:16px; white-space:nowrap; overflow:hidden; }
.external-waiting-meta b { flex:0 0 auto; color:#a65f00; background:#fff3dd; border-radius:5px; padding:0 5px; font-weight:800; }
.external-waiting-meta em { flex:0 0 auto; color:#9a4b00; background:#fff7ea; border-radius:5px; padding:0 5px; font-style:normal; }
.external-waiting-meta i { min-width:0; overflow:hidden; text-overflow:ellipsis; color:#2d6a51; background:#edf8f2; border-radius:5px; padding:0 5px; font-style:normal; }
.external-waiting-center-btn.active ~ * { }
.external-workspace-page.external-sidebar-collapsed .external-waiting-meta { display:none; }


/* V1.23.68 — weighted waiting priority + visible priority badge. */
.external-waiting-priority { flex:0 0 auto; height:16px; padding:0 6px; display:inline-flex; align-items:center; justify-content:center; border-radius:5px; font-size:9px; line-height:16px; font-weight:900; font-style:normal; }
.external-waiting-priority.normal { color:#5f6c74; background:#eef2f4; }
.external-waiting-priority.high { color:#995500; background:#ffe9bf; }
.external-waiting-priority.urgent { color:#b42318; background:#ffe1de; box-shadow:inset 0 0 0 1px rgba(180,35,24,.08); }
.external-workspace-page.external-sidebar-collapsed .external-waiting-priority { display:none; }

/* V1.24.0 — LINE intent + long-term memory compact CRM intelligence. */
.crm-intelligence-strip { display:flex; align-items:center; gap:6px; min-width:0; margin:0 0 7px; }
.crm-intelligence-badge,
.crm-memory-toggle { min-width:0; height:26px; padding:0 8px; border-radius:7px; border:1px solid #dfe7e3; background:#f7faf8; color:#4b5e55; font-size:10px; font-weight:800; line-height:24px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.crm-intelligence-badge { flex:1 1 auto; }
.crm-memory-toggle { flex:0 0 auto; cursor:pointer; }
.crm-memory-toggle:hover { border-color:#9bd3b4; background:#f0fbf5; }
.crm-intelligence-badge.positive { color:#18764a; border-color:#bfe7d0; background:#effaf4; }
.crm-intelligence-badge.high { color:#a45a00; border-color:#f2d097; background:#fff7e8; }
.crm-intelligence-badge.negative { color:#8a5960; border-color:#ead7da; background:#fff6f7; }
.crm-intelligence-badge.added { color:#087a43; border-color:#9bdab9; background:#eaf9f0; }
.crm-memory-panel { margin:-2px 0 7px; padding:8px 9px; border:1px solid #dfe8e3; border-radius:8px; background:#fbfdfc; color:#45554d; font-size:10px; line-height:1.45; }
.crm-memory-panel strong { display:block; margin-bottom:4px; color:#16734a; font-size:10px; }
.crm-memory-panel > div { max-height:126px; overflow:auto; }
.crm-memory-item { display:block; padding:3px 0; border-bottom:1px dashed #e8efeb; }
.crm-memory-item:last-child { border-bottom:0; }
.line-memory-strip { justify-content:flex-end; margin-bottom:0; }
.aggregate-crm-panel .crm-memory-panel { margin:0; }
.aggregate-crm-panel .crm-intelligence-strip { margin:0; }

@media (max-height: 900px) {
  .crm-intelligence-strip { margin-bottom:4px; gap:4px; }
  .crm-intelligence-badge, .crm-memory-toggle { height:22px; padding:0 6px; line-height:20px; font-size:9px; border-radius:6px; }
  .crm-memory-panel { margin-bottom:4px; padding:6px 7px; font-size:9px; }
  .crm-memory-panel > div { max-height:90px; }
}

/* V1.25.0 team cloud sync + cross-device handoff */
.team-sync-card{width:min(980px,94vw);max-height:90vh;overflow:auto}
.team-sync-status-row{display:flex;align-items:center;gap:10px;padding:10px 0 14px;border-bottom:1px solid #e7edf2}
.team-sync-status-row #teamSyncLastSync{flex:1;color:#64748b;font-size:12px}
.team-sync-badge{display:inline-flex;align-items:center;padding:5px 10px;border-radius:999px;font-size:12px;font-weight:700;border:1px solid #d7dee6;background:#f8fafc;color:#64748b}
.team-sync-badge.online{background:#ecfdf3;border-color:#b7ebcc;color:#14864b}.team-sync-badge.error{background:#fff2f1;border-color:#ffd1cc;color:#c23b2a}
.team-sync-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px;padding:14px 0}.team-sync-wide{grid-column:1/-1}
.team-sync-actions{display:flex;justify-content:flex-end;gap:10px}.team-sync-note{margin:12px 0;padding:10px 12px;border-radius:10px;background:#fff8e8;border:1px solid #f6d995;color:#7c5b10;font-size:12px;line-height:1.55}
.team-sync-section-head{display:flex;align-items:center;justify-content:space-between;margin-top:16px;padding-top:14px;border-top:1px solid #e7edf2}.team-sync-section-head>div{display:flex;align-items:baseline;gap:10px}.team-sync-section-head small,.team-sync-section-head>span{color:#64748b;font-size:12px}
.team-sync-task-list{display:flex;flex-direction:column;gap:9px;margin-top:10px}.team-sync-task{border:1px solid #dbe4ec;border-radius:12px;padding:11px;background:#fff;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px}.team-sync-task-main strong{font-size:14px}.team-sync-task-main small{display:block;margin-top:3px;color:#64748b}.team-sync-task-meta{display:flex;gap:6px;flex-wrap:wrap;margin-top:7px}.team-sync-task-meta span{padding:3px 7px;border-radius:999px;background:#f1f5f9;font-size:11px;color:#475569}.team-sync-task-meta span.target{background:#fff5dd;color:#9a6700}.team-sync-task-actions{display:flex;align-items:center;gap:7px}.team-sync-task-actions button{white-space:nowrap}.team-sync-task.bound{background:#f0fff7;border-color:#bde8cf}.team-sync-task.accepted{background:#fffaf0;border-color:#f1d69b}
#externalTeamPendingBadge{display:inline-flex;min-width:18px;height:18px;align-items:center;justify-content:center;border-radius:999px;margin-left:4px;background:#ef4444;color:white;font-size:11px;font-weight:700}
#externalTeamPendingBadge.hidden{display:none}
@media (max-width:900px){.team-sync-grid{grid-template-columns:1fr}.team-sync-wide{grid-column:auto}.team-sync-task{grid-template-columns:1fr}.team-sync-task-actions{justify-content:flex-end}}
.team-sync-line-mapping{display:flex;flex-direction:column;gap:8px;margin-top:9px}.team-sync-line-map-row{display:grid;grid-template-columns:minmax(160px,.8fr) minmax(60px,.35fr) minmax(220px,1.2fr);align-items:center;gap:8px;padding:8px 10px;border:1px solid #e1e8ef;border-radius:10px;background:#fafcfe}.team-sync-line-map-row strong{font-size:12px}.team-sync-line-map-row span{text-align:center;color:#94a3b8}.team-sync-line-map-row input{width:100%}
.crm-cross-platform-source{margin:8px 0;padding:8px 10px;border:1px solid #bfe7d0;background:#f0fff7;border-radius:10px;font-size:12px;color:#286443;display:flex;gap:7px;align-items:flex-start}.crm-cross-platform-source strong{white-space:nowrap}.crm-cross-platform-source.hidden{display:none}

/* V1.25.2 Cloudflare Tunnel team-sync controls */
.team-sync-cloudflare{margin:14px 0 12px;padding:0 12px 12px;border:1px solid #d8e5ef;border-radius:12px;background:#f8fbff}
.team-sync-cloudflare.hidden{display:none}
.team-sync-cloudflare .field.hidden{display:none!important}
.team-sync-section-head.compact{margin-top:0;padding-top:12px;border-top:0}
.team-sync-grid.compact{padding:10px 0}
.team-sync-actions.cloudflare-actions{justify-content:flex-start;flex-wrap:wrap}
.team-sync-note.cloudflare-note{margin-bottom:0;background:#eef8ff;border-color:#cce8fa;color:#315c74}
#teamSyncCloudflareStatus{max-width:52%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* V1.27.187 — portable team/VPS connection bundle. */
.team-connection-transfer-panel{margin:14px 0 12px;padding:0 12px 12px;border:1px solid #d7e7dc;border-radius:12px;background:#f8fffa}
.team-connection-transfer-actions{justify-content:flex-start;flex-wrap:wrap;margin-top:10px}
.team-connection-transfer-actions .hidden{display:none!important}
.team-connection-transfer-note{margin:10px 0 0;background:#fff8e8;border-color:#f1d69b}
.team-connection-transfer-note.ok{background:#ecfdf3;border-color:#b7ebcc;color:#14864b}
.team-connection-transfer-note.error{background:#fff2f1;border-color:#ffd1cc;color:#c23b2a}

/* V1.25.12 — LINE handoff production health + scoped recovery console. */
.handoff-health-card{width:min(1080px,95vw);max-height:92vh;overflow:auto}
.handoff-health-toolbar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:10px 12px;border:1px solid #dbe4ec;border-radius:12px;background:#f8fafc;margin:10px 0}
.handoff-health-overall{display:inline-flex;align-items:center;padding:5px 9px;border-radius:999px;font-size:12px;font-weight:700}.handoff-health-overall.idle{background:#eef2f7;color:#64748b}.handoff-health-overall.healthy{background:#eaf8ef;color:#17653a}.handoff-health-overall.unhealthy{background:#fff0f0;color:#b42318}
#handoffHealthCheckedAt{font-size:12px;color:#64748b}
.handoff-health-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:10px 0 14px}.handoff-health-summary>div{border:1px solid #dbe4ec;border-radius:12px;background:#fff;padding:12px}.handoff-health-summary span{display:block;font-size:12px;color:#64748b}.handoff-health-summary strong{display:block;margin-top:4px;font-size:22px}.handoff-health-summary .healthy strong{color:#17653a}.handoff-health-summary .unhealthy strong{color:#b42318}
.handoff-health-section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-top:16px;margin-bottom:8px}.handoff-health-section-head strong{display:block;font-size:14px}.handoff-health-section-head small{display:block;margin-top:3px;color:#64748b}
.handoff-health-task-list{display:flex;flex-direction:column;gap:10px}.handoff-health-task{border:1px solid #dbe4ec;border-radius:13px;padding:12px;background:#fff}.handoff-health-task.ok{border-color:#bde8cf;background:#f7fff9}.handoff-health-task.bad{border-color:#f0b7b4;background:#fffafa}.handoff-health-task-head{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.handoff-health-task-head strong{font-size:14px}.handoff-health-task-head small{display:block;margin-top:3px;color:#64748b}.handoff-health-status{flex:none;padding:4px 8px;border-radius:999px;font-size:11px;font-weight:700}.handoff-health-status.ok{background:#e4f6ea;color:#17653a}.handoff-health-status.bad{background:#feeceb;color:#b42318}
.handoff-health-conversations{display:flex;gap:8px;flex-wrap:wrap;margin-top:9px}.handoff-health-conversations span{font-size:11px;padding:4px 7px;border-radius:8px;background:#eef2f7;color:#475569}
.handoff-health-checks{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.handoff-check-chip{font-size:11px;padding:4px 7px;border-radius:999px;border:1px solid transparent}.handoff-check-chip.ok{background:#eaf8ef;color:#17653a;border-color:#ccebd7}.handoff-check-chip.bad{background:#feeceb;color:#b42318;border-color:#f4c5c2}
.handoff-health-issue-text{margin-top:9px;font-size:12px;font-weight:650}.handoff-health-issue-text.ok{color:#17653a}.handoff-health-issue-text.bad{color:#b42318}.handoff-health-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:10px}.handoff-health-manual-hint{font-size:11px;color:#9a6700;background:#fff5dd;border-radius:8px;padding:5px 8px}
.handoff-health-trace-list{display:flex;flex-direction:column;gap:7px;max-height:270px;overflow:auto;border:1px solid #e5eaf0;border-radius:12px;padding:8px;background:#f8fafc}.handoff-health-trace{display:grid;grid-template-columns:150px 180px minmax(0,1fr);gap:8px;align-items:center;padding:7px 8px;border-radius:9px;background:#fff;border:1px solid #e5eaf0}.handoff-health-trace.bad{border-color:#f2c8c5;background:#fffafa}.handoff-health-trace.ok,.handoff-health-trace.recovered{border-color:#cde8d6;background:#f9fffb}.handoff-health-trace.wait{border-color:#f1d38a;background:#fffcf2}.handoff-health-trace span{font-size:11px;color:#64748b}.handoff-health-trace strong{font-size:12px}.handoff-health-trace small{font-size:11px;color:#475569;word-break:break-word}
@media (max-width:800px){.handoff-health-summary{grid-template-columns:1fr}.handoff-health-task-head{flex-direction:column}.handoff-health-trace{grid-template-columns:1fr}.handoff-health-toolbar .topbar-spacer{display:none}}

/* V1.26.0 dynamic team node roles */
.team-node-role-panel{margin:12px 0 2px;padding:12px;border:1px solid #dce6ee;border-radius:12px;background:#f8fbfd}.team-node-role-main{display:flex;align-items:center;gap:10px}.team-node-role-main>div{display:flex;flex-direction:column;gap:2px}.team-node-role-main small{font-size:11px;color:#64748b;line-height:1.45}.team-node-role-badge{display:inline-flex;padding:5px 10px;border-radius:999px;border:1px solid #d8e0e7;background:#f3f6f8;color:#64748b;font-size:12px;font-weight:800;white-space:nowrap}.team-node-role-badge.lead{background:#fff8e8;border-color:#efd79c;color:#8a5a12}.team-node-role-badge.handoff{background:#eef8ff;border-color:#c9e4f7;color:#245e81}.team-node-role-badge.dual{background:#ecfdf3;border-color:#b7ebcc;color:#14864b}.team-node-capability-list{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.team-node-capability{padding:4px 8px;border-radius:8px;background:#fff;border:1px solid #dce6ee;font-size:11px;color:#475569}.team-node-capability.lead{border-color:#efd79c;background:#fffaf0}.team-node-capability.handoff{border-color:#c9e4f7;background:#f3faff}.team-node-device-list{display:flex;flex-direction:column;gap:7px;margin-top:9px}.team-node-device-row{display:grid;grid-template-columns:minmax(140px,.8fr) minmax(120px,.6fr) minmax(0,1.6fr) auto;align-items:center;gap:8px;padding:8px 10px;border:1px solid #e1e8ef;border-radius:10px;background:#fff;font-size:11px}.team-node-device-row.offline{opacity:.58}.team-node-device-row .device-role{font-weight:800}.team-node-device-row .device-caps{color:#64748b;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.team-node-device-row .device-online{color:#14864b}.team-node-device-row.offline .device-online{color:#94a3b8}.team-sync-line-map-row .endpoint-state{font-size:10px;padding:2px 6px;border-radius:999px}.team-sync-line-map-row .endpoint-state.online{color:#14864b;background:#ecfdf3}.team-sync-line-map-row .endpoint-state.offline{color:#94a3b8;background:#f1f5f9}@media(max-width:900px){.team-node-device-row{grid-template-columns:1fr}.team-node-device-row .device-caps{white-space:normal}}

/* V1.27.1 — cloud-node cleanup + selective health-event deletion. */
.team-node-device-row{grid-template-columns:minmax(140px,.8fr) minmax(120px,.6fr) minmax(0,1.6fr) auto auto}
.team-node-device-row .device-actions{display:flex;justify-content:flex-end;align-items:center;min-width:52px}
.team-node-remove{padding:4px 9px;border:1px solid #efc5c9;border-radius:7px;background:#fff;color:#b83f4a;font-size:10px;font-weight:800;cursor:pointer}
.team-node-remove:hover{background:#fff1f2;border-color:#eaa8ae}
.team-node-self{display:inline-flex;padding:3px 7px;border-radius:999px;background:#eef8ff;color:#245e81;font-size:10px;font-weight:800}
.handoff-health-section-head{display:flex;align-items:center;justify-content:space-between;gap:12px}
.handoff-health-trace-actions{display:flex;gap:7px;align-items:center;flex-wrap:wrap}
.handoff-health-trace-actions button{padding:5px 9px;font-size:10px}
.handoff-health-trace-actions button.danger{border-color:#efc5c9;color:#b83f4a;background:#fff}
.handoff-health-trace-actions button.danger:hover{background:#fff1f2}
.handoff-health-trace{grid-template-columns:150px 180px minmax(0,1fr) auto}
.handoff-trace-row-actions{display:flex;justify-content:flex-end;align-items:center}
.handoff-trace-select{display:inline-flex;gap:5px;align-items:center;font-size:10px;color:#64748b;white-space:nowrap;cursor:pointer}
.handoff-trace-select input{width:14px;height:14px;margin:0;accent-color:#d04f58}
@media(max-width:900px){.team-node-device-row{grid-template-columns:1fr}.team-node-device-row .device-actions{justify-content:flex-start}.handoff-health-section-head{align-items:flex-start;flex-direction:column}.handoff-health-trace{grid-template-columns:1fr}.handoff-trace-row-actions{justify-content:flex-start}}
.team-sync-task-actions .team-task-delete{border-color:#efc5c9;color:#b83f4a;background:#fff}
.team-sync-task-actions .team-task-delete:hover{background:#fff1f2;border-color:#eaa8ae}

/* V1.27.4 — aggregate selection clarity.
   Keep ordinary customer rows white. Selection is shown by a crisp green edge
   and border only; never flood the entire row green. */
.external-aggregate-customer.aggregate-customer-item {
  background:#fff !important;
  border-color:#e0e7ea !important;
}
.external-aggregate-customer.aggregate-customer-item:hover {
  background:#f8fbf9 !important;
  border-color:#b8dcca !important;
}
.external-aggregate-customer.aggregate-customer-item.active {
  background:#fff !important;
  border-color:#2fbe6e !important;
  box-shadow:inset 4px 0 0 #25b965, 0 0 0 1px rgba(47,190,110,.08) !important;
}
.external-aggregate-customer.aggregate-customer-item.duplicate {
  background:#fff8f8 !important;
  border-color:#ef9a9a !important;
}
.external-aggregate-customer.aggregate-customer-item.duplicate.active {
  background:#fff8f8 !important;
  border-color:#df5353 !important;
  box-shadow:inset 4px 0 0 #df5353, 0 0 0 1px rgba(223,83,83,.08) !important;
}
.external-aggregate-customer.aggregate-customer-item.pinned:not(.duplicate) {
  background:#fffdf4 !important;
  border-color:#dfc464 !important;
}
.external-aggregate-customer.aggregate-customer-item.pinned.active:not(.duplicate) {
  background:#fffdf4 !important;
  border-color:#2fbe6e !important;
  box-shadow:inset 4px 0 0 #25b965, 0 0 0 1px rgba(47,190,110,.08) !important;
}


/* V1.27.5 — external aggregate waiting / round-robin controls beside mode tabs. */
.external-aggregate-queue-controls {
  display:inline-flex; align-items:center; gap:4px; padding:3px; border:1px solid #dce4e8;
  border-radius:9px; background:#f8faf9; white-space:nowrap;
}
.external-aggregate-queue-controls.hidden { display:none !important; }
.external-aggregate-queue-controls button {
  min-height:30px; padding:4px 8px; border-radius:7px; font-size:11px; font-weight:800;
}
.external-aggregate-queue-controls .external-waiting-center-btn > span,
.external-round-robin-btn > span {
  min-width:18px; height:18px; padding:0 5px; border-radius:10px; display:inline-flex;
  align-items:center; justify-content:center; background:#eef2f4; color:#56636b; font-size:10px; font-weight:900;
}
.external-round-robin-btn.active { border-color:#58c98a !important; background:#edf9f2 !important; color:#147d47 !important; }
.external-round-robin-btn.active > span { background:#24b965; color:#fff; }
.external-round-robin-next { border-color:#cbd8d0 !important; background:#fff !important; color:#245f42 !important; }
.external-round-robin-next:disabled { opacity:.45; cursor:not-allowed; }
@media (max-width:1120px) {
  .external-aggregate-queue-controls button { padding:4px 6px; }
  .external-round-robin-next { display:none; }
}

/* V1.27.15 — proportional responsive shell + immutable MB sidebar geometry.
   No transform/scale is used: icons keep a 1:1 aspect ratio and buttons keep
   natural text geometry while dimensions step down with the host window. */
:root {
  --external-aggregate-sidebar-width: 310px;
  --external-sidebar-collapsed-width: 86px;
  --external-aggregate-sidebar-collapsed-width: 132px;
  --external-crm-width: 320px;
}
.external-workspace-page.aggregate-active,
.external-workspace-page.global-aggregate-active {
  --external-account-sidebar-width: var(--external-aggregate-sidebar-width) !important;
}
.external-workspace-page.aggregate-active .external-account-sidebar,
.external-workspace-page.global-aggregate-active .external-account-sidebar {
  width: var(--external-aggregate-sidebar-width) !important;
}
.external-workspace-page.external-sidebar-collapsed:not(.aggregate-active):not(.global-aggregate-active) {
  --external-account-sidebar-width: var(--external-sidebar-collapsed-width) !important;
}
.external-workspace-page.external-sidebar-collapsed:not(.aggregate-active):not(.global-aggregate-active) .external-account-sidebar {
  width: var(--external-sidebar-collapsed-width) !important;
}
.external-workspace-page.aggregate-active.external-sidebar-collapsed,
.external-workspace-page.global-aggregate-active.external-sidebar-collapsed {
  --external-account-sidebar-width: var(--external-aggregate-sidebar-collapsed-width) !important;
}
.external-workspace-page.aggregate-active.external-sidebar-collapsed .external-account-sidebar,
.external-workspace-page.global-aggregate-active.external-sidebar-collapsed .external-account-sidebar {
  width: var(--external-aggregate-sidebar-collapsed-width) !important;
}
.external-crm-panel { width: var(--external-crm-width) !important; }
.external-workspace-topbar { grid-template-rows: 1fr 1fr; }
.external-workspace-topbar button,
.external-workspace-modes button,
.external-aggregate-queue-controls button {
  white-space: nowrap;
  line-height: 1.12;
}
.external-workspace-action-row {
  justify-content: flex-start;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
}
.external-workspace-action-row::-webkit-scrollbar { display: none; }
.global-app-rail-btn,
.global-app-platform-btn,
.global-app-rail-action,
.global-app-platform-btn > span,
.external-workspace-icon,
.external-aggregate-avatar,
.external-account-avatar {
  aspect-ratio: 1 / 1;
  flex-shrink: 0;
}

@media (max-width: 1500px) {
  .global-app-rail { gap: 6px; padding: 8px 5px 7px; }
  .global-app-rail-btn, .global-app-platform-btn { width: 44px; min-height: 44px; padding: 3px; border-radius: 9px; }
  .global-app-rail-btn > span { font-size: 19px; }
  .global-app-rail-btn small { font-size: 8.5px; }
  .global-app-platform-btn > span { width: 30px; height: 30px; font-size: 9.5px; }
  .global-app-rail-action { height: 39px; min-height: 39px; }
  .global-app-rail-action > span { width: 22px; height: 22px; font-size: 18px; }

  .external-workspace-topbar { padding: 0 11px; }
  .external-workspace-row { gap: 7px; }
  .external-workspace-identity { min-width: 202px; gap: 8px; }
  .external-workspace-icon { width: 36px; height: 36px; font-size: 10.5px; }
  .external-workspace-identity strong { font-size: 15px; }
  .external-workspace-version-badge { height: 17px; padding: 0 5px; font-size: 9.5px; }
  .external-workspace-identity small { max-width: 160px; font-size: 10px; }
  .external-workspace-topbar button { padding: 6px 9px; font-size: 11.5px; border-radius: 7px; }
  .external-workspace-modes { gap: 3px; padding: 2px; border-radius: 8px; }
  .external-workspace-modes button { padding: 5px 8px; }
  .external-aggregate-queue-controls { gap: 4px; }
  .external-customer-stats { font-size: 10px; gap: 5px; padding: 4px 6px; }
  .external-customer-stats strong { font-size: 11px; }

  .external-account-sidebar-head { height: 45px; padding: 0 10px; font-size: 13px; }
  .external-aggregate-tools { padding: 7px; grid-template-columns: minmax(0,1fr) 92px; }
  .external-workspace-page.aggregate-active .external-account-sidebar-list,
  .external-workspace-page.global-aggregate-active .external-account-sidebar-list { height: calc(100% - 45px - 46px); padding: 6px; }
  .external-aggregate-customer { grid-template-columns: 40px minmax(0,1fr) auto; gap: 7px; padding: 7px; margin-bottom: 4px; }
  .external-aggregate-avatar { width: 40px; height: 40px; }
  .aggregate-customer-name { font-size: 11.5px; }
  .aggregate-customer-preview { font-size: 9.5px; }
}

@media (max-width: 1300px) {
  .global-app-rail { gap: 5px; padding: 7px 4px 6px; }
  .global-app-rail-btn, .global-app-platform-btn { width: 41px; min-height: 41px; border-radius: 8px; }
  .global-app-rail-btn > span { font-size: 17px; }
  .global-app-rail-btn small { font-size: 8px; }
  .global-app-platform-btn > span { width: 28px; height: 28px; font-size: 9px; }
  .global-app-rail-action { height: 36px; min-height: 36px; }
  .global-app-rail-action > span { width: 20px; height: 20px; font-size: 17px; }

  .external-workspace-topbar { padding: 0 8px; }
  .external-workspace-row { gap: 5px; }
  .external-workspace-identity { min-width: 180px; gap: 7px; }
  .external-workspace-icon { width: 33px; height: 33px; font-size: 9.5px; }
  .external-workspace-identity strong { font-size: 13.5px; }
  .external-workspace-version-badge { height: 16px; padding: 0 4px; font-size: 8.5px; }
  .business-role-badge { padding-left: 6px; padding-right: 6px; font-size: 9px; }
  .external-workspace-identity small { max-width: 132px; font-size: 9px; }
  .external-workspace-topbar button { padding: 5px 7px; font-size: 10.5px; border-radius: 7px; }
  .external-workspace-modes button { padding: 4px 7px; }
  .external-waiting-center-btn > span,
  .external-round-robin-btn > span { min-width: 16px; height: 16px; padding: 0 4px; font-size: 9px; }
  .external-customer-stats { font-size: 9px; gap: 4px; padding: 3px 5px; }
  .external-customer-stats strong { font-size: 10px; }
  .external-customer-stats .customer-stats-scope { max-width: 62px; }
  .external-workspace-status { max-width: 220px; font-size: 10px; }

  .external-account-sidebar-head { height: 42px; padding: 0 9px; font-size: 12px; }
  .external-account-sidebar-head span { min-width: 20px; height: 20px; font-size: 10px; }
  .external-sidebar-toggle { width: 26px; height: 26px; padding: 0; }
  .external-aggregate-tools { padding: 6px; grid-template-columns: minmax(0,1fr) 84px; gap: 5px; }
  .external-aggregate-tools input, .external-aggregate-tools select { padding: 6px 7px; font-size: 10px; }
  .external-workspace-page.aggregate-active .external-account-sidebar-list,
  .external-workspace-page.global-aggregate-active .external-account-sidebar-list { height: calc(100% - 42px - 43px); padding: 5px; }
  .external-aggregate-customer { grid-template-columns: 37px minmax(0,1fr) auto; gap: 6px; padding: 6px; margin-bottom: 4px; border-radius: 9px; }
  .external-aggregate-avatar { width: 37px; height: 37px; }
  .aggregate-customer-name { font-size: 10.5px; }
  .aggregate-customer-account, .aggregate-customer-preview { font-size: 9px; }
  .aggregate-customer-time { font-size: 8.5px; }
  .aggregate-customer-service-status, .aggregate-customer-tag { font-size: 8px; line-height: 14px; }

  .external-crm-panel { padding: 10px; }
  .external-crm-avatar { width: 42px; height: 42px; }
  .external-crm-head strong { max-width: 170px; font-size: 12.5px; }
}

@media (max-width: 1120px) {
  .global-app-rail-btn, .global-app-platform-btn { width: 38px; min-height: 38px; }
  .global-app-platform-btn > span { width: 26px; height: 26px; font-size: 8.5px; }
  .global-app-rail-btn > span { font-size: 16px; }
  .global-app-rail-btn small { font-size: 7.5px; }
  .global-app-rail-action { height: 34px; min-height: 34px; }

  .external-workspace-topbar { padding: 0 6px; }
  .external-workspace-row { gap: 4px; }
  .external-workspace-identity { min-width: 158px; gap: 6px; }
  .external-workspace-icon { width: 30px; height: 30px; font-size: 9px; }
  .external-workspace-identity strong { font-size: 12.5px; }
  .external-workspace-version-badge { font-size: 8px; }
  .external-workspace-identity small { max-width: 110px; font-size: 8.5px; }
  .external-workspace-topbar button { padding: 4px 6px; font-size: 9.5px; border-radius: 6px; }
  .external-workspace-modes { padding: 2px; }
  .external-workspace-modes button { padding: 4px 6px; }
  .external-customer-stats .customer-stats-scope { display: none; }
  .external-customer-stats { font-size: 8.5px; }
  .external-workspace-status { display: none; }
  .external-workspace-primary-row .topbar-spacer { min-width: 2px; }

  .external-account-sidebar-head { height: 40px; padding: 0 8px; font-size: 11.5px; }
  .external-aggregate-tools { padding: 5px; grid-template-columns: minmax(0,1fr) 76px; }
  .external-workspace-page.aggregate-active .external-account-sidebar-list,
  .external-workspace-page.global-aggregate-active .external-account-sidebar-list { height: calc(100% - 40px - 41px); padding: 5px; }
  .external-aggregate-customer { grid-template-columns: 34px minmax(0,1fr) auto; gap: 5px; padding: 5px; }
  .external-aggregate-avatar { width: 34px; height: 34px; }
  .aggregate-customer-name { font-size: 10px; }
  .external-waiting-meta { gap: 3px; font-size: 8px; }

  .external-crm-panel { padding: 8px; }
  .external-crm-avatar { width: 38px; height: 38px; }
  .external-crm-head strong { max-width: 150px; font-size: 11.5px; }
  .external-crm-panel input, .external-crm-panel select, .external-crm-panel textarea { padding: 6px; font-size: 10px; }
}

@media (max-width: 980px) {
  .global-app-rail { gap: 4px; padding: 6px 3px 5px; }
  .global-app-rail-btn, .global-app-platform-btn { width: 35px; min-height: 35px; border-radius: 7px; }
  .global-app-platform-btn > span { width: 24px; height: 24px; font-size: 8px; }
  .global-app-rail-btn > span { font-size: 15px; }
  .global-app-rail-btn small { font-size: 7px; }
  .global-app-rail-action { height: 31px; min-height: 31px; }
  .global-app-rail-action > span { width: 18px; height: 18px; font-size: 15px; }

  .external-workspace-identity { min-width: 138px; }
  .external-workspace-icon { width: 28px; height: 28px; }
  .external-workspace-identity strong { font-size: 11.5px; }
  .external-workspace-version-badge { display: none; }
  .external-workspace-identity small { display: none; }
  .business-role-badge { display: none; }
  .external-workspace-topbar button { padding: 4px 5px; font-size: 9px; }
  .external-customer-stats { display: none; }
  .gpt-style-top-btn { min-width: 0 !important; }
  .external-workspace-action-row { gap: 4px; }

  .external-account-sidebar-head { height: 38px; padding: 0 7px; font-size: 11px; }
  .external-aggregate-tools { padding: 4px; grid-template-columns: minmax(0,1fr) 70px; gap: 4px; }
  .external-aggregate-tools input, .external-aggregate-tools select { padding: 5px 6px; font-size: 9px; }
  .external-workspace-page.aggregate-active .external-account-sidebar-list,
  .external-workspace-page.global-aggregate-active .external-account-sidebar-list { height: calc(100% - 38px - 37px); padding: 4px; }
  .external-aggregate-customer { grid-template-columns: 32px minmax(0,1fr) auto; gap: 5px; padding: 5px 4px; margin-bottom: 3px; border-radius: 8px; }
  .external-aggregate-avatar { width: 32px; height: 32px; }
  .aggregate-customer-name { font-size: 9.5px; }
  .aggregate-customer-account, .aggregate-customer-preview { font-size: 8.5px; }
  .aggregate-customer-time { font-size: 8px; }

  .external-crm-panel { padding: 7px; }
  .external-crm-head { gap: 6px; padding-bottom: 6px; margin-bottom: 6px; }
  .external-crm-avatar { width: 34px; height: 34px; }
  .external-crm-head strong { max-width: 132px; font-size: 11px; }
  .external-crm-head small { font-size: 8.5px; }
  .external-crm-grid { grid-template-columns: 1fr; }
}

/* V1.27.83 — GPT / Meta stability diagnostics */
.stability-settings-card{display:flex;align-items:center;gap:14px;justify-content:space-between;padding:14px 16px}
.stability-settings-copy{display:flex;flex-direction:column;gap:4px;min-width:0}
.stability-settings-copy strong{font-size:13px}
.stability-settings-copy span{font-size:11px;color:var(--muted,#7a8494);line-height:1.5}
.stability-diagnostics-card{width:min(980px,calc(100vw - 44px));max-height:88vh;overflow:auto}
.stability-diagnostics-toolbar{display:flex;align-items:center;gap:8px;padding:10px 0 14px;border-bottom:1px solid rgba(128,140,160,.18)}
.stability-system-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px;padding:14px 0 8px}
.stability-system-card{min-width:0;padding:11px 12px;border:1px solid rgba(128,140,160,.18);border-radius:11px;background:rgba(128,140,160,.045);box-shadow:0 1px 0 rgba(255,255,255,.5) inset}
.stability-system-card-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:5px}
.stability-system-card-head strong{font-size:11.5px}.stability-system-card-head span{font-size:9px;font-weight:800;padding:3px 7px;border-radius:999px;background:rgba(128,140,160,.12);white-space:nowrap}
.stability-system-card p{margin:0 0 5px;font-size:10px;color:var(--text,#23323a);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stability-system-card small{display:block;font-size:9px;line-height:1.45;color:var(--muted,#7a8494);min-height:26px;word-break:break-word}
.stability-system-card.ok{border-color:rgba(38,166,91,.25);background:rgba(38,166,91,.06)}.stability-system-card.ok .stability-system-card-head span{background:rgba(38,166,91,.14);color:#148547}
.stability-system-card.warn{border-color:rgba(229,156,32,.3);background:rgba(229,156,32,.07)}.stability-system-card.warn .stability-system-card-head span{background:rgba(229,156,32,.16);color:#ad6c00}
.stability-system-card.error{border-color:rgba(220,72,72,.3);background:rgba(220,72,72,.07)}.stability-system-card.error .stability-system-card-head span{background:rgba(220,72,72,.14);color:#b93939}
.stability-system-card.idle{opacity:.8}.stability-system-card.pending .stability-system-card-head span{animation:native-api-health-pulse 1.2s ease-in-out infinite}
.stability-diag-gpt-head{margin-top:10px!important;padding-top:10px;border-top:1px solid rgba(128,140,160,.14)}.stability-diag-gpt-head .stability-diag-badge{margin-left:auto}.stability-diag-gpt-head small{max-width:52%}
.stability-diag-badge{display:inline-flex;align-items:center;min-height:26px;padding:0 10px;border-radius:999px;font-size:11px;font-weight:700;background:rgba(128,140,160,.14)}
.stability-diag-badge.healthy{background:rgba(38,166,91,.14);color:#148547}
.stability-diag-badge.pending{background:rgba(229,156,32,.16);color:#ad6c00}
.stability-diag-badge.error{background:rgba(220,72,72,.14);color:#b93939}
.stability-diag-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:14px 0}
.stability-diag-grid>div{display:flex;flex-direction:column;gap:5px;min-width:0;padding:12px;border:1px solid rgba(128,140,160,.18);border-radius:10px;background:rgba(128,140,160,.05)}
.stability-diag-grid span{font-size:10px;color:var(--muted,#7a8494)}
.stability-diag-grid strong{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stability-diag-grid small{font-size:9.5px;color:var(--muted,#7a8494);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stability-diag-section-head{display:flex;align-items:baseline;gap:8px;margin:4px 0 8px}
.stability-diag-section-head strong{font-size:12px}.stability-diag-section-head small{font-size:10px;color:var(--muted,#7a8494)}
.stability-diag-event-list{display:flex;flex-direction:column;gap:6px;max-height:260px;overflow:auto;border:1px solid rgba(128,140,160,.16);border-radius:10px;padding:8px}
.stability-diag-event{display:grid;grid-template-columns:76px 230px minmax(0,1fr);gap:8px;align-items:center;padding:7px 8px;border-radius:7px;background:rgba(128,140,160,.06);font-size:10px}
.stability-diag-event.ok{background:rgba(38,166,91,.08)}.stability-diag-event.bad{background:rgba(220,72,72,.08)}
.stability-diag-event span{color:var(--muted,#7a8494)}.stability-diag-event strong{font-size:10px}.stability-diag-event small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.stability-diag-raw{margin-top:10px}.stability-diag-raw summary{cursor:pointer;font-size:10.5px;color:var(--muted,#7a8494)}
.stability-diag-raw pre{max-height:250px;overflow:auto;white-space:pre-wrap;word-break:break-word;font-size:9.5px;line-height:1.45;background:rgba(0,0,0,.035);padding:10px;border-radius:8px}
@media(max-width:1100px){.stability-system-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stability-diag-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stability-diag-event{grid-template-columns:68px 190px minmax(0,1fr)}}

/* V1.27.86 — Meta + LINE official native API inbox ---------------------- */
.global-app-rail-btn.native-api .rail-api-icon {
  width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
  background:#14293a; color:#fff; font-size:10px; font-weight:900; letter-spacing:.2px;
}
.global-app-rail-btn.native-api.active .rail-api-icon { background:#20b966; }
.native-api-page {
  position:fixed; z-index:29; left:var(--global-app-rail-width); right:0; top:0; bottom:0;
  background:#edf2f4; --native-api-toolbar-height:104px; --native-api-list-width:308px; --native-api-crm-width:336px;
}
.native-api-page.hidden { display:none; }
.native-api-toolbar {
  position:absolute; left:0; right:0; top:0; height:var(--native-api-toolbar-height); background:#fff;
  border-bottom:1px solid #dce5e9; display:flex; align-items:center; gap:12px; padding:0 14px;
}
.native-api-title { display:flex; align-items:center; gap:10px; min-width:260px; }
.native-api-logo { width:38px; height:38px; border-radius:11px; display:grid; place-items:center; background:#14293a; color:#fff; font-size:11px; font-weight:900; }
.native-api-title strong { display:block; font-size:15px; color:#1f303b; }
.native-api-title small { display:block; margin-top:3px; font-size:9.5px; color:#839099; white-space:nowrap; }
.native-api-health { display:flex; gap:5px; flex:0 0 auto; }
.native-api-health-chip { padding:4px 7px; border-radius:999px; background:#f0f3f5; color:#6d7c85; font-size:9px; font-weight:700; white-space:nowrap; }
.native-api-health-chip.ok { background:#eaf9f1; color:#168b4b; }
.native-api-health-chip.error { background:#fff0f0; color:#bd4545; }
.native-api-toolbar-actions { margin-left:auto; min-width:0; flex:1 1 auto; display:flex; flex-direction:column; justify-content:center; align-items:stretch; gap:6px; }
.native-api-toolbar-row { display:flex; align-items:center; justify-content:flex-end; gap:5px; min-width:0; flex-wrap:nowrap; }
.native-api-toolbar-row button { flex:0 0 auto; }
.native-api-toolbar-actions button { padding:6px 8px; font-size:10.5px; white-space:nowrap; }
.native-api-master-toggle{font-weight:900!important;min-width:58px;border-color:#b9e4ca!important;background:#eaf9f1!important;color:#168b4b!important}
.native-api-master-toggle.off{border-color:#e0c6c6!important;background:#fff0f0!important;color:#b84a4a!important}
.native-api-page.api-disabled .native-api-health-chip{background:#f1f3f4;color:#8b959b}
.native-api-page.api-disabled .native-api-logo{background:#7c8991}
.native-api-page.api-disabled #nativeApiCustomerList{opacity:.74}
.native-api-diagnostics-btn{display:inline-flex;align-items:center;gap:5px;border-color:rgba(128,140,160,.24)!important}
.native-api-diagnostics-dot{width:7px;height:7px;border-radius:50%;background:#9aa5ad;box-shadow:0 0 0 2px rgba(154,165,173,.12)}
.native-api-diagnostics-btn.ok{background:#ecfaf2!important;color:#168b4b!important;border-color:#c8ead6!important}
.native-api-diagnostics-btn.ok .native-api-diagnostics-dot{background:#25a45c;box-shadow:0 0 0 2px rgba(37,164,92,.14)}
.native-api-diagnostics-btn.warn{background:#fff8e8!important;color:#a36a00!important;border-color:#f2dfaf!important}
.native-api-diagnostics-btn.warn .native-api-diagnostics-dot{background:#d99819;box-shadow:0 0 0 2px rgba(217,152,25,.14)}
.native-api-diagnostics-btn.error{background:#fff0f0!important;color:#bd4545!important;border-color:#efc8c8!important}
.native-api-diagnostics-btn.error .native-api-diagnostics-dot{background:#d64a4a;box-shadow:0 0 0 2px rgba(214,74,74,.14)}
.native-api-diagnostics-btn.pending .native-api-diagnostics-dot{animation:native-api-health-pulse 1.2s ease-in-out infinite}
@keyframes native-api-health-pulse{0%,100%{opacity:.45}50%{opacity:1}}
.native-api-status { display:none; max-width:none; overflow:visible; text-overflow:clip; white-space:nowrap; color:#74828a; font-size:10px; }
.native-api-shell { position:absolute; left:0; right:0; top:var(--native-api-toolbar-height); bottom:0; display:grid; grid-template-columns:var(--native-api-list-width) minmax(360px,1fr) var(--native-api-crm-width); min-height:0; }
.native-api-customers { min-width:0; min-height:0; height:100%; background:#fff; border-right:1px solid #dce5e9; display:flex; flex-direction:column; overflow:hidden; }
.native-api-customer-head { min-height:50px; display:flex; align-items:center; justify-content:space-between; gap:8px; padding:8px 10px; border-bottom:1px solid #edf1f3; }
.native-api-customer-head strong { display:block; font-size:13px; }
.native-api-customer-head small { display:block; margin-top:2px; color:#89959c; font-size:9px; }
.native-api-customer-head button { padding:5px 7px; font-size:9.5px; }
.native-api-customer-head button.active { background:#fff2df; color:#9a6116; border-color:#f0cc96; }
.native-api-customer-total { flex:0 0 auto; }
.native-api-today-new-stat {
  flex:0 0 auto; min-width:62px; padding:4px 7px; border:1px solid #cfe8dc; border-radius:8px;
  background:#f5fbf8; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px; line-height:1.05;
}
.native-api-today-new-stat span { font-size:9px; color:#61746a; white-space:nowrap; }
.native-api-today-new-stat strong { font-size:13px; color:#178653; font-variant-numeric:tabular-nums; }
.native-api-today-new-stat.pending strong { color:#7a8790; }
.native-api-filters { display:grid; grid-template-columns:repeat(3,1fr); gap:4px; padding:7px 8px 4px; }
.native-api-filters button { padding:5px 4px; border-color:transparent; background:#f5f7f8; color:#6b7982; font-size:9.5px; }
.native-api-filters button.active { background:#e8f8ef; color:#168c4a; border-color:#b8e2c9; font-weight:800; }
.native-api-stage-groups {
  display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:5px; padding:5px 8px 3px; align-items:stretch;
}
.native-api-stage-groups button {
  min-width:0; min-height:28px; padding:6px 6px; border:1px solid transparent; border-radius:8px; background:#f6f8f9; color:#65747d;
  font-size:9.6px; font-weight:800; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:flex; align-items:center; justify-content:center; gap:4px;
}
.native-api-stage-groups button:hover { border-color:#cdd8dd; background:#f1f5f6; }
.native-api-stage-groups button span {
  min-width:16px; height:16px; padding:0 4px; border-radius:999px; display:inline-grid; place-items:center;
  background:#e8edef; color:#74828a; font-size:8px; font-variant-numeric:tabular-nums; line-height:1;
}
.native-api-stage-groups button.active { box-shadow:inset 0 0 0 1px rgba(0,0,0,.03); }
.native-api-stage-groups button[data-native-api-stage-group="new"] { border-color:#c8ead7; background:#f1fbf5; color:#177a49; }
.native-api-stage-groups button[data-native-api-stage-group="new"] span { background:#d9f3e4; color:#177a49; }
.native-api-stage-groups button[data-native-api-stage-group="new"].active { border-color:#84d1aa; background:#dff7ea; color:#116f42; }
.native-api-stage-groups button[data-native-api-stage-group="new"].active span { background:#1fb46a; color:#fff; }
.native-api-stage-groups button[data-native-api-stage-group="active"] { border-color:#bfe7cf; background:#ecfaf2; color:#137b4a; }
.native-api-stage-groups button[data-native-api-stage-group="active"] span { background:#d4f1e0; color:#137b4a; }
.native-api-stage-groups button[data-native-api-stage-group="active"].active { border-color:#67c78f; background:#d7f3e3; color:#0f6d40; }
.native-api-stage-groups button[data-native-api-stage-group="active"].active span { background:#18aa61; color:#fff; }
.native-api-stage-groups button[data-native-api-stage-group="invited"] { border-color:#bfdcf2; background:#f1f8fd; color:#2a6da8; }
.native-api-stage-groups button[data-native-api-stage-group="invited"] span { background:#dbeaf7; color:#2a6da8; }
.native-api-stage-groups button[data-native-api-stage-group="invited"].active { border-color:#81b9e2; background:#e0eef9; color:#235f94; }
.native-api-stage-groups button[data-native-api-stage-group="invited"].active span { background:#4e9ad6; color:#fff; }
.native-api-stage-groups button[data-native-api-stage-group="added"] { border-color:#bfe4ea; background:#eef9fb; color:#19758a; }
.native-api-stage-groups button[data-native-api-stage-group="added"] span { background:#d7eef3; color:#19758a; }
.native-api-stage-groups button[data-native-api-stage-group="added"].active { border-color:#7bc6d4; background:#dbf1f5; color:#126a7e; }
.native-api-stage-groups button[data-native-api-stage-group="added"].active span { background:#2ca3b7; color:#fff; }
.native-api-stage-groups button[data-native-api-stage-group="paused"] { border-color:#d8dee2; background:#f5f7f8; color:#6d7980; }
.native-api-stage-groups button[data-native-api-stage-group="paused"] span { background:#e6eaed; color:#6d7980; }
.native-api-stage-groups button[data-native-api-stage-group="paused"].active { border-color:#c4ccd1; background:#eceff1; color:#606b72; }
.native-api-stage-groups button[data-native-api-stage-group="paused"].active span { background:#7b878e; color:#fff; }
.native-api-search { margin:4px 8px 7px; width:calc(100% - 16px); padding:8px 9px; border:1px solid #dbe3e7; border-radius:8px; outline:none; font-size:10.5px; }
.native-api-search:focus { border-color:#6ac98f; box-shadow:0 0 0 2px rgba(47,198,109,.08); }
.native-api-stage-badge { display:inline-flex; align-items:center; max-width:92px; margin-left:5px; padding:1px 5px; border-radius:999px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; vertical-align:middle; font-size:7.5px; font-weight:700; }
.native-api-stage-badge { background:#eef4ff; color:#4568a8; border:1px solid #d5e2ff; }
.native-api-stage-badge.line-added { background:#e8f8ef; color:#16864c; border-color:#bfe8d0; }
.native-api-stage-badge.paused { background:#f3f4f5; color:#7d878d; border-color:#dde1e3; }
.native-api-customer-list { min-height:0; height:0; flex:1 1 0; overflow-x:hidden; overflow-y:auto; overscroll-behavior:contain; scrollbar-gutter:stable; padding:4px 7px 18px; }
.native-api-customer { width:100%; display:grid; grid-template-columns:44px minmax(0,1fr) auto; gap:8px; align-items:center; padding:8px; margin-bottom:5px; border:1px solid #e2e8eb; border-radius:10px; background:#fff; text-align:left; position:relative; }
.native-api-customer:hover { background:#f6faf8; border-color:#b7ddc7; }
.native-api-customer.active { background:#eaf8f0; border-color:#54c67f; box-shadow:inset 3px 0 0 #20b966; }
.native-api-customer.waiting .native-api-customer-name::after { content:'待'; display:inline-grid; place-items:center; width:16px; height:16px; margin-left:5px; border-radius:50%; background:#fff0d8; color:#a86a17; font-size:8px; vertical-align:1px; }
.native-api-avatar { width:42px; height:42px; border-radius:50%; overflow:hidden; display:grid; place-items:center; background:#eaf0f3; color:#586974; font-size:11px; font-weight:900; flex:0 0 auto; }
.native-api-avatar.large { width:48px; height:48px; }
.native-api-avatar.facebook { background:#e8f1ff; color:#1877f2; }
.native-api-avatar.line { background:#e7fbef; color:#06a947; }
.native-api-avatar img { width:100%; height:100%; object-fit:cover; display:block; }
.native-api-customer-copy { min-width:0; }
.native-api-customer-name { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#22343f; font-size:11.5px; }
.native-api-customer-preview { display:block; margin-top:3px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#78868f; font-size:9.5px; }
.native-api-customer-source { display:block; margin-top:3px; color:#90a0a9; font-size:8.5px; }
.native-api-draft-badge { display:inline-block; margin-left:5px; padding:1px 4px; border-radius:999px; background:#fff4cf; color:#a06a00; font-size:7.5px; font-weight:800; vertical-align:1px; }
.native-api-customer-side { align-self:stretch; display:flex; flex-direction:column; align-items:flex-end; justify-content:space-between; gap:5px; }
.native-api-customer-time { color:#9aa5ab; font-size:8px; white-space:nowrap; }
.native-api-platform-badge { padding:2px 4px; border-radius:5px; font-size:8px; font-weight:800; }
.native-api-platform-badge.facebook { background:#eaf2ff; color:#1877f2; }
.native-api-platform-badge.line { background:#e9faef; color:#099b43; }
.native-api-empty { padding:32px 12px; text-align:center; color:#89969e; font-size:11px; line-height:1.6; }
.native-api-chat { min-width:0; min-height:0; background:#f3f6f7; display:grid; grid-template-rows:64px minmax(0,1fr) auto; }
.native-api-chat-head { background:#fff; border-bottom:1px solid #dfe6e9; display:flex; align-items:center; gap:10px; padding:8px 14px; }
.native-api-chat-identity { min-width:0; flex:1; }
.native-api-chat-identity strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#1f303a; font-size:14px; }
.native-api-chat-identity small { display:block; margin-top:3px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#85929a; font-size:9.5px; }
.native-api-chat-state { padding:4px 7px; border-radius:999px; background:#f0f3f5; color:#73818a; font-size:9px; }
.native-api-chat-state.waiting { background:#fff0db; color:#9b6319; }
.native-api-messages { min-height:0; overflow:auto; padding:18px 18px 24px; scroll-behavior:auto; overflow-anchor:none; }
.native-api-chat-placeholder { height:100%; display:grid; place-content:center; justify-items:center; gap:6px; text-align:center; color:#84929a; }
.native-api-chat-placeholder strong { color:#5d6c75; font-size:15px; }
.native-api-chat-placeholder span { max-width:430px; font-size:10.5px; line-height:1.7; }
.native-api-message-row { display:flex; margin:8px 0; }
.native-api-message-row.me { justify-content:flex-end; }
.native-api-message-bubble { max-width:min(72%,720px); padding:9px 11px; border-radius:13px; background:#fff; border:1px solid #e0e6e9; box-shadow:0 1px 2px rgba(23,42,54,.04); }
.native-api-message-row.me .native-api-message-bubble { background:#dcf7e8; border-color:#b9e7cc; }
.native-api-message-original { white-space:pre-wrap; word-break:break-word; color:#24343d; font-size:12px; line-height:1.55; }
.native-api-message-translation { margin-top:6px; padding-top:6px; border-top:1px dashed rgba(89,120,104,.25); white-space:pre-wrap; word-break:break-word; color:#52645b; font-size:10.5px; line-height:1.5; }
.native-api-message-translation.loading { color:#98a39d; font-style:italic; }
.native-api-message-translation.error { color:#b25b5b; }
.native-api-message-translation.error button { border:0; background:transparent; padding:0; color:#b25b5b; font:inherit; cursor:pointer; text-decoration:underline; text-underline-offset:2px; }
.native-api-message-translation.error button:hover { color:#8f3d3d; }
.native-api-message-meta { margin-top:4px; text-align:right; color:#98a3aa; font-size:8px; }
.native-api-message-media-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px; margin-top:6px; max-width:420px; }
.native-api-message-media-grid.single { grid-template-columns:minmax(0,1fr); max-width:320px; }
.native-api-media-thumb { appearance:none; border:0; padding:0; margin:0; border-radius:10px; overflow:hidden; background:#eef3f5; cursor:zoom-in; min-width:120px; }
.native-api-media-thumb img { display:block; width:100%; max-height:280px; object-fit:cover; background:#eef3f5; }
.native-api-message-file-list { display:flex; flex-wrap:wrap; gap:5px; margin-top:6px; }
.native-api-message-file-chip { padding:5px 8px; border-radius:8px; background:rgba(122,142,151,.12); color:#53636b; font-size:10px; }
.native-api-media-preview { position:fixed; inset:0; z-index:12000; display:flex; align-items:center; justify-content:center; background:rgba(8,15,20,.82); padding:28px; }
.native-api-media-preview.hidden { display:none !important; }
.native-api-media-preview-stage { max-width:min(92vw,1200px); max-height:86vh; display:flex; align-items:center; justify-content:center; }
.native-api-media-preview-stage img { max-width:100%; max-height:86vh; object-fit:contain; border-radius:12px; box-shadow:0 18px 60px rgba(0,0,0,.35); }
.native-api-media-preview-close { position:absolute; top:18px; right:22px; width:42px; height:42px; border:1px solid rgba(255,255,255,.25); border-radius:50%; background:rgba(255,255,255,.1); color:#fff; font-size:28px; line-height:1; cursor:pointer; }
.native-api-media-preview-name { position:absolute; left:24px; right:24px; bottom:16px; text-align:center; color:#fff; font-size:12px; text-shadow:0 1px 2px rgba(0,0,0,.5); }
.native-api-clipboard-preview { position:fixed; inset:0; z-index:12100; display:flex; align-items:center; justify-content:center; background:rgba(8,15,20,.76); padding:28px; backdrop-filter:blur(2px); }
.native-api-clipboard-preview.hidden { display:none !important; }
.native-api-clipboard-card { width:min(860px,94vw); max-height:90vh; display:grid; grid-template-rows:auto minmax(0,1fr) auto; overflow:hidden; border:1px solid rgba(255,255,255,.32); border-radius:16px; background:#fff; box-shadow:0 24px 80px rgba(0,0,0,.36); }
.native-api-clipboard-head { display:flex; align-items:center; justify-content:space-between; gap:14px; padding:14px 16px; border-bottom:1px solid #e5ecef; }
.native-api-clipboard-head strong { display:block; color:#22323a; font-size:15px; }
.native-api-clipboard-head small { display:block; margin-top:3px; color:#7d8b92; font-size:10px; }
.native-api-clipboard-head button { width:34px; height:34px; border:0; border-radius:50%; background:#eef3f5; color:#52616a; font-size:22px; cursor:pointer; }
.native-api-clipboard-grid { min-height:220px; overflow:auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); align-items:center; gap:10px; padding:14px; background:#f4f7f8; }
.native-api-clipboard-grid figure { min-width:0; margin:0; padding:8px; border:1px solid #dfe7ea; border-radius:12px; background:#fff; }
.native-api-clipboard-grid img { display:block; width:100%; height:min(48vh,420px); object-fit:contain; border-radius:8px; background:#eef3f5; }
.native-api-clipboard-grid figcaption { margin-top:7px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#718087; font-size:9.5px; text-align:center; }
.native-api-clipboard-foot { display:flex; align-items:center; gap:9px; padding:12px 14px; border-top:1px solid #e5ecef; }
.native-api-clipboard-foot small { flex:1; color:#7f8d94; font-size:9.5px; }
.native-api-clipboard-foot button { min-width:88px; padding:8px 12px; }
.native-api-composer { background:#fff; border-top:1px solid #dce5e9; padding:9px 12px 10px; }
.native-api-composer textarea { width:100%; min-height:64px; max-height:180px; resize:vertical; padding:10px; border:1px solid #d6e0e4; border-radius:10px; outline:none; line-height:1.5; }
.native-api-composer textarea:focus { border-color:#61c68a; box-shadow:0 0 0 2px rgba(47,198,109,.08); }
.native-api-composer-foot { display:flex; align-items:center; gap:10px; margin-top:7px; }
.native-api-composer-foot small { flex:1; color:#839098; font-size:9px; }
.native-api-composer-foot button { min-width:82px; }
.native-api-composer-foot .native-api-image-btn { min-width:58px; border:1px solid #cbd8dd; background:#fff; color:#40545f; }
.native-api-composer-foot .native-api-image-btn:hover { border-color:#61c68a; color:#16824a; background:#f5fff9; }
.native-api-composer-foot .native-api-image-btn:disabled { opacity:.55; cursor:wait; }

.native-api-crm { min-width:0; min-height:0; background:#fff; border-left:1px solid #dce5e9; display:grid; grid-template-rows:58px minmax(0,1fr) 54px; }
.native-api-crm-head { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:9px 12px; border-bottom:1px solid #edf1f3; }
.native-api-crm-head strong { display:block; font-size:13px; }
.native-api-crm-head small { display:block; margin-top:3px; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#8a969d; font-size:9px; }
#nativeApiCrmSaveState { color:#7b898f; font-size:9px; white-space:nowrap; }
#nativeApiCrmSaveState.saved { color:#158b49; }
.native-api-crm-body { min-height:0; overflow:auto; padding:8px 12px 14px; }
.native-api-crm-body label { display:block; margin:7px 0; color:#6b7a83; font-size:9.5px; }
.native-api-crm-body input, .native-api-crm-body select, .native-api-crm-body textarea { width:100%; margin-top:4px; padding:7px 8px; border:1px solid #d8e1e5; border-radius:7px; background:#fff; color:#263641; outline:none; font-size:10.5px; }
.native-api-crm-body textarea { resize:vertical; line-height:1.5; }
.native-api-crm-two { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.native-api-crm-foot { display:flex; align-items:center; gap:8px; padding:8px 12px; border-top:1px solid #edf1f3; }
.native-api-crm-foot small { flex:1; color:#89969d; font-size:8.5px; line-height:1.35; }
.native-api-crm-foot button { padding:7px 10px; font-size:10px; }
body.shell-native-api .topbar,
body.shell-native-api .leftbar,
body.shell-native-api .aggregate-crm-panel,
body.shell-native-api .aggregate-view,
body.shell-native-api .view-placeholder,
body.shell-native-api #appCenterPage,
body.shell-native-api #externalWorkspacePage { display:none !important; }
body:not(.shell-native-api) #nativeApiPage { display:none !important; }
@media (max-width:1180px) {
  .native-api-page { --native-api-list-width:270px; --native-api-crm-width:300px; }
  .native-api-title { min-width:220px; }
  .native-api-title small, .native-api-status { display:none; }
  .native-api-toolbar { gap:8px; padding:0 10px; }
  .native-api-toolbar-actions button { padding:6px; font-size:9.5px; }
}
@media (max-width:920px) {
  .native-api-page { --native-api-list-width:230px; --native-api-crm-width:260px; }
  .native-api-health { display:none; }
  .native-api-message-bubble { max-width:86%; }
}


/* V1.27.97 — Native API unread + notification presentation ---------------- */
.global-app-rail-btn.native-api { position:relative; }
.native-api-rail-unread {
  position:absolute; top:2px; right:2px; min-width:17px; height:17px; padding:0 4px;
  border-radius:999px; display:grid; place-items:center; background:#ef4444; color:#fff;
  border:2px solid #fff; font-size:8px; font-weight:900; line-height:1; box-shadow:0 2px 7px rgba(188,34,34,.25);
}
.native-api-rail-unread.hidden { display:none !important; }
.native-api-customer-head-actions { display:flex; align-items:center; gap:5px; }
.native-api-customer.unread { border-color:#f4b7b7; background:#fffafa; }
.native-api-customer.unread:not(.active)::before {
  content:''; position:absolute; left:3px; top:50%; width:4px; height:28px; border-radius:999px;
  transform:translateY(-50%); background:#ef4444;
}
.native-api-customer-unread {
  min-width:18px; height:18px; padding:0 5px; border-radius:999px; display:grid; place-items:center;
  background:#ef4444; color:#fff; font-size:8px; font-weight:900; line-height:1;
}
#nativeApiNotificationBtn.active { background:#e9f9ef; color:#168b4b; border-color:#b6e5c8; font-weight:800; }
#nativeApiNotificationBtn.muted { background:#f4f5f6; color:#7d8a91; }


/* V1.27.98 — Official API customer right-click delete/hide. */
.native-api-customer-context-menu {
  position: fixed;
  z-index: 100000;
  width: 250px;
  max-height: 72vh;
  overflow-y: auto;
  padding: 6px;
  border: 1px solid #d8dfe3;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 12px 34px rgba(20, 32, 40, .18);
  user-select: none;
}
.native-api-customer-context-menu button {
  width: 100%;
  height: 34px;
  padding: 0 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  text-align: left;
  font-size: 12px;
  cursor: pointer;
}
.native-api-customer-context-menu button.danger { color:#c83f3f; font-weight:700; }
.native-api-customer-context-menu button.danger:hover { background:#fff0f0; }
.native-api-customer-context-hint { padding:5px 10px 3px; color:#8a969d; font-size:10.5px; line-height:1.45; }

/* V1.27.149 — ten independent daily flow editors */
#chatgptPersonaModal .gpt-reply-style-card { width:min(780px,96vw); }
.gpt-flow-day-editor { margin-top:10px; }
.gpt-flow-day-tabs { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:6px; margin:4px 0 10px; }
.gpt-flow-day-tabs button { min-height:32px; border:1px solid #d6e0e4; border-radius:8px; background:#fff; color:#52616b; cursor:pointer; font-weight:600; }
.gpt-flow-day-tabs button:hover { border-color:#9fb2bc; }
.gpt-flow-day-tabs button.active { border-color:#2d6a77; background:#edf7f8; color:#174c57; box-shadow:inset 0 0 0 1px rgba(45,106,119,.08); }
#chatgptFlowLibrary { min-height:280px; resize:vertical; }


/* V1.27.152 — visible cross-channel Day state for the selected customer */
.daily-flow-status{display:inline-flex;align-items:center;min-height:28px;padding:0 10px;border:1px solid var(--line,#d9dee7);border-radius:999px;font-size:12px;font-weight:700;white-space:nowrap;background:rgba(127,127,127,.08)}
.daily-flow-status.day-selectable{cursor:pointer;user-select:none;transition:box-shadow .15s ease,background .15s ease,transform .05s ease}
.daily-flow-status.day-selectable:hover{background:rgba(70,110,180,.10);box-shadow:0 0 0 2px rgba(70,110,180,.10)}
.daily-flow-status.day-selectable:active{transform:translateY(1px)}
.daily-flow-quick-picker{position:fixed;z-index:10080;width:290px;padding:12px;border:1px solid var(--line,#d9dee7);border-radius:12px;background:var(--panel,#fff);box-shadow:0 12px 36px rgba(0,0,0,.18);color:var(--text,#172033)}
.daily-flow-quick-picker.hidden{display:none!important}
.daily-flow-quick-picker-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;margin-bottom:10px}
.daily-flow-quick-picker-head strong{display:block;font-size:14px}
.daily-flow-quick-picker-head small{display:block;margin-top:3px;font-size:11px;line-height:1.4;color:var(--muted,#6f7785)}
.daily-flow-quick-picker-close{border:0;background:transparent;font-size:18px;line-height:1;cursor:pointer;color:inherit;padding:0 2px}
.daily-flow-quick-picker-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}
.daily-flow-quick-picker-grid button{min-height:34px;padding:0 6px;border:1px solid var(--line,#d9dee7);border-radius:8px;background:var(--panel,#fff);color:inherit;cursor:pointer;font-weight:700;font-size:12px}
.daily-flow-quick-picker-grid button:hover{background:rgba(70,110,180,.10)}
.daily-flow-quick-picker-grid button.current{border-color:#4b7bec;box-shadow:0 0 0 1px #4b7bec inset;background:rgba(75,123,236,.10)}
.daily-flow-quick-picker-grid button:disabled{opacity:.55;cursor:wait}
.daily-flow-quick-picker-status{min-height:18px;margin-top:9px;font-size:11px;line-height:1.45;color:var(--muted,#6f7785)}
.daily-flow-quick-picker-actions{display:flex;justify-content:flex-end;margin-top:8px}
.daily-flow-quick-picker-actions button{font-size:11px;padding:5px 8px;border-radius:7px;border:1px solid var(--line,#d9dee7);background:transparent;color:inherit;cursor:pointer}
.daily-flow-status.active{font-weight:800}
.daily-flow-status.waiting{opacity:.82}
.daily-flow-status.finished{opacity:.72}
.daily-flow-status.hidden{display:none!important}

/* V1.27.159 reception/deep chat per-customer mode switch */
.chat-mode-toggle {
  min-height: 30px;
  padding: 0 10px;
  border-radius: 9px;
  border: 1px solid rgba(148,163,184,.28);
  background: rgba(15,23,42,.74);
  color: #dbeafe;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  white-space: nowrap;
}
.chat-mode-toggle:hover { border-color: rgba(96,165,250,.62); }
.chat-mode-toggle.reception { background: rgba(120,53,15,.58); color: #fde68a; border-color: rgba(245,158,11,.44); }
.chat-mode-toggle.deep { background: rgba(6,78,59,.62); color: #a7f3d0; border-color: rgba(16,185,129,.44); }
.chat-mode-toggle.hidden { display:none !important; }
.daily-flow-status.paused { opacity:.72; border-style:dashed; }


/* V1.27.198 Official API customer bulk send */
.native-api-bulk-card{width:min(1120px,94vw);max-width:1120px;height:min(780px,90vh);display:flex;flex-direction:column;overflow:hidden}
.native-api-bulk-card .modal-head p{margin:5px 0 0;color:#7a8992;font-size:10.5px;line-height:1.5}
.native-api-bulk-layout{min-height:0;flex:1;display:grid;grid-template-columns:minmax(350px,.9fr) minmax(430px,1.1fr);gap:0;border-top:1px solid #e7ecef;border-bottom:1px solid #e7ecef}
.native-api-bulk-recipients,.native-api-bulk-editor{min-width:0;min-height:0;display:flex;flex-direction:column;padding:14px;background:#fff}
.native-api-bulk-recipients{border-right:1px solid #e3e9ec;background:#f8fafb}
.native-api-bulk-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}.native-api-bulk-section-head strong{display:block;font-size:13px;color:#22343f}.native-api-bulk-section-head small{display:block;margin-top:3px;font-size:9.5px;color:#86949d}.native-api-bulk-section-head button{padding:5px 8px;font-size:9.5px}
.native-api-bulk-filters{display:grid;grid-template-columns:130px minmax(0,1fr);gap:8px;margin-bottom:9px}.native-api-bulk-filters select,.native-api-bulk-filters input,.native-api-bulk-editor textarea,.native-api-bulk-delay-grid input{border:1px solid #d9e2e6;border-radius:8px;background:#fff;color:#263943;outline:none}.native-api-bulk-filters select,.native-api-bulk-filters input{padding:8px 9px;font-size:10px}.native-api-bulk-filters input:focus,.native-api-bulk-editor textarea:focus,.native-api-bulk-delay-grid input:focus{border-color:#62c68a;box-shadow:0 0 0 2px rgba(52,190,107,.08)}
.native-api-bulk-facebook-account{display:grid;grid-template-columns:130px minmax(0,1fr);align-items:center;gap:8px;margin:-2px 0 9px}.native-api-bulk-facebook-account.hidden{display:none!important}.native-api-bulk-facebook-account label{font-size:9.5px;color:#677780;font-weight:700}.native-api-bulk-facebook-account select{min-width:0;padding:8px 9px;border:1px solid #9bc8f7;border-radius:8px;background:#f5f9ff;color:#1f5688;font-size:10px;outline:none}.native-api-bulk-facebook-account select:focus{border-color:#589de4;box-shadow:0 0 0 2px rgba(24,119,242,.1)}
.native-api-bulk-front-filter{display:grid;grid-template-columns:130px minmax(0,1fr);align-items:center;gap:8px;margin:-2px 0 9px}.native-api-bulk-front-filter.hidden{display:none!important}.native-api-bulk-front-filter label{display:block;margin:0;color:#677780;font-size:9.5px;font-weight:700}.native-api-bulk-front-filter select{min-width:0;padding:8px 9px;border:1px solid #d9e2e6;border-radius:8px;background:#fff;color:#263943;font-size:10px;outline:none}.native-api-bulk-front-filter select:focus{border-color:#62c68a;box-shadow:0 0 0 2px rgba(52,190,107,.08)}
.native-api-bulk-stage-groups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;margin:0 0 9px}.native-api-bulk-stage-groups button{min-width:0;min-height:29px;padding:6px 6px;border:1px solid #dce4e8;border-radius:8px;background:#fff;color:#63737c;font-size:9.5px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:4px;white-space:nowrap}.native-api-bulk-stage-groups button span{min-width:16px;height:16px;padding:0 4px;border-radius:999px;display:inline-grid;place-items:center;background:#e9eef1;color:#738189;font-size:8px;line-height:1;font-variant-numeric:tabular-nums}.native-api-bulk-stage-groups button:hover{border-color:#c8d5db;background:#f5f8f9}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="new"],.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="active"]{border-color:#c5e8d4;background:#f1fbf5;color:#177a49}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="new"] span,.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="active"] span{background:#d9f3e4;color:#177a49}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="invited"],.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="added"]{border-color:#bfdfea;background:#f0f8fb;color:#20768f}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="invited"] span,.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="added"] span{background:#d9edf4;color:#20768f}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="paused"]{border-color:#d8dee2;background:#f5f7f8;color:#6d7980}.native-api-bulk-stage-groups button.active{box-shadow:inset 0 0 0 1px rgba(0,0,0,.04)}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="all"].active{border-color:#aab9c1;background:#edf2f4;color:#364b56}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="all"].active span{background:#6f818a;color:#fff}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="new"].active,.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="active"].active{border-color:#70c995;background:#dcf5e7;color:#116f42}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="new"].active span,.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="active"].active span{background:#1daf65;color:#fff}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="invited"].active,.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="added"].active{border-color:#78bfd3;background:#dff2f7;color:#156b80}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="invited"].active span,.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="added"].active span{background:#369db7;color:#fff}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="paused"].active{border-color:#bfc8cd;background:#eceff1;color:#606b72}.native-api-bulk-stage-groups button[data-native-api-bulk-stage-group="paused"].active span{background:#7b878e;color:#fff}.native-api-bulk-stage-groups button:disabled{opacity:.55;cursor:not-allowed}
.native-api-bulk-line-groups{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:0 0 9px}.native-api-bulk-line-groups.hidden{display:none!important}.native-api-bulk-line-groups button{min-width:0;min-height:29px;padding:6px 5px;border:1px solid #dce4e8;border-radius:8px;background:#f7f9fa;color:#63737c;font-size:9.5px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:4px;white-space:nowrap}.native-api-bulk-line-groups button span{min-width:16px;height:16px;padding:0 4px;border-radius:999px;display:inline-grid;place-items:center;background:#e9eef1;color:#738189;font-size:8px;line-height:1;font-variant-numeric:tabular-nums}.native-api-bulk-line-groups button:hover{border-color:#acd9bf;background:#f0f8f4}.native-api-bulk-line-groups button[data-native-api-bulk-line-group="new"]{border-color:#bfe6cf;background:#eefaf3;color:#147948}.native-api-bulk-line-groups button[data-native-api-bulk-line-group="new"] span{background:#d7f1e2;color:#147948}.native-api-bulk-line-groups button.active{border-color:#6bc993;background:#def5e8;color:#116f42;box-shadow:inset 0 0 0 1px rgba(31,180,106,.05)}.native-api-bulk-line-groups button.active span{background:#1eaf64;color:#fff}.native-api-bulk-line-groups button[data-native-api-bulk-line-group="all"].active{border-color:#aab9c1;background:#edf2f4;color:#364b56}.native-api-bulk-line-groups button[data-native-api-bulk-line-group="all"].active span{background:#6f818a;color:#fff}.native-api-bulk-line-groups button:disabled{opacity:.55;cursor:not-allowed}
.native-api-bulk-customer-list{min-height:0;flex:1;overflow:auto;border:1px solid #e1e7ea;border-radius:10px;background:#fff;padding:5px}.native-api-bulk-customer{display:grid;grid-template-columns:26px 38px minmax(0,1fr) auto;align-items:center;gap:8px;width:100%;padding:7px 8px;border-radius:8px;border:0;background:transparent;text-align:left}.native-api-bulk-customer:hover{background:#f0f8f3}.native-api-bulk-customer.selected{background:#eaf8f0}.native-api-bulk-checkbox{width:16px;height:16px;accent-color:#19a75a}.native-api-bulk-customer .native-api-avatar{width:34px;height:34px}.native-api-bulk-customer-copy{min-width:0}.native-api-bulk-customer-copy strong{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:10.5px;color:#263843}.native-api-bulk-customer-copy small{display:block;margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:8.5px;color:#8a979f}.native-api-bulk-platform{font-size:8px;font-weight:800;padding:2px 5px;border-radius:999px}.native-api-bulk-platform.facebook{color:#1877f2;background:#eaf2ff}.native-api-bulk-platform.line{color:#079b42;background:#e8faef}
.native-api-bulk-card .native-api-bulk-customer{display:grid;grid-template-columns:minmax(0,1fr) 22px;gap:8px;align-items:center;min-height:40px;margin:0;padding:5px 8px}.native-api-bulk-card .native-api-bulk-customer-copy{grid-column:1;min-width:0}.native-api-bulk-card .native-api-bulk-checkbox{grid-column:2;grid-row:1;justify-self:end;margin:0}
.native-api-bulk-selected-count{padding:4px 8px;border-radius:999px;background:#eaf8f0;color:#16864b;font-size:9px;font-weight:800}.native-api-bulk-editor textarea{width:100%;resize:vertical;min-height:150px;padding:10px 11px;font-size:11.5px;line-height:1.6}.native-api-bulk-delay-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:11px}.native-api-bulk-delay-grid label{font-size:9.5px;color:#677780}.native-api-bulk-delay-grid input{display:block;width:100%;margin-top:4px;padding:8px 9px;font-size:10.5px}.native-api-bulk-note{margin-top:9px;padding:8px 10px;border-radius:8px;background:#f5f7f8;color:#718089;font-size:9px;line-height:1.55}
.native-api-bulk-progress{margin-top:12px;padding:10px;border:1px solid #e0e7ea;border-radius:10px;background:#fbfcfd}.native-api-bulk-progress-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.native-api-bulk-progress-head strong{font-size:10.5px;color:#2d414b}.native-api-bulk-progress-head span{font-size:10px;color:#16864b;font-variant-numeric:tabular-nums}.native-api-bulk-progress-bar{height:7px;margin:8px 0 7px;background:#edf1f3;border-radius:999px;overflow:hidden}.native-api-bulk-progress-bar span{display:block;height:100%;width:0;background:#25b766;transition:width .2s ease}.native-api-bulk-progress small{font-size:9px;color:#7b8991}
.native-api-bulk-result-list{min-height:90px;max-height:190px;overflow:auto;margin-top:9px;border:1px solid #e2e8eb;border-radius:9px;background:#fff}.native-api-bulk-result-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;padding:7px 9px;border-bottom:1px solid #eef2f4}.native-api-bulk-result-row:last-child{border-bottom:0}.native-api-bulk-result-row strong{display:block;font-size:9.5px;color:#33464f}.native-api-bulk-result-row small{display:block;margin-top:2px;font-size:8px;color:#8a969e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.native-api-bulk-result-state{font-size:8.5px;font-weight:800}.native-api-bulk-result-state.sent{color:#13844a}.native-api-bulk-result-state.failed{color:#c24646}.native-api-bulk-result-state.sending{color:#9b6812}.native-api-bulk-result-state.cancelled{color:#7d878d}
.native-api-bulk-actions{display:flex;align-items:center;justify-content:flex-end;gap:7px;padding:11px 14px;background:#fff}.native-api-bulk-actions span{margin-right:auto;font-size:9px;color:#7d8991}.native-api-bulk-actions button{padding:7px 10px;font-size:10px}
@media(max-width:880px){.native-api-bulk-layout{grid-template-columns:1fr}.native-api-bulk-recipients{border-right:0;border-bottom:1px solid #e3e9ec;max-height:42vh}.native-api-bulk-card{height:92vh}}

/* V1.27.199 multi-channel + scheduled bulk send */
.native-api-bulk-mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:11px}.native-api-bulk-mode-grid label{font-size:9.5px;color:#677780}.native-api-bulk-mode-grid select,.native-api-bulk-mode-grid input{display:block;width:100%;margin-top:4px;padding:8px 9px;border:1px solid #d9e2e6;border-radius:8px;background:#fff;color:#263943;font-size:10.5px;outline:none}.native-api-bulk-mode-grid select:focus,.native-api-bulk-mode-grid input:focus{border-color:#62c68a;box-shadow:0 0 0 2px rgba(52,190,107,.08)}.native-api-bulk-mode-grid .hidden{display:none}.native-api-bulk-platform.telegram{color:#2d7db5;background:#eaf5fb}.native-api-bulk-platform.whatsapp{color:#178b50;background:#e9f8ef}.native-api-bulk-platform.facebook{color:#1877f2;background:#eaf2ff}.native-api-bulk-platform.line{color:#079b42;background:#e8faef}


/* V1.27.208 Chat Script AI integration */
.chatscript-integration-status{display:flex;align-items:center;gap:10px;padding:10px 12px;margin:8px 0 12px;border:1px solid rgba(91,141,239,.35);border-radius:10px;background:rgba(91,141,239,.08)}
.chatscript-integration-status span{opacity:.82;font-size:12px}.ai-reply-actions{gap:8px;flex-wrap:wrap}

/* V1.27.209 — Chat Script AI directly inside Official API Inbox */
.native-api-toolbar-actions .native-api-chatscript-btn {
  border:1px solid #7b6ef6;
  background:#6f63e9;
  color:#fff;
  font-weight:700;
}
.native-api-toolbar-actions .native-api-chatscript-btn:hover { background:#5f53db; border-color:#5f53db; }
.native-api-toolbar-actions .native-api-chatscript-btn:disabled { opacity:.62; cursor:wait; }
.native-api-chatscript-draft {
  margin:0 0 8px;
  padding:10px;
  border:1px solid rgba(111,99,233,.35);
  border-radius:10px;
  background:linear-gradient(180deg,rgba(111,99,233,.07),rgba(111,99,233,.025));
}
.native-api-chatscript-draft.hidden { display:none; }
.native-api-chatscript-draft-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:8px; }
.native-api-chatscript-draft-head > div { min-width:0; display:flex; align-items:baseline; gap:10px; }
.native-api-chatscript-draft-head strong { font-size:12px; color:#3f398e; white-space:nowrap; }
.native-api-chatscript-draft-head span { font-size:10px; color:#73808a; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.native-api-chatscript-draft-head > button { width:28px; min-width:28px; height:26px; padding:0; font-size:17px; line-height:1; }
.native-api-chatscript-draft-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.native-api-chatscript-draft-grid label { display:flex; flex-direction:column; gap:4px; min-width:0; }
.native-api-chatscript-draft-grid label > span { font-size:10px; color:#66747d; font-weight:600; }
.native-api-chatscript-draft-grid textarea { min-height:74px; max-height:140px; resize:vertical; background:#fff; font-size:12px; line-height:1.55; }
.native-api-chatscript-draft-actions { display:flex; align-items:center; gap:7px; flex-wrap:wrap; margin-top:8px; }
.native-api-chatscript-draft-actions button { padding:6px 10px; font-size:10.5px; }
@media (max-width:1180px) {
  .native-api-chatscript-draft-grid { grid-template-columns:1fr; }
}
/* V1.27.220 multi Facebook Page API pool */
.native-api-page-filter-row{display:flex;align-items:center;gap:6px;padding:2px 8px 7px;border-bottom:1px solid #edf1f3;background:#fff}
.native-api-page-filter-row span{font-size:9px;color:#7c8991;white-space:nowrap}.native-api-page-filter-row select{min-width:0;width:100%;height:28px;border:1px solid #d8e1e5;border-radius:7px;background:#f8fafb;color:#31434f;font-size:10px;padding:0 7px}
.native-api-fb-pages-modal{width:min(760px,92vw);max-height:86vh;overflow:auto}.native-api-fb-pages-list{display:flex;flex-direction:column;gap:7px;max-height:300px;overflow:auto;padding:2px 0 10px}.native-api-fb-page-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:center;border:1px solid #dfe7ea;border-radius:10px;padding:10px;background:#fafcfd}.native-api-fb-page-row.disabled{opacity:.62}.native-api-fb-page-copy strong{display:block;font-size:12px;color:#243743}.native-api-fb-page-copy small{display:block;margin-top:3px;color:#7e8d96;font-size:9.5px;word-break:break-all}.native-api-fb-page-actions{display:flex;gap:5px}.native-api-fb-page-actions button{padding:5px 8px;font-size:9.5px}.native-api-fb-page-actions .danger{color:#bd4545;border-color:#efcaca;background:#fff6f6}.native-api-fb-page-editor{display:grid;grid-template-columns:1fr 1fr;gap:9px;border-top:1px solid #e8edef;padding-top:12px}.native-api-fb-page-editor label{display:flex;flex-direction:column;gap:5px;font-size:10px;color:#66757e}.native-api-fb-page-editor input[type=text],.native-api-fb-page-editor input[type=password],.native-api-fb-page-editor input:not([type]){height:34px;border:1px solid #d5dfe4;border-radius:8px;padding:0 9px;background:#fff}.native-api-fb-page-enabled{grid-column:1/-1!important;display:flex!important;flex-direction:row!important;align-items:center!important}.native-api-fb-page-editor-actions{grid-column:1/-1;display:flex;justify-content:flex-end;gap:7px}.native-api-fb-pages-status{margin-top:9px;font-size:9.5px;color:#74828a;line-height:1.55}.native-api-platform-badge.facebook-page{max-width:90px;overflow:hidden;text-overflow:ellipsis}

/* V1.27.253 — bounded DOM virtualization for the Official API inbox only. */
.native-api-virtual-spacer,
.native-api-message-virtual-spacer { width:100%; min-height:0; pointer-events:none; visibility:hidden; }
/* V1.27.274: Native API customer Day 1-10 filter. Pure inbox grouping; does not reactivate retired Day chat automation. */
.native-api-day-filter-row{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:5px 7px;padding:6px 8px;border-bottom:1px solid #edf1f3;background:#fff}
.native-api-day-filter-row>span{font-size:9px;color:#6f7d85;white-space:nowrap}
.native-api-day-filter-row select{min-width:0;width:100%;height:29px;border:1px solid #d8e1e5;border-radius:7px;background:#f8fafb;color:#31434f;font-size:10px;padding:0 7px;outline:none}
.native-api-day-filter-row select:focus{border-color:#6ac98f;box-shadow:0 0 0 2px rgba(47,198,109,.08)}
.native-api-day-filter-row small{grid-column:1/-1;font-size:8.5px;color:#89959c;line-height:1.35;white-space:normal}
.native-api-day-filter-row.resolving small{color:#9a7b2f}



/* V1.27.275 — header day badge + robust scroll ownership. */
.native-api-customer-head,.native-api-filters,.native-api-page-filter-row,.native-api-stage-groups,.native-api-day-filter-row,.native-api-search{flex-shrink:0}
.native-api-chat-name-row{display:flex;align-items:center;gap:8px;min-width:0}
.native-api-chat-name-row>strong{min-width:0}
.native-api-customer-day-badge{display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;min-width:58px;height:24px;padding:0 22px 0 9px;border-radius:999px;font-size:9px;font-weight:900;line-height:1;white-space:nowrap;border:1px solid #cfe3d7;background:#edf9f2;color:#167d49;cursor:pointer;outline:none}
.native-api-customer-day-badge.hidden{display:none}
.native-api-customer-day-badge.early{border-color:#bfe7cf;background:#ecfaf2;color:#137b4a}
.native-api-customer-day-badge.mid{border-color:#f1d79e;background:#fff8e8;color:#996514}
.native-api-customer-day-badge.late,.native-api-customer-day-badge.plus{border-color:#efc2b8;background:#fff1ed;color:#b84f38}
.native-api-customer-day-badge.pending{border-color:#d8dee2;background:#f4f6f7;color:#78858d}
#chatgptPersonaModal .gpt-reply-style-card{scrollbar-gutter:stable;overscroll-behavior:contain}
/* V1.27.283 · restrained multi-inbox controls */
.native-api-inbox-create{display:flex;gap:10px;margin:14px 0}
.native-api-inbox-create input{flex:1;min-width:0;border:1px solid #d5dfe7;border-radius:8px;padding:10px}
.native-api-inbox-create button,.native-api-inbox-manager-item button{border:1px solid #d6e0e8;border-radius:8px;background:#fff;padding:8px 12px;cursor:pointer}
.native-api-inbox-manager-item{padding:12px 4px;border-bottom:1px solid #edf0f3}
.native-api-inbox-manager-item small{margin-left:10px;color:#768390}
.native-api-inbox-manager-item button{float:right}
.native-api-inbox-manager-item>div{clear:both;padding-top:8px;font-size:12px;color:#657481}
.native-api-inbox-assign-list{max-height:270px;overflow-y:auto;margin-top:15px}
.native-api-inbox-assign-list label{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:8px 2px}
.native-api-inbox-assign-list select{max-width:50%;min-width:160px;border:1px solid #d5dfe7;border-radius:8px;padding:8px}

/* V1.27.287: keep inbox management clickable on narrow sidebar widths. */
.native-api-page-filter-row #nativeApiInboxSelector{flex:1 1 auto;width:auto;min-width:0}
.native-api-page-filter-row #nativeApiInboxManageBtn{flex:0 0 auto;min-width:48px;width:auto;white-space:nowrap;writing-mode:horizontal-tb;word-break:keep-all;display:inline-flex;align-items:center;justify-content:center;padding:5px 9px;cursor:pointer}
.native-api-page-filter-row #nativeApiInboxScopeCount{flex:0 0 auto;white-space:nowrap;font-size:10px}
.native-api-inbox-manager-item [data-inbox-rename]{float:none;margin-left:10px}

/* V1.27.289 — compact, usable WS sidebar editors and proxy form. */
.external-account-remark { cursor:text; border-radius:6px; padding:3px 4px; }
.external-account-remark:hover { background:#ebf5f0; color:#176b4a; }
.external-account-remark-input { display:block; box-sizing:border-box; width:100%; min-width:0; border:1px solid #4caa80; border-radius:7px; background:#fff; padding:6px 8px; color:#203b31; font-size:12px; outline-offset:2px; }
#appProxyModal .modal-card { width:min(560px,94vw); }
#appProxyModal input:focus, #appProxyModal select:focus,
.external-account-remark-input:focus, .external-crm-panel textarea:focus { outline:2px solid #55b68a; outline-offset:1px; }

/* R56 account manager interaction fixes */
.app-account-row.dragging { opacity:.55; border-color:#42a873; }
.app-account-drag-handle { display:grid; place-items:center; width:22px; height:34px; color:#788994; font-size:22px; cursor:grab; user-select:none; touch-action:none; }
.app-account-drag-handle:active { cursor:grabbing; }
.app-account-rename-input { box-sizing:border-box; width:100%; min-width:0; height:32px; padding:5px 8px; border:1px solid #70bd91; border-radius:7px; outline:2px solid #e0f4e8; }
.app-account-rename-actions { display:flex; gap:6px; margin-top:5px; }
.app-account-rename-actions button { padding:4px 10px; border:1px solid #d8e1dd; border-radius:6px; background:#fff; cursor:pointer; }
.app-account-rename-actions button:first-child { border-color:#51b979; color:#157640; }
.external-account-remark-editor { display:flex; align-items:center; gap:4px; min-width:0; }
.external-account-remark-editor .external-account-remark-input { min-width:0; flex:1; }
.external-account-remark-save { flex:0 0 auto; height:24px; padding:0 6px; border:1px solid #b7ddc5; border-radius:5px; background:#eff9f2; color:#168347; font-size:10px; cursor:pointer; }
.external-account-item { grid-template-columns:20px 40px minmax(0,1fr) 34px !important; }
.external-account-drag-handle { display:grid; place-items:center; width:18px; min-height:38px; color:#7a8982; font-size:19px; cursor:grab; user-select:none; touch-action:none; }
.external-account-drag-handle:active { cursor:grabbing; }
.external-account-item { cursor:grab !important; }
.external-account-item:active { cursor:grabbing !important; }
.external-account-item button, .external-account-item input { cursor:pointer; }
.external-account-item input { cursor:text; }
.external-account-item.dragging { opacity:.5; border-color:#22b967 !important; }
.app-account-row { cursor:grab; }
.app-account-row:active { cursor:grabbing; }
.app-account-row button, .app-account-row input { cursor:pointer; }
.app-account-row input { cursor:text; }
.external-account-phone { color:#26343d !important; cursor:text; }
.external-account-phone:hover { color:#159653 !important; }
.external-account-phone-editor { display:flex; align-items:center; gap:4px; min-width:0; }
.external-account-phone-input { box-sizing:border-box; flex:1; min-width:0; width:100%; height:24px; padding:3px 6px; border:1px solid #5ac985; border-radius:6px; font-size:10px; outline:none; background:#fff; }
.external-account-phone-save { flex:0 0 auto; height:24px; padding:0 6px; border:1px solid #b7ddc5; border-radius:5px; background:#eff9f2; color:#168347; font-size:10px; cursor:pointer; }

/* R60: pointer-based account sorting (works consistently in the embedded Electron view). */
.account-pointer-dragging { user-select:none !important; }
.account-pointer-dragging, .account-pointer-dragging * { cursor:grabbing !important; }
.external-account-item.dragging, .app-account-row.dragging { opacity:.62; outline:2px solid #22b967; outline-offset:1px; z-index:2; }
.external-account-item, .app-account-row { user-select:none; }
.external-account-item button, .external-account-item input, .app-account-row button, .app-account-row input { user-select:auto; }

/* R61: durable customer phone ledger on the Home dashboard. */
.customer-number-vault-panel { margin:18px 0; }
.customer-number-vault-title { align-items:flex-start; gap:16px; }
.customer-number-vault-title p { max-width:760px; }
.customer-number-vault-actions { display:flex; gap:7px; flex-wrap:wrap; justify-content:flex-end; }
.customer-number-vault-actions button { white-space:nowrap; }
.customer-number-vault-kpis { display:flex; gap:10px; flex-wrap:wrap; margin:12px 0; }
.customer-number-vault-kpis span { padding:8px 12px; border:1px solid #dbe9df; border-radius:9px; background:#f8fcf9; color:#4a6255; font-size:12px; }
.customer-number-vault-kpis strong { margin-left:5px; color:#157640; font-size:16px; }
.customer-number-vault-form { display:grid; grid-template-columns:minmax(180px,1.3fr) 130px minmax(150px,1fr) minmax(150px,1fr) auto; gap:8px; align-items:center; margin:10px 0; }
.customer-number-vault-form input, .customer-number-vault-form select { min-width:0; height:34px; box-sizing:border-box; border:1px solid #d5e4da; border-radius:7px; padding:6px 9px; background:#fff; }
.customer-number-vault-status { min-height:20px; color:#4b6657; font-size:12px; }
.customer-number-vault-table { overflow:auto; border:1px solid #e0ebe4; border-radius:9px; background:#fff; }
.customer-number-vault-table-head, .customer-number-vault-row { display:grid; grid-template-columns:1.3fr .75fr 1.5fr 1fr; gap:10px; align-items:center; min-width:680px; padding:9px 12px; border-bottom:1px solid #eef4ef; font-size:12px; }
.customer-number-vault-table-head { background:#f5faf6; color:#607568; font-weight:600; }
.customer-number-vault-row:last-child { border-bottom:0; }
.customer-number-vault-row strong { color:#153c28; font-variant-numeric:tabular-nums; }
.customer-number-vault-row small { color:#809288; }
@media (max-width:900px) { .customer-number-vault-form { grid-template-columns:1fr 1fr; } .customer-number-vault-form input:first-child { grid-column:1 / -1; } .customer-number-vault-form button { grid-column:1 / -1; } }
