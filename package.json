  "build": {
    "appId": "com.yoko.scrm",
    "productName": "Yoko SCRM",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YokoSCRM-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yoko SCRM",
      "uninstallDisplayName": "Yoko SCRM",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "extraResources": [
      {
        "from": "vendor/line-extension",
        "to": "line-extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "longdada3494-lang",
        "repo": "yoko-scrm-updates",
        "releaseType": "draft",
        "publishAutoUpdate": true
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "socks": "^2.8.7"
  }
